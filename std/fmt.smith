use std.bits (bit_and, shift_right, u64)
use std.int (wrapping_add, wrapping_narrow)
use std.list (freeze, push)
use std.utf8 (utf8)

fn text(bytes: take List[Byte]) -> str {
  match utf8(freeze(take bytes)) {
    .ok(t) { t }
    .err(e) { "" }
  }
}

fn hex_digit(d: u64, upper: bool) -> Byte {
  if d < 10 {
    wrapping_narrow(wrapping_add(48, d))
  } else if upper {
    wrapping_narrow(wrapping_add(55, d))
  } else {
    wrapping_narrow(wrapping_add(87, d))
  }
}

pub fn hex(n: u64; width: Byte = 0, upper: bool = true) -> str <alloc> {
  mut digits: List[Byte] = []
  if 16 <= width {
    loop i in 16..width { digits = push(take digits, '0') }
  }
  mut started: bool = false
  loop j in 0..16 {
    pos = 15 - j
    d = bit_and(shift_right(n, pos * 4), 15)
    if d > 0 { started = true }
    if started or pos < width or pos == 0 { digits = push(take digits, hex_digit(d, upper)) }
  }
  text(take digits)
}

pub fn binary(n: u64; width: Byte = 0) -> str <alloc> {
  mut digits: List[Byte] = []
  if 64 <= width {
    loop i in 64..width { digits = push(take digits, '0') }
  }
  mut started: bool = false
  loop j in 0..64 {
    pos = 63 - j
    d = bit_and(shift_right(n, pos), 1)
    if d > 0 { started = true }
    if started or pos < width or pos == 0 { digits = push(take digits, hex_digit(d, true)) }
  }
  text(take digits)
}

use std.bits (bit_and, bit_or, i64, shift_left, shift_right, u64)
use std.int (checked_add, narrow, wrapping_narrow)
use std.list (append, copy, push)
use std.task (Handle, task)

pub struct File {
  handle: i64
  opened: bool
  pub path: str
}

without Copy for File
without Discard for File

pub enum FsError {
  missing: str
  denied: str
  failed: (str, str)
}

// What a person reads: the path, and then what went wrong.
impl Fmt[FsError] {
  fn fmt(value: FsError) -> str <alloc> {
    match value {
      .missing(path) { "{path}: no such file" }
      .denied(path) { "{path}: permission denied" }
      .failed((path, said)) { "{path}: {said}" }
    }
  }
}

pub effect fs {
  pub fn open_file(path: str) -> Result[File, FsError]
  pub fn create_file(path: str; executable: bool = false) -> Result[File, FsError]
  pub fn close_file(f: take File)
  pub fn size(f: File) -> Result[Nat, FsError]
  pub fn read(f: File, range: Range) -> Result[List[Byte], FsError] <alloc>
  pub fn write(f: File, at: Nat, bytes: List[Byte]) -> Result[(), FsError]
}

pub fn open[T](path: str, body: fn(File) -> Result[T, FsError]) -> Result[T, FsError] <fs> {
  f = try open_file(path)
  result = body(f)
  close_file(f)
  result
}

pub fn create[T](path: str, body: fn(File) -> Result[T, FsError]; executable: bool = false) -> Result[T, FsError] <fs> {
  f = try create_file(path, executable: executable)
  result = body(f)
  close_file(f)
  result
}

pub fn read_all(path: str) -> Result[List[Byte], FsError] <fs, alloc> {
  with f = open(path)
  n = try size(f)
  read(f, 0..n)
}

pub fn write_all(path: str, bytes: List[Byte]; executable: bool = false) -> Result[(), FsError] <fs> {
  with f = create(path, executable: executable)
  write(f, 0, bytes)
}

// A handler that a test writes makes a `File` from a number it chooses, and reads
// the number back with `handle`. A file made so is not one the system opened, and
// the system's handler refuses it.
pub fn file(handle: Nat) -> File {
  named(handle, "")
}

// A file that no system opened, with the path its errors name.
fn named(handle: Nat, path: str) -> File {
  File(handle: wrapping_narrow(handle), opened: false, path: path)
}

pub trait Held[T] {
  fn handle(x: T) -> Nat
}

impl Held[File] {
  fn handle(x: File) -> Nat {
    count(x.handle)
  }
}

// Ends a file without a system call and gives the handle it held, so a handler
// that a test writes knows which one it was given. What the system opened is not
// closed.
pub trait Release[T] {
  fn release(x: take T) -> Nat
}

impl Release[File] {
  fn release(x: take File) -> Nat {
    h = x.handle
    __consume(x)
    count(h)
  }
}

// The numbers of the kernel's calls, in the order the compiler gives them to
// `__system`: the first twenty-three are those of `std.net`, of which 9 closes a
// descriptor and 19 opens a file, and then pread, pwrite, write, lseek, and
// fchmod, and 28, which closes a file, as `CloseHandle` does on Windows.

// The number 12 is not a call: it is 1 when the kernel is macOS's, 2 when it is
// Windows's, and 0 when it is Linux's, whose flags of a file and whose number for
// a call that would wait differ.
fn on_macos() -> bool {
  __system(12) == 1
}

fn on_windows() -> bool {
  __system(12) == 2
}

// A number of bytes the kernel gave, which is not negative.
fn count(given: i64) -> Nat {
  maybe: Option[Nat] = narrow(given)
  match maybe {
    .some(n) { n }
    .none { 0 }
  }
}

// What the kernel gave, when it refused: minus its error number. A file that is
// not there is a name or a directory of the path that does not exist, and one the
// program may not read is a permission it lacks.
fn failure(path: str, call: str, given: i64) -> FsError <alloc> {
  code = 0 - given
  // Windows says a file or a folder of the path is not there with 2 and 3, and
  // that the program may not use it with 5.
  if on_windows() {
    if code == 2 or code == 3 { return .missing(path) }
    if code == 5 { return .denied(path) }
    return .failed((path, "{call}: error {code}"))
  }
  if code == 2 or code == 20 {
    .missing(path)
  } else if code == 13 or code == 1 {
    .denied(path)
  } else {
    .failed((path, "{call}: error {code}"))
  }
}

fn not_opened(f: File, call: str) -> FsError <alloc> {
  .failed((f.path, "{call}: handle {f.handle} is not one the system opened"))
}

// The path as the kernel reads it, ended by a zero byte, when no byte of it is
// zero.
fn name(path: str) -> Result[List[Byte], FsError] <alloc> {
  var made: List[Byte] = []
  loop i in 0..path.size {
    if path[i] == 0 { return .err(.failed((path, "a path holds a zero byte"))) }
    made = push(made, path[i])
  }
  .ok(push(made, 0))
}

// A unit of UTF-16, the low byte first.
fn put16(made: take List[Byte], unit: 0..65536) -> List[Byte] <alloc> {
  push(push(made, bit_and(unit, 255)), shift_right(unit, 8))
}

// What a code point is in UTF-16: one unit, or two where it is above 65535.
fn put_point(made: take List[Byte], point: 0..2097152) -> List[Byte] <alloc> {
  if point < 65536 {
    put16(made, point)
  } else {
    // The units of a surrogate pair: 55296 and the ten high bits of the point
    // less 65536, which is 55232 and the bits of the point above the tenth, and
    // 56320 and the ten low bits.
    put16(put16(made, 55232 + shift_right(point, 10)), 56320 + bit_and(point, 1023))
  }
}

// The path as Windows reads it: UTF-16, the low byte of a unit first, and ended
// by a unit of zero, when no unit of it is zero.
fn wide_name(path: str) -> Result[List[Byte], FsError] <alloc> {
  var made: List[Byte] = []
  var need: 0..4 = 0
  var point: 0..2097152 = 0
  loop i in 0..path.size {
    b = path[i]
    if b == 0 { return .err(.failed((path, "a path holds a zero byte"))) }
    if need > 0 {
      point = bit_and(bit_or(shift_left(point, 6), bit_and(b, 63)), 2097151)
      need = need - 1
      if need == 0 { made = put_point(made, point) }
    } else if b < 128 {
      made = put_point(made, b)
    } else if b < 224 {
      point = bit_and(b, 31)
      need = 1
    } else if b < 240 {
      point = bit_and(b, 15)
      need = 2
    } else {
      point = bit_and(b, 7)
      need = 3
    }
  }
  .ok(push(push(made, 0), 0))
}

// The path as the system reads it.
fn system_name(path: str) -> Result[List[Byte], FsError] <alloc> {
  if on_windows() { wide_name(path) } else { name(path) }
}

fn wait_to_read(fd: i64) <task> {
  number: u64 = wrapping_narrow(fd)
  __wait(.read(Handle(number: number)))
}

fn wait_to_write(fd: i64) <task> {
  number: u64 = wrapping_narrow(fd)
  __wait(.write(Handle(number: number)))
}

// The flags of the kernel: read only, write only, create, empty a file that
// exists, do not wait, and close at an exec, as Linux writes them or macOS does.
// A task that a scheduler runs opens a file as one that does not wait, so that a
// read that has to wait gives the task back to the scheduler.
// What Windows opens: the path, the access (read, or write), and the disposition
// (an existing file, or a new one that empties one that exists), and whether the
// handle came.
fn opened_on_windows(path: str, call: str, where: List[Byte], access: i64, how: i64) -> Result[File, FsError] <alloc> {
  fd = __system(19, 0, where, access, how, 0, 0)
  if fd < 0 { return .err(failure(path, call, fd)) }
  .ok(File(handle: fd, opened: true, path: path))
}

fn system_open_file(path: str) -> Result[File, FsError] <alloc, task> {
  where = try system_name(path)
  if on_windows() { return opened_on_windows(path, "open", where, 2147483648, 3) }
  var flags: i64 = 524288
  if on_macos() { flags = 16777216 }
  if __scheduled() { flags = if on_macos() { 16777220 } else { 526336 } }
  fd = __system(19, -100, where, flags, 0, 0, 0)
  if fd < 0 { return .err(failure(path, "open", fd)) }
  .ok(File(handle: fd, opened: true, path: path))
}

fn system_create_file(path: str, executable: bool) -> Result[File, FsError] <alloc, task> {
  where = try system_name(path)
  if on_windows() { return opened_on_windows(path, "create", where, 1073741824, 2) }
  var flags: i64 = 524865
  if on_macos() { flags = 16778753 }
  if __scheduled() { flags = if on_macos() { 16778757 } else { 526913 } }
  fd = __system(19, -100, where, flags, 438, 0, 0)
  if fd < 0 { return .err(failure(path, "create", fd)) }
  if executable {
    made = __system(27, fd, 493, 0, 0, 0, 0)
    if made < 0 {
      _ = __system(28, fd, 0, 0, 0, 0, 0)
      return .err(failure(path, "create", made))
    }
  }
  .ok(File(handle: fd, opened: true, path: path))
}

fn system_close_file(f: take File) {
  h = f.handle
  opened = f.opened
  __consume(f)
  if opened { _ = __system(28, h, 0, 0, 0, 0, 0) }
}

// Where the file ends, which is its size. Windows says a file that has no places
// cannot be asked, and a directory is told by what a read of it says, with 1.
fn end_of(fd: i64) -> i64 {
  end = __system(26, fd, 0, 2, 0, 0, 0)
  if on_windows() and end < 0 { return 0 - 29 }
  end
}

// What the kernel says of reading no byte at the start: a directory refuses with
// 21, and a file that has no places with 29.
fn probe(fd: i64) -> i64 <alloc> {
  if on_windows() {
    one: List[Byte] = __reserve(1)
    asked = __system(23, fd, one, 1, 0, 0, 0)
    return if asked == 0 - 1 { 0 - 21 } else { asked }
  }
  if on_macos() {
    // A read of no bytes of a directory gives nothing on macOS, so a byte is
    // asked for, and what is read is not kept.
    one: List[Byte] = __reserve(1)
    return __system(23, fd, one, 1, 0, 0, 0)
  }
  nothing: List[Byte] = []
  __system(23, fd, nothing, 0, 0, 0, 0)
}

fn system_size(f: File) -> Result[Nat, FsError] <alloc> {
  if not f.opened { return .err(not_opened(f, "size")) }
  asked = probe(f.handle)
  if asked == 0 - 21 { return .err(failure(f.path, "size", asked)) }
  end = end_of(f.handle)
  if end < 0 { return .err(failure(f.path, "size", end)) }
  .ok(count(end))
}

// `read` and `write` of a file that has no places, as a pipe has none, are asked
// with no place: the kernel says so by refusing a place with 29.
fn no_places() -> i64 {
  0 - 29
}

fn would_block() -> i64 {
  if on_macos() { 0 - 35 } else { 0 - 11 }
}

fn system_read(f: File, range: Range) -> Result[List[Byte], FsError] <alloc, task> {
  if not f.opened { return .err(not_opened(f, "read")) }
  var last: Nat = range.end
  asked = probe(f.handle)
  if asked == 0 - 21 { return .err(failure(f.path, "read", asked)) }
  end = end_of(f.handle)
  var stream = false
  if end >= 0 {
    if last > count(end) { last = count(end) }
  } else if end == no_places() {
    stream = true
  } else {
    return .err(failure(f.path, "read", end))
  }
  first = range.start
  if first >= last { return .ok([]) }
  wanted = last - first
  var made: List[Byte] = []
  var have: Nat = 0
  loop attempt in 0..1000000 {
    if have >= wanted { break }
    left = wanted - have
    chunk: List[Byte] = __reserve(left)
    var got: i64 = 0
    if stream {
      got = __system(20, f.handle, chunk, left, 0, 0, 0)
    } else {
      match checked_add(first, have) {
        .some(at) { got = __system(23, f.handle, chunk, left, at, 0, 0) }
        .none { return .err(.failed((f.path, "read: too far into the file"))) }
      }
    }
    if got == would_block() {
      if __scheduled() { wait_to_read(f.handle) }
    } else if got == -4 {
    } else if got < 0 {
      return .err(failure(f.path, "read", got))
    } else if got == 0 {
      break
    } else {
      piece = __sized(chunk, count(got))
      if have == 0 { made = piece } else { made = append(made, piece) }
      match checked_add(have, count(got)) {
        .some(n) { have = n }
        .none { return .err(.failed((f.path, "read: too many bytes"))) }
      }
      if stream { break }
    }
  }
  .ok(made)
}

// The bytes of the list from the place `from`.
fn tail(xs: List[Byte], from: Nat) -> List[Byte] <alloc> {
  var made: List[Byte] = []
  if from <= xs.size {
    loop i in from..xs.size { made = push(made, xs[i]) }
  }
  made
}

fn system_write(f: File, at: Nat, bytes: List[Byte]) -> Result[(), FsError] <alloc, task> {
  if not f.opened { return .err(not_opened(f, "write")) }
  var done: Nat = 0
  var stream = false
  // What is left to send once a write has sent only a part: the bytes are sent
  // from the list itself until then, with nothing copied.
  var rest: List[Byte] = []
  var whole = true
  loop attempt in 0..1000000 {
    if done >= bytes.size { break }
    handed = if whole { bytes.size } else { rest.size }
    var given: i64 = 0
    match checked_add(at, done) {
      .some(place) {
        if stream {
          given = if whole { __system(25, f.handle, bytes, handed, 0, 0, 0) } else { __system(25, f.handle, rest, handed, 0, 0, 0) }
        } else {
          given = if whole { __system(24, f.handle, bytes, handed, place, 0, 0) } else { __system(24, f.handle, rest, handed, place, 0, 0) }
        }
      }
      .none { return .err(.failed((f.path, "write: too far into the file"))) }
    }
    if given == no_places() {
      stream = true
    } else if given == would_block() {
      if __scheduled() { wait_to_write(f.handle) }
    } else if given == -4 {
    } else if given < 0 {
      return .err(failure(f.path, "write", given))
    } else {
      n = count(given)
      if n < handed {
        rest = if whole { tail(bytes, n) } else { tail(rest, n) }
        whole = false
      }
      match checked_add(done, n) {
        .some(total) { done = total }
        .none { return .err(.failed((f.path, "write: too many bytes"))) }
      }
    }
  }
  .ok(())
}

// A file of `memory_fs`: the path it is found by and the bytes it holds.
pub struct MemoryFile {
  pub path: str
  pub bytes: List[Byte]
}

pub type Files = List[MemoryFile]

fn found(files: List[MemoryFile], path: str) -> Option[Nat] {
  loop i in 0..files.size {
    if files[i].path == path { return .some(i) }
  }
  .none
}

// The files with the one at `at` holding `bytes`, and every other as it was.
fn holding(files: List[MemoryFile], at: Nat, bytes: List[Byte]) -> List[MemoryFile] <alloc> {
  var made: List[MemoryFile] = []
  loop i in 0..files.size {
    if i == at {
      made = push(made, MemoryFile(path: files[i].path, bytes: copy(bytes)))
    } else {
      made = push(made, MemoryFile(path: files[i].path, bytes: copy(files[i].bytes)))
    }
  }
  made
}

// The bytes of the range that the file holds, which are fewer when it ends first.
fn piece(bytes: List[Byte], range: Range) -> List[Byte] <alloc> {
  last = if range.end < bytes.size { range.end } else { bytes.size }
  var made: List[Byte] = []
  if range.start <= last {
    loop i in range.start..last {
      if i < bytes.size { made = push(made, bytes[i]) }
    }
  }
  made
}

// What a file of `old` holds once `bytes` are put in it from the place `at`: the
// bytes before the place that it did not hold are zeros.
fn put(old: List[Byte], at: Nat, bytes: List[Byte], total: Nat) -> List[Byte] <alloc> {
  var made: List[Byte] = []
  loop k in 0..total {
    if k >= at and k - at < bytes.size {
      made = push(made, bytes[k - at])
    } else if k < old.size {
      made = push(made, old[k])
    } else {
      made = push(made, 0)
    }
  }
  made
}

// A handler of `fs` over files that are kept in memory, for a test: `files` are
// the files there are when the body begins, a file that is created is added, and
// a file is found by its path. A file is open by the number of its place in the
// list, and nothing in memory is refused or fails.
pub fn memory_fs[T](files: take Files, body: fn() -> T <fs>) -> T <alloc> {
  var held = files
  fs(
    open_file: fn(path) {
      match found(held, path) {
        .some(i) { .ok(named(i, path)) }
        .none { .err(.missing(path)) }
      }
    },
    create_file: fn(path, executable) {
      match found(held, path) {
        .some(i) {
          held = holding(held, i, [])
          .ok(named(i, path))
        }
        .none {
          at = held.size
          held = push(held, MemoryFile(path: path, bytes: []))
          .ok(named(at, path))
        }
      }
    },
    close_file: fn(f) { n = release(f) },
    size: fn(f) {
      at = handle(f)
      if at < held.size { .ok(held[at].bytes.size) } else { .err(.failed((f.path, "size: no such file"))) }
    },
    read: fn(f, range) {
      at = handle(f)
      if at < held.size { .ok(piece(held[at].bytes, range)) } else { .err(.failed((f.path, "read: no such file"))) }
    },
    write: fn(f, at, bytes) {
      place = handle(f)
      match checked_add(at, bytes.size) {
        .some(end) {
          if place < held.size {
            total = if end > held[place].bytes.size { end } else { held[place].bytes.size }
            held = holding(held, place, put(held[place].bytes, at, bytes, total))
            .ok(())
          } else {
            .err(.failed((f.path, "write: no such file")))
          }
        }
        .none { .err(.failed((f.path, "write: too far into the file"))) }
      }
    },
    body: body,
  )
}

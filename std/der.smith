use std.bits (bit_and, shift_right)
use std.int (wrapping_add, wrapping_mul, wrapping_shift_left, wrapping_sub)
use std.list (push)
use std.utf8 (utf8)

// A value of DER as the kind its tag says it is, with its contents as a piece
// of the bytes given. A kind that is read further holds a type of its own, so
// what reads it is given only that kind.
pub enum Value {
  boolean: bool
  integer: Integer
  bits: Bits
  octets: Slice[Byte]
  null
  object: Object
  chars: Chars
  sequence: Parts
  set: Parts
  utc_time: Slice[Byte]
  general_time: Slice[Byte]
  context: (0..31, Parts)
  context_bytes: (0..31, Slice[Byte])
  other: (Nat, Slice[Byte])
}

// The contents of an integer, which DER never writes with no bytes.
pub struct Integer {
  pub bytes: Slice[Byte]
  pub some: bytes.size > 0
}

pub struct Bits {
  pub bytes: Slice[Byte]
}

pub struct Object {
  pub bytes: Slice[Byte]
}

// The contents of a value that is built of parts.
pub struct Parts {
  pub bytes: Slice[Byte]
}

// The three kinds of text that DER writes, each with its contents.
pub enum Chars {
  utf8: Slice[Byte]
  printable: Slice[Byte]
  ia5: Slice[Byte]
}

// The length that begins at `at`, and where the contents it measures begin.
fn length(bytes: Slice[Byte], at: Nat) -> Result[(Nat, Nat), str] {
  if at >= bytes.size { return .err("the bytes end before the length") }
  first = bytes[at]
  short: Nat = first
  if first < 128 { return .ok((short, at + 1)) }
  if first == 128 { return .err("a length with no end") }
  count: Nat = first - 128
  if count > 8 { return .err("a length of more bytes than there are") }
  if count >= bytes.size - at { return .err("the bytes end inside the length") }
  if bytes[at + 1] == 0 { return .err("a length that could be shorter") }
  mut n: Nat = 0
  loop i in 0..count {
    b: Nat = bytes[at + 1 + i]
    if n >= 72057594037927936 {
      return .err("a length of more bytes than there are")
    } else {
      n = wrapping_add(wrapping_mul(n, 256), b)
    }
  }
  if n < 128 { return .err("a length that could be shorter") }
  .ok((n, at + 1 + count))
}

// The value that the identifier byte `id` says the contents `c` are, which
// must be written as DER writes one of its kind.
fn made(id: Byte, c: Slice[Byte]) -> Result[Value, str] {
  number = bit_and(id, 31)
  constructed = bit_and(id, 32) != 0
  class = shift_right(id, 6)
  if number < 31 {
    if class == 2 {
      n: 0..31 = number
      if constructed { return .ok(.context((n, Parts(bytes: c)))) }
      return .ok(.context_bytes((n, c)))
    }
  } else {
    return .err("a tag of more than one byte")
  }
  if class != 0 { return .ok(.other((id, c))) }
  if number == 16 or number == 17 {
    if not constructed { return .err("a sequence or a set that is not built of parts") }
    if number == 16 { return .ok(.sequence(Parts(bytes: c))) }
    return .ok(.set(Parts(bytes: c)))
  }
  if constructed { return .ok(.other((id, c))) }
  if number == 1 {
    if c.size != 1 { return .err("a boolean that is not one byte") }
    if c[0] != 0 and c[0] != 255 { return .err("a boolean that is neither 0 nor 255") }
    .ok(.boolean(c[0] == 255))
  } else if number == 2 {
    if c.size == 0 {
      .err("an integer of no bytes")
    } else {
      if c.size > 1 {
        if c[0] == 0 and c[1] < 128 { return .err("an integer with a byte at the front that it does not need") }
        if c[0] == 255 and c[1] >= 128 { return .err("an integer with a byte at the front that it does not need") }
      }
      .ok(.integer(Integer(bytes: c)))
    }
  } else if number == 3 {
    .ok(.bits(Bits(bytes: c)))
  } else if number == 4 {
    .ok(.octets(c))
  } else if number == 5 {
    if c.size != 0 { return .err("a null that holds bytes") }
    .ok(.null)
  } else if number == 6 {
    if c.size == 0 { return .err("an object identifier of no bytes") }
    .ok(.object(Object(bytes: c)))
  } else if number == 12 {
    .ok(.chars(.utf8(c)))
  } else if number == 19 {
    .ok(.chars(.printable(c)))
  } else if number == 22 {
    .ok(.chars(.ia5(c)))
  } else if number == 23 {
    .ok(.utc_time(c))
  } else if number == 24 {
    .ok(.general_time(c))
  } else {
    .ok(.other((id, c)))
  }
}

// The value at the front of the bytes, and how many bytes it takes in all.
fn read(bytes: Slice[Byte]) -> Result[(Value, Nat), str] {
  if bytes.size == 0 { return .err("no bytes where a value is") }
  (len, start) = try length(bytes, 1)
  if start > bytes.size { return .err("the bytes end inside the length") }
  if len > bytes.size - start { return .err("the bytes end inside a value") }
  end = start + len
  v = try made(bytes[0], bytes[start..end])
  .ok((v, end))
}

pub fn value(bytes: Slice[Byte]) -> Result[(Value, Slice[Byte]), str] {
  (v, end) = try read(bytes)
  if end > bytes.size { return .err("the bytes end inside a value") }
  .ok((v, bytes[end..]))
}

// The values that the contents of a sequence, a set, or a context value built
// of parts hold.
pub fn children(of: Parts) -> Result[List[Value], str] <alloc> {
  mut parts: List[Value] = []
  mut rest = of.bytes
  loop i in 0..of.bytes.size {
    if rest.size == 0 { break }
    (v, end) = try read(rest)
    if end > rest.size { return .err("the bytes end inside a value") }
    push(mut parts, v)
    rest = rest[end..]
  }
  .ok(parts)
}

pub fn whole(of: Integer) -> Result[Slice[Byte], str] {
  if of.bytes[0] >= 128 { return .err("an integer that is below zero") }
  if of.bytes.size > 1 and of.bytes[0] == 0 { return .ok(of.bytes[1..]) }
  .ok(of.bytes)
}

pub fn text(of: Chars) -> Result[str, str] {
  match of {
    .utf8(b) { text_of(b) }
    .printable(b) { ascii_of(b) }
    .ia5(b) { ascii_of(b) }
  }
}

fn text_of(bytes: Slice[Byte]) -> Result[str, str] {
  match utf8(bytes) {
    .ok(t) { .ok(t) }
    .err(e) { .err("a text that is not valid UTF-8") }
  }
}

fn ascii_of(bytes: Slice[Byte]) -> Result[str, str] {
  loop i in 0..bytes.size {
    if bytes[i] >= 128 { return .err("a text with a byte that is not ASCII") }
  }
  text_of(bytes)
}

pub fn object(of: Object) -> Result[List[Nat], str] <alloc> {
  c = of.bytes
  mut arcs: List[Nat] = []
  mut n: Nat = 0
  mut fresh = true
  loop i in 0..c.size {
    b: Nat = c[i]
    if fresh and b == 128 { return .err("a number with a byte at the front that it does not need") }
    if n >= 72057594037927936 { return .err("a number too great") }
    low: Nat = bit_and(b, 127)
    n = wrapping_add(wrapping_mul(n, 128), low)
    if b < 128 {
      if arcs.size == 0 {
        if n < 40 {
          push(mut arcs, 0)
          push(mut arcs, n)
        } else if n < 80 {
          push(mut arcs, 1)
          push(mut arcs, n - 40)
        } else {
          push(mut arcs, 2)
          push(mut arcs, n - 80)
        }
      } else {
        push(mut arcs, n)
      }
      n = 0
      fresh = true
    } else {
      fresh = false
    }
  }
  if not fresh { return .err("a number that does not end") }
  .ok(arcs)
}

// The bytes of a bit string and how many bits at the end of the last byte are
// left over, which DER writes as zero.
pub fn bits(of: Bits) -> Result[(Slice[Byte], Nat), str] {
  c = of.bytes
  if c.size == 0 { return .err("a bit string of no bytes") }
  by = c[0]
  if by > 7 { return .err("a bit string with more than seven bits left over") }
  if c.size == 1 {
    if by != 0 { return .err("a bit string with bits left over and no byte to leave them in") }
    return .ok((c[1..], 0))
  }
  one: Byte = 1
  mask = wrapping_sub(wrapping_shift_left(one, by), 1)
  if bit_and(c[c.size - 1], mask) != 0 { return .err("a bit string whose bits left over are not zero") }
  left: Nat = by
  .ok((c[1..], left))
}

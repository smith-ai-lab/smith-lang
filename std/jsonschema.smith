use std.describe (Describer)
use std.bits (u64)
use std.int (saturating_add)
use std.json (Json, Unknown, json_string, written_member)
use std.list (push)
use std.text (Text, append, finish, text)

// The schema of a type, written as it is told what the type is made of.
//
// `scope` is what the text being written is inside: the elements of an array
// that are separated by commas, the members of an object, a value that one
// wrapper holds, or a case of an enum. A scope that holds another is saved
// when the other is entered and comes back when it is left.
enum Scope {
  alts
  props
  wrap
  held
  plain
  keyed
  tagged
}

struct Saved {
  scope: Scope
  count: Nat
  tail: str
  required: str
  case: str
  below: Nat
}

pub struct JsonSchema {
  settings: Json
  unknown: Unknown
  buffer: Text
  scope: Scope
  count: Nat
  // What is written when the scope ends, and the names, written as strings
  // and separated by commas, of the members the object it is in requires.
  tail: str
  required: str
  // The name of the case whose value is not begun, which is in `held`.
  case: str
  // Whether the value that is begun next is the members of the struct beside
  // the tag, and not a value under `value`.
  merge: bool
  // The comment that the next value begun is written with.
  about: str
  saved: List[Saved]
  top: Nat
}

// The describer of a JSON Schema for the values that `to_json_as` writes and
// `from_json_as` reads with the settings, which is told what a type is made
// of by `Describe[T].describe` and gives the schema with `schema_text`.
pub fn json_schema(json: Json; unknown: Unknown = .ignore) -> JsonSchema {
  JsonSchema(settings: json, unknown: unknown, buffer: text(), scope: .alts, count: 0, tail: "", required: "", case: "", merge: false, about: "", saved: [], top: 0)
}

pub fn schema_text(to: take JsonSchema) -> str {
  finish(take to.buffer)
}

fn emit(to: mut JsonSchema, s: str) <alloc> {
  append(mut to.buffer, s)
}

fn emit_json_string(to: mut JsonSchema, s: str) <alloc> {
  append(mut to.buffer, json_string(s))
}

fn refuses(unknown: Unknown) -> bool {
  match unknown {
    .ignore { false }
    .refuse { true }
  }
}

// The name of a member of a struct, as `to_json_as` writes it, as a string.
fn member_name(w: JsonSchema, name: str) -> str <alloc> {
  json_string(written_member(name, w.settings))
}

// Begins an object, with the comment that waits for a value, and `first`.
fn node(to: mut JsonSchema, first: str) <alloc> {
  emit(mut to, "\{")
  if to.about != "" {
    about = to.about
    emit(mut to, "\"description\":")
    emit_json_string(mut to, about)
    emit(mut to, ",")
    to.about = ""
  }
  emit(mut to, first)
}

fn leaf(to: mut JsonSchema, first: str) <alloc> {
  value_begins(mut to, false)
  node(mut to, first)
  emit(mut to, "\}")
}

fn closed(to: mut JsonSchema) <alloc> {
  if refuses(to.unknown) { emit(mut to, ",\"additionalProperties\":false") }
}

fn enter(to: mut JsonSchema, scope: Scope, tail: str) <alloc> {
  push(mut to.saved, Saved(scope: to.scope, count: to.count, tail: to.tail, required: to.required, case: to.case, below: to.top))
  to.top = to.saved.size
  to.scope = scope
  to.count = 0
  to.tail = tail
  to.required = ""
}

fn leave(to: mut JsonSchema) {
  t = to.top
  if t > 0 and t <= to.saved.size {
    frame = to.saved[t - 1]
    to.scope = frame.scope
    to.count = frame.count
    to.tail = frame.tail
    to.required = frame.required
    to.case = frame.case
    to.top = frame.below
  }
}

// Begins a value: a `,` where it follows another element, and, where it is
// what a case holds, the object round it. `structure` says whether the value
// is a struct, whose members then stand beside the tag.
fn value_begins(to: mut JsonSchema, structure: bool) <alloc> {
  match to.scope {
    .alts {
      if to.count > 0 { emit(mut to, ",") }
      to.count = saturating_add(to.count, 1)
    }
    .held { held_value(mut to, structure) }
    .props { }
    .wrap { }
    .plain { }
    .keyed { }
    .tagged { }
  }
}

fn held_value(to: mut JsonSchema, structure: bool) <alloc> {
  case = to.case
  match to.settings.cases {
    .key {
      node(mut to, "\"type\":\"object\",\"properties\":\{")
      emit(mut to, json_string(case))
      emit(mut to, ":")
      to.scope = .keyed
    }
    .tag(t) {
      if structure {
        to.merge = true
        to.scope = .plain
      } else {
        node(mut to, "\"type\":\"object\",\"properties\":\{")
        emit(mut to, "{json_string(t)}:\{\"const\":{json_string(case)}\},\"value\":")
        to.scope = .tagged
      }
    }
  }
}

impl Describer[JsonSchema] {
  fn boolean(d: mut JsonSchema) <alloc> { leaf(mut d, "\"type\":\"boolean\"") }
  fn signed(d: mut JsonSchema, least: Int, greatest: Int) <alloc> {
    leaf(mut d, "\"type\":\"integer\",\"minimum\":{least},\"maximum\":{greatest}")
  }
  fn unsigned(d: mut JsonSchema, least: u64, greatest: u64) <alloc> {
    leaf(mut d, "\"type\":\"integer\",\"minimum\":{least},\"maximum\":{greatest}")
  }
  fn text(d: mut JsonSchema) <alloc> { leaf(mut d, "\"type\":\"string\"") }
  fn nothing(d: mut JsonSchema) <alloc> { leaf(mut d, "\"type\":\"null\"") }
  fn optional(d: mut JsonSchema) <alloc> {
    value_begins(mut d, false)
    node(mut d, "\"anyOf\":[")
    enter(mut d, .alts, ",\{\"type\":\"null\"\}]\}")
  }
  fn end_optional(d: mut JsonSchema) <alloc> {
    tail = d.tail
    emit(mut d, tail)
    leave(mut d)
  }
  fn sequence(d: mut JsonSchema) <alloc> {
    value_begins(mut d, false)
    node(mut d, "\"type\":\"array\",\"items\":")
    enter(mut d, .wrap, "\}")
  }
  fn end_sequence(d: mut JsonSchema) <alloc> {
    tail = d.tail
    emit(mut d, tail)
    leave(mut d)
  }
  fn tuple(d: mut JsonSchema, size: Nat) <alloc> {
    value_begins(mut d, false)
    node(mut d, "\"type\":\"array\",\"prefixItems\":[")
    enter(mut d, .alts, "],\"minItems\":{size},\"maxItems\":{size}\}")
  }
  fn end_tuple(d: mut JsonSchema) <alloc> {
    tail = d.tail
    emit(mut d, tail)
    leave(mut d)
  }
  fn structure(d: mut JsonSchema, name: str, about: str, fields: Nat) <alloc> {
    value_begins(mut d, true)
    merge = d.merge
    d.merge = false
    if d.about == "" { d.about = about }
    node(mut d, "\"type\":\"object\",\"properties\":\{")
    enter(mut d, .props, "")
    if merge {
      match d.settings.cases {
        .key { }
        .tag(t) {
          case = d.case
          emit(mut d, "{json_string(t)}:\{\"const\":{json_string(case)}\}")
          d.count = 1
          d.required = json_string(t)
        }
      }
    }
  }
  fn field(d: mut JsonSchema, name: str, about: str, optional: bool) <alloc> {
    if d.count > 0 { emit(mut d, ",") }
    d.count = saturating_add(d.count, 1)
    written = member_name(d, name)
    emit(mut d, "{written}:")
    d.about = about
    if not optional {
      d.required = if d.required == "" { written } else { "{d.required},{written}" }
    }
  }
  fn end_structure(d: mut JsonSchema) <alloc> {
    emit(mut d, "\}")
    if d.required != "" {
      required = d.required
      emit(mut d, ",\"required\":[{required}]")
    }
    closed(mut d)
    emit(mut d, "\}")
    leave(mut d)
  }
  fn enumeration(d: mut JsonSchema, name: str, about: str, cases: Nat) <alloc> {
    value_begins(mut d, false)
    if d.about == "" { d.about = about }
    node(mut d, "\"oneOf\":[")
    enter(mut d, .alts, "]\}")
  }
  fn case(d: mut JsonSchema, name: str, about: str, holds: bool) <alloc> {
    value_begins(mut d, false)
    d.about = about
    if holds {
      enter(mut d, .held, "")
      d.case = name
    } else {
      match d.settings.cases {
        .key {
          node(mut d, "\"const\":{json_string(name)}")
          emit(mut d, "\}")
        }
        .tag(t) {
          node(mut d, "\"type\":\"object\",\"properties\":\{{json_string(t)}:\{\"const\":{json_string(name)}\}\},\"required\":[{json_string(t)}]")
          emit(mut d, "\}")
        }
      }
      enter(mut d, .plain, "")
    }
  }
  fn end_enumeration(d: mut JsonSchema) <alloc> {
    tail = d.tail
    emit(mut d, tail)
    leave(mut d)
  }
  fn end_case(d: mut JsonSchema) <alloc> {
    match d.scope {
      .keyed {
        case = d.case
        emit(mut d, "\},\"required\":[{json_string(case)}]")
        closed(mut d)
        emit(mut d, "\}")
      }
      .tagged {
        tag = tag_of(d.settings)
        emit(mut d, "\},\"required\":[{json_string(tag)},\"value\"]")
        closed(mut d)
        emit(mut d, "\}")
      }
      .alts { }
      .props { }
      .wrap { }
      .held { }
      .plain { }
    }
    leave(mut d)
  }
  fn map(d: mut JsonSchema) <alloc> { leaf(mut d, "\"type\":\"object\"") }
}

fn tag_of(json: Json) -> str {
  match json.cases {
    .key { "" }
    .tag(t) { t }
  }
}

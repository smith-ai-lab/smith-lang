use std.bits (bit_and, shift_right, u64)
use std.instant (Duration, Instant, instant, milliseconds as span_ms)
use std.int (clamp, wrapping_add, wrapping_mul)
use std.list (push)
use std.task (task, wait_for_time)

pub effect time {
  pub fn now() -> Instant
  pub fn sleep(span: Duration)
}

// The eight bytes of a number, the low one first, as the kernel reads them.
fn put(bytes: take List[Byte], n: u64) -> List[Byte] <alloc> {
  mut made = bytes
  loop i in 0..8 {
    made = push(made, bit_and(shift_right(n, 8 * i), 255))
  }
  made
}

// The number that the eight bytes from `at` are, the low one first.
fn word(bytes: List[Byte], at: Nat) -> u64 {
  mut n: u64 = 0
  mut scale: u64 = 1
  loop i in 0..bytes.size {
    if i >= at and i < at + 8 {
      wide: u64 = bytes[i]
      n = wrapping_add(n, wrapping_mul(wide, scale))
      scale = wrapping_mul(scale, 256)
    }
  }
  n
}

fn milliseconds(seconds: u64, nanoseconds: u64) -> u64 {
  part: u64 = nanoseconds / 1000000
  wrapping_add(wrapping_mul(seconds, 1000), part)
}

// A reading of the clock past the end of what an `Instant` holds is taken for
// that end.
fn system_now() -> Instant <alloc> {
  mut stamp: List[Byte] = __reserve(16)
  stamp = put(put(stamp, 0), 0)
  _ = __system(10, 0, stamp)
  reading: 0..4611686018427387904 = clamp(milliseconds(word(stamp, 0), word(stamp, 8)))
  instant(reading)
}

fn system_sleep(span: Duration) <alloc, task> {
  ms: u64 = span_ms(span)
  // A task that a scheduler runs waits for the time and lets the others run, and
  // any other call waits on the thread.
  if __scheduled() {
    wait_for_time(span)
    return
  }
  mut left = ms
  loop attempt in 0..64 {
    seconds: u64 = left / 1000
    nanoseconds: u64 = (left % 1000) * 1000000
    mut wait: List[Byte] = []
    wait = put(put(wait, seconds), nanoseconds)
    mut rest: List[Byte] = __reserve(16)
    rest = put(put(rest, 0), 0)
    result = __system(11, wait, rest)
    if result != -4 { break }
    left = milliseconds(word(rest, 0), word(rest, 8))
  }
}

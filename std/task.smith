use std.bits (bit_and, bit_xor, i64, shift_right, u64)
use std.int (checked_rem, wrapping_add, wrapping_mul, wrapping_narrow, wrapping_sub)
use std.list (push)

// The functions of task groups: `tasks` opens a group for the rest of a block,
// `spawn` starts a child in it, and `join` waits for the child and gives its
// value.
//
// The types below are what the library's scheduler is written with, beside the
// compiler's `__frame`, `__poll`, `__result`, and `__wait`, which only the
// library may call. A `Frame` is the memory of a lambda made a task, and is
// used exactly once, so it ends by `__result`.
pub struct Frame {
  memory: Slice[Byte]
}

without Copy for Frame
without Discard for Frame

// What the system calls a thing that a task waits on, as `Connection` holds one.
pub struct Handle {
  pub number: u64
}

// What a task waits for: a handle to be ready to read or to write, some
// milliseconds from when it waits, another task, by its number, to end, or a
// handle to be ready to read or to write until some milliseconds have gone,
// whichever comes first, which the task says by `limit` just before it waits, so
// that the handle and the milliseconds are each held whole.
pub enum Wait {
  read: Handle
  write: Handle
  time: u64
  task: u64
  read_by: Handle
  write_by: Handle
}

// What polling a frame says: that the task is done, or what it waits for.
pub enum Poll {
  done
  waiting: Wait
}

// A child, by the number the scheduler gave it. Only `spawn` makes one, from a
// frame of a lambda that gives `T`, so what `join` reads at `T` is a `T`.
pub struct Task[T] {
  number: u64
  gives: [0]T
}

without Copy for Task

// What a scheduler answers: `start` takes a child's frame and gives its number,
// and `finish` waits until that child has ended and gives its frame back, once.
pub effect task {
  pub fn start(work: take Frame) -> u64
  pub fn finish(child: u64) -> Frame
  // For the library alone, which a program that calls it is refused: waits until
  // every task other than the one that asks has ended, the ones that were started
  // after it asked too, which is how a server that is shut down serves the
  // connections it has.
  pub fn quiet()
  // For the library alone, which a program that calls it is refused: whether the
  // task that asks was woken by its time and not by its handle, after it waited
  // for a handle by a time.
  pub fn timed_out() -> bool
  // For the library alone, which a program that calls it is refused: the
  // milliseconds that the next wait of the task that asks, for a handle until a
  // time, lasts.
  pub fn limit(ms: u64)
}

// Runs a frame to its end. The system's scheduler waits for nothing yet, so a
// frame that waits ends the program.
fn run(frame: Frame) {
  match __poll(frame) {
    .done { }
    .waiting(w) {
      __eprint("a task waits, and the system's scheduler does not wait yet")
      __end(1)
    }
  }
}

// The number of a child is where its frame's bytes are, and the frame is found
// again by `finish`, so a scheduler lends the frame and keeps nothing.
fn started(work: Frame) -> u64 {
  run(work)
  __address(work)
}

fn system_start(work: Frame) -> u64 {
  started(work)
}

fn system_finish(number: u64) -> Frame {
  at = __frame_at(number)
  at
}

// The system's scheduler runs each child to its end where it starts it, so nothing
// is left to wait for.
fn system_quiet() { }

// The system's scheduler waits for nothing, so no task was woken by its time.
fn system_timed_out() -> bool { false }

fn system_limit(ms: u64) { }

// A group. Where a scheduler is in force it hands each child to that one, and
// where none is it is the scheduler of its children, which runs them until they
// all wait and then waits for the system with `epoll`, so that a task that waits
// holds no thread. Which it is, is known when the copy is built. It lists `task`
// for the copy that is built, and no caller lists it for the group.
pub fn tasks[T](body: take fn() -> T ! task) -> T ! task {
  if __scheduled() {
    task(
      // The frame is lent here, and is handed on by its number, which is the frame
      // as the scheduler in force knows it.
      start: fn(work) { start(__frame_at(__address(work))) },
      finish: fn(child) { finish(child) },
      quiet: { quiet() },
      timed_out: { timed_out() },
      limit: fn(ms) { limit(ms) },
      body: body,
    )
  } else {
    alloc(body: { group(body) })
  }
}

pub fn spawn[T](work: take fn() -> T) -> Task[T] ! task {
  Task(number: start(__frame(work)), gives: [])
}

pub fn join[T](child: take Task[T]) -> T ! task {
  __result(finish(child.number))
}

// The next number of a sequence that `seed` picks, which mixes the bits of the
// state well, so that seeds that are near one another give different orders.
fn mixed(state: u64) -> u64 {
  a = wrapping_mul(bit_xor(state, shift_right(state, 30)), 13787848793156543929)
  b = wrapping_mul(bit_xor(a, shift_right(a, 27)), 10723151780598845931)
  bit_xor(b, shift_right(b, 31))
}

// What a scheduler knows of a task is in the header of the task's frame, in four
// words that `__word` and `__set_word` read and write by the number of the task,
// which is where its frame is: the task that was started before it, the state
// of the task, what it waits for, and a word to spare. So a scheduler holds
// nothing in memory of its own: its queues are chains through the frames, which
// a task's memory, released when an arena ends, cannot take from under it.
fn after(n: u64) -> u64 { __word(n, 0) }

fn state(n: u64) -> u64 { __word(n, 1) }

fn on(n: u64) -> u64 { __word(n, 2) }

// The bits of the state of a task: that it has ended, that it waits for a task
// that has not, and that it waits for a descriptor.
// The bits of the state that a mask picks, as a number.
fn bits(n: u64, mask: u64) -> u64 {
  picked: u64 = bit_and(state(n), mask)
  picked
}

fn has_ended(n: u64) -> bool { bits(n, 1) != 0 }

fn waits_for_task(n: u64) -> bool { bits(n, 2) != 0 }

fn waits_for_descriptor(n: u64) -> bool { bits(n, 4) != 0 }

fn is_detached(n: u64) -> bool { bits(n, 8) != 0 }

// That it waits for a time, whose moment is in the fourth word of its header, and
// that it was woken by the time and not by the handle it waited for.
fn waits_for_time(n: u64) -> bool { bits(n, 16) != 0 }

fn is_timed_out(n: u64) -> bool { bits(n, 32) != 0 }

fn deadline(n: u64) -> u64 { __word(n, 3) }

// That the task has been asked to end, by its parent that ended or by the end of
// the block it was started in, and that it has run at least once. The bit that
// asks is the one the compiler writes where a child is dropped by a task that
// ends, and the one each function of the task reads, `CANCEL` of the compiler.
fn is_cancelled(n: u64) -> bool { bits(n, 64) != 0 }

fn has_started(n: u64) -> bool { bits(n, 128) != 0 }

// Whether a task of the chain that begins at `first` waits for the task, which
// then keeps its frame, since the one that waits reads it ended from there.
fn is_waited_for(first: u64, n: u64) -> bool {
  var found = false
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if waits_for_task(at) and on(at) == n { found = true }
    at = after(at)
  }
  found
}

// Gives back the frame and the stack of every task that has ended and whose
// handle was dropped, which the compiler marks in the state of the task where
// the handle is dropped, and takes each out of the chain that begins at
// `first`. It gives where the chain begins now.
fn reap(first: u64) -> u64 {
  var head = first
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    next = after(at)
    // A task asked to end that never ran has nothing to end.
    if is_cancelled(at) and not has_started(at) and not has_ended(at) { ended(at) }
    if has_ended(at) and is_detached(at) and not is_waited_for(head, at) {
      head = leave(head, at)
      __drop(__frame_at(at))
    }
    at = next
  }
  head
}

// The first task of the chain that begins at `first` that has not ended and is
// not `except`, or none.
fn pending(first: u64, except: u64) -> u64 {
  var at = first
  var found: u64 = 0
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if not has_ended(at) and at != except {
      found = at
      break
    }
    at = after(at)
  }
  found
}

// Ends every task of the chain that begins at `first` but the one the block is
// of, at the end of its block: the frame and the stack of each, whether it has
// ended or waits, go back to the pool. The chain goes from the task started last
// to the one started first, so a child is ended before the task that started it.
fn cancel_rest(first: u64, root: u64) {
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    next = after(at)
    if at != root { __drop(__frame_at(at)) }
    at = next
  }
}

// Puts a task first in the chain of those started, and gives its number.
fn enter(n: u64, first: u64) -> u64 {
  __set_word(n, 0, first)
  __set_word(n, 1, 0)
  __set_word(n, 2, 0)
  __set_word(n, 3, 0)
  n
}

// Takes a task out of the chain that begins at `first`, and gives where the
// chain begins now.
fn leave(first: u64, n: u64) -> u64 {
  if first == n { return after(n) }
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if after(at) == n {
      __set_word(at, 0, after(n))
      break
    }
    at = after(at)
  }
  first
}

// Whether the task may run: it has not ended, it does not wait for a descriptor,
// and the task it waits for, if it waits for one, has ended.
fn runnable(n: u64) -> bool {
  if has_ended(n) { return false }
  if is_cancelled(n) { return has_started(n) }
  if waits_for_descriptor(n) or waits_for_time(n) { return false }
  if waits_for_task(n) { has_ended(on(n)) } else { true }
}

fn count_runnable(first: u64) -> u64 {
  var count: u64 = 0
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if runnable(at) { count = wrapping_add(count, 1) }
    at = after(at)
  }
  count
}

fn nth_runnable(first: u64, k: u64) -> u64 {
  var seen: u64 = 0
  var found: u64 = 0
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if runnable(at) {
      if seen == k { found = at }
      seen = wrapping_add(seen, 1)
    }
    at = after(at)
  }
  found
}

// The task stops waiting for a descriptor and for a time, whichever it waited
// for, and is told whether its time came.
fn woken_by(n: u64, time: bool) {
  var made = wrapping_sub(wrapping_sub(wrapping_sub(state(n), bits(n, 4)), bits(n, 16)), bits(n, 32))
  if time { made = wrapping_add(made, 32) }
  __set_word(n, 1, made)
}

// Wakes the tasks that wait for the descriptor, and gives how many there were.
fn wake(first: u64, fd: u64) -> u64 {
  var woken: u64 = 0
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if waits_for_descriptor(at) and on(at) == fd {
      woken_by(at, false)
      woken = wrapping_add(woken, 1)
    }
    at = after(at)
  }
  woken
}

// Whether a task waits for a time.
fn has_timers(first: u64) -> bool {
  var found = false
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if waits_for_time(at) { found = true }
    at = after(at)
  }
  found
}

// Whether a task waits for the descriptor.
fn has_waiter(first: u64, fd: u64) -> bool {
  var found = false
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if waits_for_descriptor(at) and on(at) == fd { found = true }
    at = after(at)
  }
  found
}

// Wakes the tasks whose time has come, as `moment` says, and gives how many of
// them were waiting for a descriptor too.
fn expire(first: u64, moment: u64) -> u64 {
  var woken: u64 = 0
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if waits_for_time(at) and deadline(at) <= moment {
      if waits_for_descriptor(at) { woken = wrapping_add(woken, 1) }
      woken_by(at, true)
    }
    at = after(at)
  }
  woken
}

// The milliseconds from `moment` to the nearest time that a task waits for, and
// none, which is 0, when none waits for one. A time that has come is not one,
// since `expire` wakes it.
fn nearest(first: u64, moment: u64) -> u64 {
  var found: u64 = 0
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if waits_for_time(at) and deadline(at) > moment {
      left = wrapping_sub(deadline(at), moment)
      if found == 0 or left < found { found = left }
    }
    at = after(at)
  }
  found
}

// What the task did when it was run: it ended, or it waits for something.
fn ended(n: u64) {
  __set_word(n, 1, wrapping_add(state(n), 1))
}

fn waits_on_task(n: u64, t: u64) {
  __set_word(n, 1, wrapping_add(wrapping_sub(state(n), bits(n, 2)), 2))
  __set_word(n, 2, t)
}

fn waits_on_descriptor(n: u64, fd: u64) {
  __set_word(n, 1, wrapping_add(wrapping_sub(state(n), bits(n, 32)), 4))
  __set_word(n, 2, fd)
}

// The task waits until the moment, as well as for what else it waits for.
fn waits_on_time(n: u64, moment: u64) {
  __set_word(n, 1, wrapping_add(wrapping_sub(state(n), bits(n, 32)), 16))
  __set_word(n, 3, moment)
}

// The task goes on when it is run again, so it waits for nothing then.
fn runs_again(n: u64) {
  var made = wrapping_sub(state(n), bits(n, 2))
  if not has_started(n) { made = wrapping_add(made, 128) }
  __set_word(n, 1, made)
}

// Asks every task of the chain that begins at `first` that has not ended, but the
// one the block is of, to end.
fn ask_rest(first: u64, root: u64) {
  var at = first
  loop round in 0..9223372036854775807 {
    if at == 0 { break }
    if at != root and not has_ended(at) and not is_cancelled(at) {
      __set_word(at, 1, wrapping_add(state(at), 64))
    }
    at = after(at)
  }
}

// A scheduler for tests. It starts nothing until a task is waited for, and runs
// the tasks that may run in an order that `seed` picks: one seed always gives
// the same order. A task that waits for another is suspended, and runs again
// when that one has ended. `body` is the first task.
pub fn test_scheduler[T](seed: u64, body: take fn() -> T ! task) -> T ! diverge {
  with test_scheduler_with_io(seed, [])
  body()
}

// The scheduler of a test that gives I/O: the handles in `ready` become ready,
// one at a time and in that order, each when no task can run, and wake the
// tasks that wait for it with `test_ready`. A handle never becomes ready before
// a task waits for it, and a task that waits for a handle that is not in `ready`
// waits for ever, which ends the program as every task waiting does.
pub fn test_scheduler_with_io[T](seed: u64, ready: List[u64], body: take fn() -> T ! task) -> T ! diverge {
  var first: u64 = 0
  var next: u64 = 0
  var rng: u64 = seed
  var current: u64 = 0
  var clock: u64 = 0
  var by: u64 = 0
  task(
    start: fn(work) {
      n = enter(__address(work), first)
      first = n
      n
    },
    finish: fn(child) {
      if not has_ended(child) { __wait(.task(child)) }
      first = leave(first, child)
      f = __frame_at(child)
      f
    },
    quiet: {
      loop round in 0..9223372036854775807 {
        other = pending(first, current)
        if other == 0 { break }
        __wait(.task(other))
      }
    },
    timed_out: { is_timed_out(current) },
    limit: fn(ms) { by = ms },
    body: {
      root = __frame(body)
      top = enter(__address(root), first)
      first = top
      loop {
        if has_ended(top) { break }
        first = reap(first)
        var many = count_runnable(first)
        if many == 0 {
          // Nothing can run: a handle of `ready` becomes ready, when a task that
          // waits for a time has none to wait for, and otherwise the time of the
          // test goes forward to the nearest that a task waits for.
          soon = nearest(first, clock)
          if next < ready.size and (soon == 0 or has_waiter(first, ready[next])) {
            wake(first, ready[next])
            next = wrapping_add(next, 1)
          } else if soon > 0 {
            clock = wrapping_add(clock, soon)
            expire(first, clock)
          }
          many = count_runnable(first)
        }
        rng = wrapping_add(rng, 11400714819323198485)
        match checked_rem(mixed(rng), many) {
          .none {
            __eprint("every task waits, and none can run")
            __end(1)
          }
          .some(k) {
            n = nth_runnable(first, k)
            runs_again(n)
            current = n
            f = __frame_at(n)
            match __poll(f) {
              .done { ended(n) }
              .waiting(w) {
                match w {
                  .task(t) { waits_on_task(n, t) }
                  .read(h) { waits_on_descriptor(n, h.number) }
                  .write(h) { waits_on_descriptor(n, h.number) }
                  .time(t) { waits_on_time(n, wrapping_add(clock, t)) }
                  .read_by(h) {
                    waits_on_descriptor(n, h.number)
                    waits_on_time(n, wrapping_add(clock, by))
                  }
                  .write_by(h) {
                    waits_on_descriptor(n, h.number)
                    waits_on_time(n, wrapping_add(clock, by))
                  }
                }
              }
            }
            __consume(f)
          }
        }
      }
      // The tasks still in the group are asked to end, and each one that has run
      // leaves by the exits of the functions it is in, the one started last first,
      // so a child ends before its parent. One that never ran has nothing to end.
      ask_rest(first, top)
      loop round in 0..9223372036854775807 {
        other = pending(first, top)
        if other == 0 { break }
        if has_started(other) {
          f = __frame_at(other)
          match __poll(f) {
            .done { ended(other) }
            .waiting(w) {
              __eprint("a task that was asked to end waits again")
              __end(1)
            }
          }
          __consume(f)
        } else {
          ended(other)
        }
      }
      cancel_rest(first, top)
      result: T = __result(root)
      result
    },
  )
}

// A task waits until the test says the handle is ready, as it does for a
// connection of a socket under the scheduler of a program.
pub fn test_ready(handle: u64) ! task {
  __wait(.read(Handle(number: handle)))
}

// A task waits until the test says the handle is ready or the milliseconds have
// gone, whichever comes first, in the time of the test, which goes forward only
// when no task can run. It is told which: true when the handle was ready.
pub fn test_ready_by(handle: u64, ms: u64) -> bool ! task {
  wait_to_read_by(handle, ms)
}

// For the library: waits for the milliseconds, as a task that a scheduler runs.
pub fn wait_for_time(ms: u64) ! task {
  __wait(.time(ms))
}

// Waits until the descriptor can be read or the milliseconds have gone, whichever
// comes first, and says which: true when it can be read.
pub fn wait_to_read_by(handle: u64, ms: u64) -> bool ! task {
  limit(ms)
  __wait(.read_by(Handle(number: handle)))
  not timed_out()
}

pub fn wait_to_write_by(handle: u64, ms: u64) -> bool ! task {
  limit(ms)
  __wait(.write_by(Handle(number: handle)))
  not timed_out()
}

// Bytes of a number of 32 bits, lowest first.
fn le32(list: take List[Byte], n: u64) -> List[Byte] ! alloc {
  b0: Byte = bit_and(n, 255)
  b1: Byte = bit_and(shift_right(n, 8), 255)
  b2: Byte = bit_and(shift_right(n, 16), 255)
  b3: Byte = bit_and(shift_right(n, 24), 255)
  push(push(push(push(list, b0), b1), b2), b3)
}

// Asks `epoll` to say once when the descriptor can be read or written. The event
// is the same twelve bytes of data on every machine that has `epoll`, since the
// descriptor is written where each machine reads it.
fn register(ep: i64, fd: u64, write: bool) -> i64 ! alloc {
  var events: u64 = 1073741825
  if write { events = 1073741828 }
  var event: List[Byte] = []
  event = le32(event, events)
  event = le32(event, fd)
  event = le32(event, fd)
  event = le32(event, fd)
  descriptor: i64 = wrapping_narrow(fd)
  added = __system(14, ep, 1, descriptor, event, 0, 0)
  if added == -17 { __system(14, ep, 3, descriptor, event, 0, 0) } else { added }
}

// Whether the kernel is macOS's, whose scheduler waits with `kqueue` and not
// `epoll`. Which one is asked is known when the program is built.
fn on_macos() -> bool {
  __system(12) == 1
}

// Bytes of a number of 64 bits, lowest first.
fn le64(list: take List[Byte], n: u64) -> List[Byte] ! alloc {
  low: u64 = bit_and(n, 4294967295)
  high: u64 = shift_right(n, 32)
  le32(le32(list, low), high)
}

// The number that the eight bytes from `at` are, the low one first.
fn word64(bytes: List[Byte], at: Nat) -> u64 {
  var n: u64 = 0
  var scale: u64 = 1
  loop i in 0..bytes.size {
    if i >= at and i < at + 8 {
      wide: u64 = bytes[i]
      n = wrapping_add(n, wrapping_mul(wide, scale))
      scale = wrapping_mul(scale, 256)
    }
  }
  n
}

// The milliseconds the clock of the system says, which only goes forward: the
// monotonic clock, 1 on Linux and 6 on macOS.
fn read_clock() -> u64 ! alloc {
  var stamp: List[Byte] = []
  stamp = le64(le64(stamp, 0), 0)
  var clock: i64 = 1
  if on_macos() { clock = 6 }
  __system(18, clock, stamp, 0, 0, 0, 0)
  seconds = word64(stamp, 0)
  part: u64 = word64(stamp, 8) / 1000000
  wrapping_add(wrapping_mul(seconds, 1000), part)
}

// The queue the system's scheduler waits with, which is an `epoll` of Linux or
// a `kqueue` of macOS.
fn make_queue() -> i64 {
  if on_macos() { __system(16, 0, 0, 0, 0, 0, 0) } else { __system(13, 0, 0, 0, 0, 0, 0) }
}

// Asks `kqueue` to say once when the descriptor can be read or written: one
// `kevent` of 32 bytes, which is the descriptor, the filter (-1 to read and -2 to
// write), the flags that add it and drop it once it has said so, and zeros.
fn register_kqueue(kq: i64, fd: u64, write: bool) -> i64 ! alloc {
  var word: u64 = 1179647
  if write { word = 1179646 }
  var change: List[Byte] = []
  change = le32(change, fd)
  change = le32(change, 0)
  change = le32(change, word)
  change = le32(change, 0)
  change = le32(change, 0)
  change = le32(change, 0)
  change = le32(change, 0)
  change = le32(change, 0)
  __system(17, kq, change, 1, 0, 0, 0)
}

// The descriptor that `kqueue` says is ready, waiting for it when the time is
// negative, and none when it says nothing.
fn ready_kqueue(kq: i64, time: i64) -> Option[u64] ! alloc {
  buffer: List[Byte] = __reserve(32)
  var got: i64 = 0
  if time < 0 {
    got = __system(17, kq, 0, 0, buffer, 1, 0)
  } else {
    // The time to wait is a pair of numbers, the seconds and the nanoseconds.
    ms: u64 = wrapping_narrow(time)
    var limit: List[Byte] = []
    limit = le64(limit, ms / 1000)
    limit = le64(limit, (ms % 1000) * 1000000)
    got = __system(17, kq, 0, 0, buffer, 1, limit)
  }
  if got != 1 { return .none }
  event = __sized(buffer, 32)
  if event.size < 4 { return .none }
  b0: u64 = event[0]
  b1: u64 = event[1]
  b2: u64 = event[2]
  b3: u64 = event[3]
  .some(wrapping_add(b0, wrapping_add(wrapping_mul(b1, 256), wrapping_add(wrapping_mul(b2, 65536), wrapping_mul(b3, 16777216)))))
}

// Asks the system's queue to say once when the descriptor can be read or written.
fn register_wait(queue: i64, fd: u64, write: bool) -> i64 ! alloc {
  if on_macos() { register_kqueue(queue, fd, write) } else { register(queue, fd, write) }
}

// The descriptor the system's queue says is ready, as below.
fn ready(queue: i64, time: i64) -> Option[u64] ! alloc {
  if on_macos() { ready_kqueue(queue, time) } else { ready_descriptor(queue, time) }
}

// The descriptor that `epoll` says is ready, waiting for it when the time is
// negative, and none when it says nothing.
fn ready_descriptor(ep: i64, time: i64) -> Option[u64] ! alloc {
  buffer: List[Byte] = __reserve(16)
  got = __system(15, ep, buffer, 1, time, 0, 0)
  if got != 1 { return .none }
  event = __sized(buffer, 16)
  if event.size < 12 { return .none }
  b0: u64 = event[8]
  b1: u64 = event[9]
  b2: u64 = event[10]
  b3: u64 = event[11]
  .some(wrapping_add(b0, wrapping_add(wrapping_mul(b1, 256), wrapping_add(wrapping_mul(b2, 65536), wrapping_mul(b3, 16777216)))))
}

// The scheduler of a group that no scheduler is in force of: its children are
// run in turn, each until it waits, and when every one waits for the system the
// group waits for the system, in `epoll` or in `kqueue`, for a descriptor to be ready. It holds
// numbers and nothing else, as every scheduler does.
fn group[T](body: take fn() -> T ! task) -> T ! alloc {
  var first: u64 = 0
  var parked: u64 = 0
  var ep: i64 = -1
  var turn: u64 = 0
  var current: u64 = 0
  var by: u64 = 0
  task(
    start: fn(work) {
      n = enter(__address(work), first)
      first = n
      n
    },
    finish: fn(child) {
      if not has_ended(child) { __wait(.task(child)) }
      first = leave(first, child)
      f = __frame_at(child)
      f
    },
    quiet: {
      loop round in 0..9223372036854775807 {
        other = pending(first, current)
        if other == 0 { break }
        __wait(.task(other))
      }
    },
    timed_out: { is_timed_out(current) },
    limit: fn(ms) { by = ms },
    body: {
      root = __frame(body)
      top = enter(__address(root), first)
      first = top
      loop round in 0..9223372036854775807 {
        if has_ended(top) { break }
        first = reap(first)
        // The clock is read only when a task waits for a time.
        timers = has_timers(first)
        if timers { parked = wrapping_sub(parked, expire(first, read_clock())) }
        var many = count_runnable(first)
        var soon: u64 = 0
        if timers and many == 0 { soon = nearest(first, read_clock()) }
        if parked > 0 or soon > 0 {
          // The system's queue is asked what is ready, and when nothing can run it
          // is waited in until the nearest time that a task waits for, or for ever
          // when none waits for one.
          var time: i64 = 0
          if many == 0 {
            time = -1
            if soon > 0 {
              if soon > 2147483647 { time = 2147483647 } else { time = wrapping_narrow(soon) }
            }
          }
          if ep < 0 { ep = make_queue() }
          match ready(ep, time) {
            .some(fd) { parked = wrapping_sub(parked, wake(first, fd)) }
            .none { }
          }
          if timers { parked = wrapping_sub(parked, expire(first, read_clock())) }
          many = count_runnable(first)
        }
        turn = wrapping_add(turn, 1)
        match checked_rem(turn, many) {
          .none {
            __eprint("every task waits, and none can run")
            __end(1)
          }
          .some(k) {
            n = nth_runnable(first, k)
            // A task that was asked to end stops waiting for what it waited for.
            if is_cancelled(n) and waits_for_descriptor(n) { parked = wrapping_sub(parked, 1) }
            if is_cancelled(n) { woken_by(n, false) }
            runs_again(n)
            current = n
            f = __frame_at(n)
            match __poll(f) {
              .done { ended(n) }
              .waiting(w) {
                match w {
                  .task(t) { waits_on_task(n, t) }
                  .read(h) {
                    if ep < 0 { ep = make_queue() }
                    register_wait(ep, h.number, false)
                    waits_on_descriptor(n, h.number)
                    parked = wrapping_add(parked, 1)
                  }
                  .write(h) {
                    if ep < 0 { ep = make_queue() }
                    register_wait(ep, h.number, true)
                    waits_on_descriptor(n, h.number)
                    parked = wrapping_add(parked, 1)
                  }
                  .time(t) { waits_on_time(n, wrapping_add(read_clock(), t)) }
                  .read_by(h) {
                    if ep < 0 { ep = make_queue() }
                    register_wait(ep, h.number, false)
                    waits_on_descriptor(n, h.number)
                    waits_on_time(n, wrapping_add(read_clock(), by))
                    parked = wrapping_add(parked, 1)
                  }
                  .write_by(h) {
                    if ep < 0 { ep = make_queue() }
                    register_wait(ep, h.number, true)
                    waits_on_descriptor(n, h.number)
                    waits_on_time(n, wrapping_add(read_clock(), by))
                    parked = wrapping_add(parked, 1)
                  }
                }
              }
            }
            __consume(f)
          }
        }
      }
      // The tasks still in the group are asked to end, and each one that has run
      // leaves by the exits of the functions it is in, the one started last first,
      // so a child ends before its parent. One that never ran has nothing to end.
      ask_rest(first, top)
      loop round in 0..9223372036854775807 {
        other = pending(first, top)
        if other == 0 { break }
        if has_started(other) {
          f = __frame_at(other)
          match __poll(f) {
            .done { ended(other) }
            .waiting(w) {
              __eprint("a task that was asked to end waits again")
              __end(1)
            }
          }
          __consume(f)
        } else {
          ended(other)
        }
      }
      cancel_rest(first, top)
      result: T = __result(root)
      result
    },
  )
}

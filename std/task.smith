use std.bits (bit_xor, shift_right, u64)
use std.int (checked_rem, wrapping_add, wrapping_mul)
use std.list (push)

// The functions of task groups: `tasks` opens a group for the rest of a block,
// `spawn` starts a child in it, and `join` waits for the child and gives its
// value.
//
// The types below are what the library's scheduler is written with, beside the
// compiler's `__frame`, `__poll`, `__result`, and `__wait`, which only the
// library may call. A `Frame` is the memory of a lambda made a task, and is
// used exactly once, so it ends by `__result`.
pub struct Frame {
  memory: Slice[Byte]
}

without Copy for Frame
without Discard for Frame

// What the system calls a thing that a task waits on, as `Connection` holds one.
pub struct Handle {
  pub number: u64
}

// What a task waits for: a handle to be ready to read or to write, a moment of
// the clock in milliseconds, or another task, by its number, to end.
pub enum Wait {
  read: Handle
  write: Handle
  time: u64
  task: u64
}

// What polling a frame says: that the task is done, or what it waits for.
pub enum Poll {
  done
  waiting: Wait
}

// A child, by the number the scheduler gave it. Only `spawn` makes one, from a
// frame of a lambda that gives `T`, so what `join` reads at `T` is a `T`.
pub struct Task[T] {
  number: u64
  gives: [0]T
}

// What a scheduler answers: `start` takes a child's frame and gives its number,
// and `finish` waits until that child has ended and gives its frame back, once.
pub effect task {
  pub fn start(work: take Frame) -> u64
  pub fn finish(child: u64) -> Frame
}

// Runs a frame to its end. The system's scheduler waits for nothing yet, so a
// frame that waits ends the program.
fn run(frame: Frame) {
  match __poll(frame) {
    .done { }
    .waiting(w) {
      __eprint("a task waits, and the system's scheduler does not wait yet")
      __end(1)
    }
  }
}

// The number of a child is where its frame's bytes are, and the frame is found
// again by `finish`, so a scheduler lends the frame and keeps nothing.
fn started(work: Frame) -> u64 {
  run(work)
  __address(work)
}

fn system_start(work: Frame) -> u64 {
  started(work)
}

fn system_finish(number: u64) -> Frame {
  at = __frame_at(number)
  at
}

// A group: a scheduler of its own that holds no state, so a child runs to its
// end where it is started.
pub fn tasks[T](body: take fn() -> T ! task) -> T {
  task(
    start: fn(work) { started(work) },
    finish: fn(child) { system_finish(child) },
    body: body,
  )
}

pub fn spawn[T](work: take fn() -> T) -> Task[T] ! task {
  Task(number: start(__frame(work)), gives: [])
}

pub fn join[T](child: take Task[T]) -> T ! task {
  __result(finish(child.number))
}

// The next number of a sequence that `seed` picks, which mixes the bits of the
// state well, so that seeds that are near one another give different orders.
fn mixed(state: u64) -> u64 {
  a = wrapping_mul(bit_xor(state, shift_right(state, 30)), 13787848793156543929)
  b = wrapping_mul(bit_xor(a, shift_right(a, 27)), 10723151780598845931)
  bit_xor(b, shift_right(b, 31))
}

fn contains(list: List[u64], x: u64) -> bool {
  var found = false
  loop i in 0..list.size {
    if list[i] == x { found = true }
  }
  found
}

// A task that waits for another task to end.
struct Blocked {
  task: u64
  on: u64
}

// Whether the task may run: it has not ended, and the last task it waited for
// has ended. `waits` holds each wait of a task for another, and the last of a
// task's is the one that counts.
fn runnable(n: u64, ended: List[u64], waits: List[Blocked]) -> bool {
  if contains(ended, n) { return false }
  var on = n
  var waiting = false
  loop i in 0..waits.size {
    if waits[i].task == n {
      waiting = true
      on = waits[i].on
    }
  }
  if waiting { contains(ended, on) } else { true }
}

fn count_runnable(started: List[u64], ended: List[u64], waits: List[Blocked]) -> u64 {
  var count: u64 = 0
  loop i in 0..started.size {
    if runnable(started[i], ended, waits) { count = wrapping_add(count, 1) }
  }
  count
}

fn nth_runnable(k: u64, started: List[u64], ended: List[u64], waits: List[Blocked]) -> u64 {
  var seen: u64 = 0
  var found: u64 = 0
  loop i in 0..started.size {
    if runnable(started[i], ended, waits) {
      if seen == k { found = started[i] }
      seen = wrapping_add(seen, 1)
    }
  }
  found
}

// A scheduler for tests. It starts nothing until a task is waited for, and runs
// the tasks that may run in an order that `seed` picks: one seed always gives
// the same order. A task that waits for another is suspended, and runs again
// when that one has ended. `body` is the first task.
pub fn test_scheduler[T](seed: u64, body: take fn() -> T ! task) -> T ! alloc, diverge {
  var started: List[u64] = []
  var ended: List[u64] = []
  var waits: List[Blocked] = []
  var rng: u64 = seed
  task(
    start: fn(work) {
      n = __address(work)
      started = push(started, n)
      n
    },
    finish: fn(child) {
      if not contains(ended, child) { __wait(.task(child)) }
      f = __frame_at(child)
      f
    },
    body: {
      root = __frame(body)
      top = __address(root)
      started = push(started, top)
      loop {
        if contains(ended, top) { break }
        many = count_runnable(started, ended, waits)
        rng = wrapping_add(rng, 11400714819323198485)
        match checked_rem(mixed(rng), many) {
          .none {
            __eprint("every task waits, and none can run")
            __end(1)
          }
          .some(k) {
            n = nth_runnable(k, started, ended, waits)
            f = __frame_at(n)
            match __poll(f) {
              .done { ended = push(ended, n) }
              .waiting(w) {
                match w {
                  .task(t) { waits = push(waits, Blocked(task: n, on: t)) }
                  .read(h) { }
                  .write(h) { }
                  .time(t) { }
                }
              }
            }
            __consume(f)
          }
        }
      }
      result: T = __result(root)
      result
    },
  )
}

pub fn push[T](list: mut List[T], item: take T) <alloc> {
  __push(mut list, item)
}

pub fn append[T](a: mut List[T], b: List[T]) <alloc> {
  __append(mut a, b)
}

pub fn copy[T: Copy](list: List[T]) -> List[T] <alloc> {
  mut made: List[T] = []
  loop x in list { push(mut made, x) }
  made
}

pub fn freeze[T](list: take List[T]) -> Slice[T] {
  __freeze(list)
}

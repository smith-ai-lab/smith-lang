use std.alloc (arena)
use std.bits (u16, u64)
use std.deserialize (Deserialize, Problem, ReadError, Reader)
use std.describe (Describe, Describer)
use std.fetch (Method)
use std.fromtext (from_text)
use std.html (Html)
use std.http1 (RequestHead, body_of, chunk, request_head)
use std.int (saturating_add, saturating_sub)
use std.json (In, json_ended, json_in, to_json)
use std.list (append, copy, freeze, push)
use std.net (Connection, Listener, NetError, accept, close, listen_on, net, read, stop, write)
use std.serialize (Serialize)
use std.task (quiet, spawn, tasks)
use std.utf8 (utf8)

pub struct Request {
  pub method: Method
  pub path: str
  pub query: str
  pub headers: List[(str, str)]
  pub body: str
}

pub struct Response {
  pub status: 100..600
  pub headers: List[(HeaderName, HeaderValue)]
  pub body: str
}

// The name of a header the library writes. It is a token in small letters, and
// it is never one of the three that say where the body ends and whether the
// connection is kept, which `listen` writes itself, so a response never says
// two lengths. Only `header_name` and `check_name` make one.
pub struct HeaderName {
  token: str
}

// The value of a header, which holds no line break, so that a header never
// adds a line of its own. Only `header_value` and `check_value` make one.
pub struct HeaderValue {
  text: str
}

// Why a text is not the name or the value of a header, with the text.
pub enum HeaderError {
  not_a_token: str
  written_by_the_library: str
  line_break: str
}

impl Fmt[HeaderError] {
  fn fmt(value: HeaderError) -> str <alloc> {
    match value {
      .not_a_token(t) { "{t}: not a header name, which is letters, digits, and the marks of a token" }
      .written_by_the_library(t) { "{t}: a header the library writes, so it is not given" }
      .line_break(t) { "{t}: a header value holds no line break" }
    }
  }
}

impl Fmt[HeaderName] {
  fn fmt(value: HeaderName) -> str <alloc> { value.token }
}

impl Fmt[HeaderValue] {
  fn fmt(value: HeaderValue) -> str <alloc> { value.text }
}

fn lowered(b: Byte) -> Byte {
  if b >= 'A' and b <= 'Z' { b + 32 } else { b }
}

// Whether a byte may be in the name of a header: a letter, a digit, or one of
// ``!#$%&'*+-.^_`|~``.
fn token_byte(b: Byte) -> bool {
  (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == '!' or b == '#' or b == '$' or b == '%' or b == '&' or b == 39 or b == '*' or b == '+' or b == '-' or b == '.' or b == '^' or b == '_' or b == 96 or b == '|' or b == '~'
}

// Whether a text is a token: one byte or more, each of which a name may hold.
pub fn a_token(t: str) -> bool {
  var yes = t.size > 0
  loop b in t {
    if not token_byte(b) {
      yes = false
      break
    }
  }
  yes
}

// Whether a text is the name, whatever the case of its letters.
fn is_named(t: str, name: str) -> bool {
  var yes = t.size == name.size
  have = t.bytes
  want = name.bytes
  loop i in 0..have.size {
    if i >= want.size {
      yes = false
      break
    }
    if lowered(have[i]) != want[i] {
      yes = false
      break
    }
  }
  yes
}

// Whether a header of this name may be given, which is so for any but the
// three that the library writes.
pub fn not_written_by_the_library(t: str) -> bool {
  not is_named(t, "content-length") and not is_named(t, "connection") and not is_named(t, "transfer-encoding")
}

// Whether a text holds no line break, so that a header made of it cannot add
// a line of its own.
pub fn one_line(s: str) -> bool {
  var yes = true
  loop b in s {
    if b == 13 or b == 10 {
      yes = false
      break
    }
  }
  yes
}

// The text with its letters in small letters.
fn small(t: str) -> str <alloc> {
  var bytes: List[Byte] = []
  loop i in 0..t.size {
    bytes = push(bytes, lowered(t[i]))
  }
  match utf8(freeze(bytes)) {
    .ok(made) { made }
    .err(e) { "" }
  }
}

// The name of a header, written out. A name that is no token, or that the
// library writes, is refused where the call is written, whatever the case of its
// letters, and the name is kept in small letters.
pub fn header_name(t: str) -> HeaderName <alloc>
  requires a_token(t)
  requires not_written_by_the_library(t)
{
  HeaderName(token: small(t))
}

// The name of a header that is known only when the program runs, or the reason
// it is not one.
pub fn check_name(t: str) -> Result[HeaderName, HeaderError] <alloc> {
  if not a_token(t) {
    .err(.not_a_token(t))
  } else if not not_written_by_the_library(t) {
    .err(.written_by_the_library(t))
  } else {
    .ok(HeaderName(token: small(t)))
  }
}

// The value of a header, written out. A value with a line break is refused where
// the call is written.
pub fn header_value(t: str) -> HeaderValue
  requires one_line(t)
{
  HeaderValue(text: t)
}

// The value of a header that is known only when the program runs, or the reason
// it is not one.
pub fn check_value(t: str) -> Result[HeaderValue, HeaderError] {
  if one_line(t) { .ok(HeaderValue(text: t)) } else { .err(.line_break(t)) }
}

pub struct Part {
  pub name: str
  pub value: str
}

pub trait Status[E] {
  fn status(e: E) -> 100..600
}

pub struct NotFound {
  pub message: str
}

pub struct BadRequest {
  pub message: str
}

pub struct Unauthorized {
  pub message: str
}

impl Status[NotFound] {
  fn status(e: NotFound) -> 100..600 { 404 }
}

impl Status[BadRequest] {
  fn status(e: BadRequest) -> 100..600 { 400 }
}

impl Status[Unauthorized] {
  fn status(e: Unauthorized) -> 100..600 { 401 }
}

// The bytes of `s` from `a` up to `b` as a text, which is the empty text where
// they are no text.
fn piece(s: str, a: Nat, b: Nat) -> str {
  if a <= b and b <= s.size {
    match utf8(s.bytes[a..b]) {
      .ok(t) { t }
      .err(e) { "" }
    }
  } else {
    ""
  }
}

// The parts of a path between its `/`s, after the first: `/users/7` is `users`
// and `7`, and `/` has none.
pub fn segments(path: str) -> List[str] <alloc> {
  var parts: List[str] = []
  if path.size > 1 and path[0] == '/' {
    var from: Nat = 1
    loop i in 1..path.size {
      if path[i] == '/' {
        parts = push(parts, piece(path, from, i))
        from = saturating_add(i, 1)
      }
    }
    parts = push(parts, piece(path, from, path.size))
  }
  parts
}

// What each part of a path that begins with `:` in the pattern is, by its
// name, when the path is the pattern: the same number of parts, and each part
// that does not begin with `:` the same.
pub fn route_match(pattern: str, path: str) -> Option[List[Part]] <alloc> {
  ps = segments(pattern)
  qs = segments(path)
  var found: List[Part] = []
  var fits = ps.size == qs.size
  if fits {
    loop i in 0..ps.size {
      if i < qs.size {
        p = ps[i]
        q = qs[i]
        if p.size > 1 and p[0] == ':' {
          found = push(found, Part(name: piece(p, 1, p.size), value: q))
        } else if p != q {
          fits = false
        }
      }
    }
  }
  if fits { Option.some(found) } else { Option.none }
}

// The member of a query that is the bytes from `from` up to `end`: the name
// before the first `=`, and the value after it, which is empty where there is
// no `=`. Nothing where the piece is empty.
fn member(query: str, from: Nat, end: Nat) -> Option[Part] {
  if from < end and end <= query.size {
    var equals: Nat = end
    loop j in from..end {
      if equals == end and query[j] == '=' {
        equals = j
      }
    }
    if equals < end {
      Option.some(Part(name: piece(query, from, equals), value: piece(query, saturating_add(equals, 1), end)))
    } else {
      Option.some(Part(name: piece(query, from, end), value: ""))
    }
  } else {
    Option.none
  }
}

// The members of a query, `a=1&b=2`, which are the pieces between `&`s.
pub fn query_parts(query: str) -> List[Part] <alloc> {
  var parts: List[Part] = []
  var from: Nat = 0
  loop i in 0..query.size {
    if query[i] == '&' {
      match member(query, from, i) {
        .some(m) { parts = push(parts, m) }
        .none { }
      }
      from = saturating_add(i, 1)
    }
  }
  match member(query, from, query.size) {
    .some(m) { parts = push(parts, m) }
    .none { }
  }
  parts
}

// A parameter of a function that a route calls, by its name, and whether it
// is read from the body: a struct, an enum, a list, or a tuple is, and so is
// an `Option` of one, and every other is read from a part of the path or the
// query.
pub struct Param {
  pub name: str
  pub body: bool
}

// What a type that is told of the fields of a struct says of each: the
// parameters of the function, in order. `depth` is how many shapes are open,
// and `asked` is whether the last field named at depth 1 has not yet been
// told what it holds.
pub struct Params {
  params: List[Param]
  depth: Nat
  asked: bool
  named: str
}

pub fn no_params() -> Params {
  Params(params: [], depth: 0, asked: false, named: "")
}

pub fn params_of(p: take Params) -> List[Param] { p.params }

fn kind(d: take Params, body: bool) -> Params <alloc> {
  var w = d
  if w.depth == 1 and w.asked {
    w.params = push(w.params, Param(name: w.named, body: body))
    w.asked = false
  }
  w
}

fn opened(d: take Params) -> Params <alloc> {
  var w = kind(d, true)
  w.depth = saturating_add(w.depth, 1)
  w
}

fn closed(d: take Params) -> Params {
  var w = d
  w.depth = saturating_sub(w.depth, 1)
  w
}

impl Describer[Params] {
  fn boolean(d: take Params) -> Params <alloc> { kind(d, false) }
  fn signed(d: take Params, least: Int, greatest: Int) -> Params <alloc> { kind(d, false) }
  fn unsigned(d: take Params, least: u64, greatest: u64) -> Params <alloc> { kind(d, false) }
  fn text(d: take Params) -> Params <alloc> { kind(d, false) }
  fn nothing(d: take Params) -> Params <alloc> { kind(d, false) }
  fn optional(d: take Params) -> Params <alloc> { d }
  fn end_optional(d: take Params) -> Params <alloc> { d }
  fn sequence(d: take Params) -> Params <alloc> { opened(d) }
  fn end_sequence(d: take Params) -> Params <alloc> { closed(d) }
  fn tuple(d: take Params, size: Nat) -> Params <alloc> { opened(d) }
  fn end_tuple(d: take Params) -> Params <alloc> { closed(d) }
  fn structure(d: take Params, name: str, about: str, fields: Nat) -> Params <alloc> { opened(d) }
  fn field(d: take Params, name: str, about: str, optional: bool) -> Params <alloc> {
    var w = d
    if w.depth == 1 {
      w.asked = true
      w.named = name
    }
    w
  }
  fn end_structure(d: take Params) -> Params <alloc> { closed(d) }
  fn enumeration(d: take Params, name: str, about: str, cases: Nat) -> Params <alloc> { opened(d) }
  fn case(d: take Params, name: str, about: str, holds: bool) -> Params <alloc> { d }
  fn end_case(d: take Params) -> Params <alloc> { d }
  fn end_enumeration(d: take Params) -> Params <alloc> { closed(d) }
  fn map(d: take Params) -> Params <alloc> { kind(d, true) }
}

// The text of the part with the name, which is the empty text where there is
// none.
fn find(parts: List[Part], name: str) -> Option[str] {
  var found: Option[str] = Option.none
  loop i in 0..parts.size {
    p = parts[i]
    if p.name == name {
      match found {
        .some(t) { }
        .none { found = Option.some(p.value) }
      }
    }
  }
  found
}

fn has(t: Option[str]) -> bool {
  match t {
    .some(v) { true }
    .none { false }
  }
}

fn text_or_empty(t: Option[str]) -> str {
  match t {
    .some(v) { v }
    .none { "" }
  }
}

// What a function that a route calls is read from: the parts of the path
// that its pattern names, the members of the query, and the body, which is
// read as JSON by the reader of `std.json`.
//
// Each parameter in order is offered as a field of a struct, when the
// request has it: a parameter of the path or the query is read as the text of
// a part, and a parameter of the body as what the body holds. A parameter the
// request has no part for is not offered, so the type that reads it gives
// `.none` for an `Option`, the default of a parameter that has one, and
// otherwise says it is missing.
pub struct Reading {
  params: List[Param]
  at: Nat
  name: str
  body: bool
  depth: Nat
  top: bool
  path: List[Part]
  query: List[Part]
  has_body: bool
  json: In
}

pub fn reading(params: take List[Param], path: take List[Part], query: take List[Part], body: str) -> Reading {
  Reading(params: params, at: 0, name: "", body: false, depth: 0, top: false, path: path, query: query, has_body: body.size > 0, json: json_in(body))
}

fn current(r: Reading) -> str {
  match find(r.path, r.name) {
    .some(t) { t }
    .none { text_or_empty(find(r.query, r.name)) }
  }
}

// The next parameter, from `at`, that the request has a part for, which
// is a field the reader offers, or `.none` when there is no other.
fn next_param(r: take Reading) -> (Reading, Option[str]) {
  var w = r
  var found = false
  loop i in 0..w.params.size {
    if not found and i >= w.at and i < w.params.size {
      p = w.params[i]
      here = if p.body {
        w.has_body
      } else {
        has(find(w.path, p.name)) or has(find(w.query, p.name))
      }
      if here {
        found = true
        w.at = saturating_add(i, 1)
        w.name = p.name
        w.body = p.body
      }
    }
  }
  if found {
    name = w.name
    (w, Option.some(name))
  } else {
    w.at = w.params.size
    (w, Option.none)
  }
}

fn is_missing(p: Problem) -> bool {
  match p {
    .missing(m) { true }
    .malformed { false }
    .shape(s) { false }
    .range(n) { false }
    .case(c) { false }
    .unknown(u) { false }
    .twice(t) { false }
    .proof(w) { false }
  }
}

fn deeper(r: take Reading) -> Reading {
  var w = r
  w.depth = saturating_add(w.depth, 1)
  w
}

fn shallower(r: take Reading) -> Reading {
  var w = r
  w.depth = saturating_sub(w.depth, 1)
  w
}

impl Reader[Reading] {
  fn boolean(r: take Reading) -> (Reading, Result[bool, ReadError]) <alloc> {
    if r.body {
      var w = r
      (j, got) = Reader.boolean(w.json)
      w.json = j
      (w, got)
    } else {
      got: Result[bool, ReadError] = from_text(r.name, current(r))
      (r, got)
    }
  }
  fn signed(r: take Reading) -> (Reading, Result[Int, ReadError]) <alloc> {
    if r.body {
      var w = r
      (j, got) = Reader.signed(w.json)
      w.json = j
      (w, got)
    } else {
      got: Result[Int, ReadError] = from_text(r.name, current(r))
      (r, got)
    }
  }
  fn unsigned(r: take Reading) -> (Reading, Result[u64, ReadError]) <alloc> {
    if r.body {
      var w = r
      (j, got) = Reader.unsigned(w.json)
      w.json = j
      (w, got)
    } else {
      got: Result[u64, ReadError] = from_text(r.name, current(r))
      (r, got)
    }
  }
  fn text(r: take Reading) -> (Reading, Result[str, ReadError]) <alloc> {
    if r.body {
      var w = r
      (j, got) = Reader.text(w.json)
      w.json = j
      (w, got)
    } else {
      t = current(r)
      (r, Result.ok(t))
    }
  }
  fn nothing(r: take Reading) -> (Reading, Result[(), ReadError]) <alloc> {
    if r.body {
      var w = r
      (j, got) = Reader.nothing(w.json)
      w.json = j
      (w, got)
    } else {
      (r, Result.ok(()))
    }
  }
  fn present(r: take Reading) -> (Reading, Result[bool, ReadError]) <alloc> {
    if r.body {
      var w = r
      (j, got) = Reader.present(w.json)
      w.json = j
      (w, got)
    } else {
      (r, Result.ok(true))
    }
  }
  fn sequence(r: take Reading) -> (Reading, Result[(), ReadError]) <alloc> {
    var w = deeper(r)
    (j, got) = Reader.sequence(w.json)
    w.json = j
    (w, got)
  }
  fn more(r: take Reading) -> (Reading, Result[bool, ReadError]) <alloc> {
    var w = r
    (j, got) = Reader.more(w.json)
    w.json = j
    match got {
      .ok(again) {
        if again { (w, got) } else { (shallower(w), got) }
      }
      .err(e) { (w, got) }
    }
  }
  fn tuple(r: take Reading, size: Nat) -> (Reading, Result[(), ReadError]) <alloc> {
    var w = deeper(r)
    (j, got) = Reader.tuple(w.json, size)
    w.json = j
    (w, got)
  }
  fn end_tuple(r: take Reading) -> (Reading, Result[(), ReadError]) <alloc> {
    var w = shallower(r)
    (j, got) = Reader.end_tuple(w.json)
    w.json = j
    (w, got)
  }
  fn structure(r: take Reading, name: str) -> (Reading, Result[(), ReadError]) <alloc> {
    if r.top {
      var w = deeper(r)
      (j, got) = Reader.structure(w.json, name)
      w.json = j
      (w, got)
    } else {
      var w = r
      w.top = true
      (w, Result.ok(()))
    }
  }
  fn field(r: take Reading) -> (Reading, Result[Option[str], ReadError]) <alloc> {
    if r.depth > 0 {
      var w = r
      (j, got) = Reader.field(w.json)
      w.json = j
      match got {
        .ok(named) {
          match named {
            .some(n) { (w, got) }
            .none { (shallower(w), got) }
          }
        }
        .err(e) { (w, got) }
      }
    } else {
      (w, named) = next_param(r)
      (w, Result.ok(named))
    }
  }
  fn unknown(r: take Reading, name: str) -> (Reading, Result[(), ReadError]) <alloc> {
    var w = r
    (j, got) = Reader.unknown(w.json, name)
    w.json = j
    (w, got)
  }
  fn case(r: take Reading, of: str) -> (Reading, Result[str, ReadError]) <alloc> {
    var w = deeper(r)
    (j, got) = Reader.case(w.json, of)
    w.json = j
    (w, got)
  }
  fn end_case(r: take Reading) -> (Reading, Result[(), ReadError]) <alloc> {
    var w = shallower(r)
    (j, got) = Reader.end_case(w.json)
    w.json = j
    (w, got)
  }
  fn raw(r: take Reading, of: str) -> (Reading, Result[Slice[Byte], ReadError]) <alloc> {
    var w = r
    (j, got) = Reader.raw(w.json, of)
    w.json = j
    (w, got)
  }
  fn fail(r: take Reading, problem: Problem) -> (Reading, ReadError) <alloc> {
    if r.depth > 0 or r.body {
      var w = r
      (j, e) = Reader.fail(w.json, problem)
      w.json = j
      (w, e)
    } else {
      name = if is_missing(problem) { "" } else { r.name }
      (r, ReadError(path: name, problem: problem, line: 0, column: 0))
    }
  }
}

// Whether one of the parameters is read from the body.
fn takes_body(r: Reading) -> bool {
  var found = false
  loop i in 0..r.params.size {
    if r.params[i].body {
      found = true
    }
  }
  found
}

// The value of a type that a function takes as its parameters, read from the
// request, or what is wrong with it. A body that is not all read is wrong.
pub trait FromRequest[A] {
  fn from_request(r: take Reading) -> Result[A, ReadError] <alloc>
}

impl[A] FromRequest[A]
  requires Deserialize[A]
  requires Discard[A]
{
  fn from_request(r: take Reading) -> Result[A, ReadError] <alloc> {
    (w, got): (Reading, Result[A, ReadError]) = Deserialize.read(r)
    match got {
      .err(e) { Result.err(e) }
      .ok(v) {
        if w.has_body and takes_body(w) {
          match json_ended(w.json) {
            .ok(done) { Result.ok(v) }
            .err(e) { Result.err(e) }
          }
        } else {
          Result.ok(v)
        }
      }
    }
  }
}

// A text that a function gives to be answered as it is.
pub struct Text {
  pub text: str
}

// A place that a function gives to send the caller to.
pub struct Redirect {
  pub to: str
}

// What a function gives says what the response is.
pub trait Respond[T] {
  fn respond(value: T) -> Response <alloc>
}

fn answer(status: 100..600, kind: HeaderValue, body: str) -> Response <alloc> {
  Response(status: status, headers: [(header_name("content-type"), kind)], body: body)
}

impl[T] Respond[T]
  requires Serialize[T]
{
  fn respond(value: T) -> Response <alloc> {
    answer(200, header_value("application/json"), to_json(value))
  }
}

impl Respond[Html] {
  fn respond(value: Html) -> Response <alloc> {
    answer(200, header_value("text/html; charset=utf-8"), "{value}")
  }
}

impl Respond[Text] {
  fn respond(value: Text) -> Response <alloc> {
    answer(200, header_value("text/plain; charset=utf-8"), value.text)
  }
}

impl Respond[Redirect] {
  fn respond(value: Redirect) -> Response <alloc> {
    match check_value(value.to) {
      .ok(place) { Response(status: 302, headers: [(header_name("location"), place)], body: "") }
      .err(e) { Response(status: 500, headers: [], body: "") }
    }
  }
}

impl Respond[()] {
  fn respond(value: ()) -> Response <alloc> {
    Response(status: 204, headers: [], body: "")
  }
}

impl[T, E] Respond[Result[T, E]]
  requires Respond[T]
  requires Status[E]
  requires Serialize[E]
{
  fn respond(value: Result[T, E]) -> Response <alloc> {
    match value {
      .ok(v) { Respond[T].respond(v) }
      .err(e) { answer(Status[E].status(e), header_value("application/json"), to_json(e)) }
    }
  }
}

// What a server of HTTP asks for each request, and answers it with.
pub effect http {
  pub fn request() -> Request
  pub fn send(response: Response)
}

// What `get` and the other methods ask of the routes they are written in:
// whether the request fits a method and a path, with the parts of the path
// that the pattern names when it does and no route has answered it yet, the
// request itself, and to note the response of the route that answers it.
pub effect routing {
  fn fits(method: Method, path: str) -> Option[List[Part]]
  fn asked_of() -> Request
  fn answered(response: Response)
}

// Why a request does not fit the parameters of a function, as it is answered.
struct Rejected {
  path: str
  problem: Problem
}

// The function reads its parameters from the request and answers with what it
// gives, or answers 400 with what is wrong, and does not run.
fn add[F, A, R](method: Method, path: str, f: F) <routing, alloc>
  requires Function[F, A, R]
  requires FromRequest[A]
  requires Describe[A]
  requires Respond[R]
  requires Discard[R]
{
  match fits(method, path) {
    .some(parts) {
      asked = asked_of()
      params = Describe[A].describe(no_params())
      r = reading(params_of(params), parts, query_parts(asked.query), asked.body)
      got: Result[A, ReadError] = FromRequest[A].from_request(r)
      match got {
        .ok(args) { answered(Respond[R].respond(Function.call(f, args))) }
        .err(e) { answered(answer(400, header_value("application/json"), to_json(Rejected(path: e.path, problem: e.problem)))) }
      }
    }
    .none { }
  }
}

// `f` answers `GET` of the path, with its parameters read from the request.
pub fn get[F, A, R](path: str, f: F) <routing, alloc>
  requires Function[F, A, R]
  requires FromRequest[A]
  requires Describe[A]
  requires Respond[R]
  requires Discard[R]
{
  add(.get, path, f)
}

pub fn post[F, A, R](path: str, f: F) <routing, alloc>
  requires Function[F, A, R]
  requires FromRequest[A]
  requires Describe[A]
  requires Respond[R]
  requires Discard[R]
{
  add(.post, path, f)
}

pub fn put[F, A, R](path: str, f: F) <routing, alloc>
  requires Function[F, A, R]
  requires FromRequest[A]
  requires Describe[A]
  requires Respond[R]
  requires Discard[R]
{
  add(.put, path, f)
}

pub fn patch[F, A, R](path: str, f: F) <routing, alloc>
  requires Function[F, A, R]
  requires FromRequest[A]
  requires Describe[A]
  requires Respond[R]
  requires Discard[R]
{
  add(.patch, path, f)
}

pub fn delete[F, A, R](path: str, f: F) <routing, alloc>
  requires Function[F, A, R]
  requires FromRequest[A]
  requires Describe[A]
  requires Respond[R]
  requires Discard[R]
{
  add(.delete, path, f)
}

// A server whose routes are what `body` writes: the request is asked of
// `http`, the first route that fits its method and its path answers it, a
// request that fits none is answered 404, and the response is given to `http`.
pub fn routes[T](body: fn() -> T <routing>) -> T <http, alloc> {
  asked = request()
  var done = false
  var response = Response(status: 404, headers: [], body: "")
  result = routing(
    fits: fn(method, path) {
      if done or method != asked.method {
        Option.none
      } else {
        route_match(path, asked.path)
      }
    },
    asked_of: { copy_of(asked) },
    answered: fn(r) {
      response = r
      done = true
    },
    body: body,
  )
  send(response)
  result
}

// The request again, with its own list of headers.
fn copy_of(r: Request) -> Request <alloc> {
  var headers: List[(str, str)] = []
  loop i in 0..r.headers.size {
    headers = push(headers, r.headers[i])
  }
  Request(method: r.method, path: r.path, query: r.query, headers: headers, body: r.body)
}

// What `listen` reads of a connection, at most, in one call of `read`.
fn most_read() -> 1..65537 { 65536 }

// The most bytes of a body that `listen` reads, which a request with more is
// refused for.
fn most_body() -> Nat { 1048576 }

// Why a request is not served: the connection ended or failed, which is
// closed with nothing said, or what was read is refused, which is answered
// 400 before the connection is closed.
enum Fault {
  ended
  refused
}

// The bytes read so far with what the connection has sent since.
fn fill(c: Connection, held: Slice[Byte]) -> Result[Slice[Byte], Fault] <net, alloc> {
  match read(c, most_read()) {
    .ok(.bytes(bytes)) { Result.ok(freeze(append(copy(held), bytes))) }
    .ok(.ended) { Result.err(Fault.ended) }
    .err(e) { Result.err(Fault.ended) }
  }
}

// What follows the first `used` bytes.
fn after(bytes: Slice[Byte], used: Nat) -> Slice[Byte] {
  if used <= bytes.size { bytes[used..bytes.size] } else { [] }
}

// The head of the next request, and the bytes that follow it. A head is at
// most 16384 bytes, and each round of the loop has one more byte of it.
fn read_head(c: Connection, held: Slice[Byte]) -> Result[(RequestHead, Slice[Byte]), Fault] <net, alloc> {
  var bytes = held
  loop round in 0..16400 {
    if bytes.size > 0 {
      match request_head(bytes) {
        .complete((head, used)) { return Result.ok((head, after(bytes, used))) }
        .incomplete { }
        .refused(why) { return Result.err(Fault.refused) }
      }
    }
    match fill(c, bytes) {
      .ok(more) { bytes = more }
      .err(fault) { return Result.err(fault) }
    }
  }
  Result.err(Fault.refused)
}

// The bytes of a body that the head says has `size` of them, and the bytes
// that follow it.
fn read_sized(c: Connection, held: Slice[Byte], size: Nat) -> Result[(Slice[Byte], Slice[Byte]), Fault] <net, alloc> {
  if size > most_body() { return Result.err(Fault.refused) }
  var bytes = held
  loop round in 0..most_body() {
    if bytes.size >= size {
      if size <= bytes.size {
        return Result.ok((bytes[0..size], after(bytes, size)))
      }
    }
    match fill(c, bytes) {
      .ok(more) { bytes = more }
      .err(fault) { return Result.err(fault) }
    }
  }
  Result.err(Fault.refused)
}

// The bytes of a body in chunks, whole, and the bytes that follow it.
fn read_chunks(c: Connection, held: Slice[Byte]) -> Result[(Slice[Byte], Slice[Byte]), Fault] <net, alloc> {
  var bytes = held
  var body: List[Byte] = []
  loop round in 0..2097154 {
    if bytes.size > 0 {
      match chunk(bytes) {
        .complete((piece, used)) {
          if piece.size == 0 {
            return Result.ok((freeze(body), after(bytes, used)))
          }
          if body.size + piece.size > most_body() { return Result.err(Fault.refused) }
          body = append(body, piece)
          bytes = after(bytes, used)
        }
        .incomplete {
          match fill(c, bytes) {
            .ok(more) { bytes = more }
            .err(fault) { return Result.err(fault) }
          }
        }
        .refused(why) { return Result.err(Fault.refused) }
      }
    } else {
      match fill(c, bytes) {
        .ok(more) { bytes = more }
        .err(fault) { return Result.err(fault) }
      }
    }
  }
  Result.err(Fault.refused)
}

fn read_body(c: Connection, head: RequestHead, held: Slice[Byte]) -> Result[(Slice[Byte], Slice[Byte]), Fault] <net, alloc> {
  match body_of(head.headers) {
    .ok(framing) {
      match framing {
        .none { Result.ok(([], held)) }
        .length(size) { read_sized(c, held, size) }
        .chunked { read_chunks(c, held) }
      }
    }
    .err(why) { Result.err(Fault.refused) }
  }
}

// The value of the header that has the name, which is in small letters, as
// `request_head` gives it.
fn header_of(headers: List[(str, str)], name: str) -> Option[str] {
  var found: Option[str] = Option.none
  loop i in 0..headers.size {
    (n, v) = headers[i]
    if n == name {
      match found {
        .some(t) { }
        .none { found = Option.some(v) }
      }
    }
  }
  found
}

// Whether the value of a header that is a list of tokens, as `connection` is,
// has the token, whatever the case of its letters. A token is read a byte at
// a time: how many of its bytes the one being read has matched, and whether
// it has matched them all so far.
fn has_token(value: str, token: str) -> bool {
  var found = false
  var matched: Nat = 0
  var fits = true
  loop i in 0..value.size {
    b = value[i]
    if b == ',' {
      if fits and matched == token.size { found = true }
      matched = 0
      fits = true
    } else if b != ' ' {
      if matched < token.size {
        if lowered(b) != token[matched] { fits = false }
        matched = saturating_add(matched, 1)
      } else {
        fits = false
      }
    }
  }
  if fits and matched == token.size { found = true }
  found
}

// Whether the connection is kept for another request once this one is
// answered: `HTTP/1.1` keeps it unless the request says `close`, and
// `HTTP/1.0` closes it unless the request says `keep-alive`.
fn keeps(head: RequestHead) -> bool {
  said = match header_of(head.headers, "connection") {
    .some(v) { v }
    .none { "" }
  }
  match head.version {
    .http11 { not has_token(said, "close") }
    .http10 { has_token(said, "keep-alive") }
  }
}

fn target_path(target: str) -> str {
  var end = target.size
  loop i in 0..target.size {
    if end == target.size and target[i] == '?' { end = i }
  }
  piece(target, 0, end)
}

fn target_query(target: str) -> str {
  var at = target.size
  loop i in 0..target.size {
    if at == target.size and target[i] == '?' { at = i }
  }
  piece(target, saturating_add(at, 1), target.size)
}

// The method that a request line names, which is none for a method that HTTP
// gives and this library does not serve.
fn method_of(name: str) -> Option[Method] {
  if name == "GET" {
    .some(.get)
  } else if name == "POST" {
    .some(.post)
  } else if name == "PUT" {
    .some(.put)
  } else if name == "DELETE" {
    .some(.delete)
  } else if name == "PATCH" {
    .some(.patch)
  } else if name == "HEAD" {
    .some(.head)
  } else {
    .none
  }
}

// The request a head and a body make.
fn request_of(method: Method, head: take RequestHead, body: str) -> Request {
  Request(method: method, path: target_path(head.target), query: target_query(head.target), headers: head.headers, body: body)
}

// What the routes answer for the request, which is nothing but 500 for a
// block that gives no response.
fn answer_with[T](request: Request, body: fn() -> T <http>) -> Response <alloc>
  requires Discard[T]
{
  var response = Response(status: 500, headers: [], body: "")
  _ = http(
    request: { copy_of(request) },
    send: fn(r) { response = r },
    body: body,
  )
  copy_response(response)
}

// The response again, with its own list of headers.
fn copy_response(r: Response) -> Response <alloc> {
  var headers: List[(HeaderName, HeaderValue)] = []
  loop i in 0..r.headers.size {
    headers = push(headers, r.headers[i])
  }
  Response(status: r.status, headers: headers, body: r.body)
}

fn reason(status: 100..600) -> str {
  if status == 200 {
    "OK"
  } else if status == 201 {
    "Created"
  } else if status == 204 {
    "No Content"
  } else if status == 302 {
    "Found"
  } else if status == 400 {
    "Bad Request"
  } else if status == 401 {
    "Unauthorized"
  } else if status == 403 {
    "Forbidden"
  } else if status == 404 {
    "Not Found"
  } else if status == 405 {
    "Method Not Allowed"
  } else if status == 409 {
    "Conflict"
  } else if status == 500 {
    "Internal Server Error"
  } else {
    "Status"
  }
}

// The line break that ends a line of a head.
fn ended(line: take List[Byte]) -> List[Byte] <alloc> {
  push(push(line, 13), 10)
}

// The bytes of a response: its status line, its headers, then the length, which
// is the only one on the wire as no header can be one, and the body.
fn response_bytes(r: Response, keep: bool) -> List[Byte] <alloc> {
  var made: List[Byte] = []
  made = ended(append(made, "HTTP/1.1 {r.status} {reason(r.status)}".bytes))
  loop i in 0..r.headers.size {
    (n, v) = r.headers[i]
    made = ended(append(made, "{n}: {v}".bytes))
  }
  made = ended(append(made, "content-length: {r.body.size}".bytes))
  if not keep { made = ended(append(made, "connection: close".bytes)) }
  made = ended(made)
  append(made, r.body.bytes)
}

// What is answered to a request that is refused.
fn refusal() -> Response {
  Response(status: 400, headers: [], body: "")
}

// What is answered to a request whose method is none that is served.
fn not_implemented() -> Response {
  Response(status: 501, headers: [], body: "")
}

// Sends the bytes, and whether they all went.
fn sent(c: Connection, bytes: take List[Byte]) -> bool <net> {
  match write(c, freeze(bytes)) {
    .ok(done) { true }
    .err(e) { false }
  }
}

// Reads one request of the connection and answers it, and gives whether the
// connection is kept. A client that sent the next request before it had the
// response to this one has it answered by a response that says the connection
// is closed, and the connection is closed, as the client of RFC 9112 is ready
// for. So nothing read is carried from one request to the next, and the
// memory of a request is released with it.
fn serve_one[T](c: Connection, body: fn() -> T <http>) -> bool <net, alloc>
  requires Discard[T]
{
  match read_head(c, []) {
    .err(fault) {
      match fault {
        .ended { }
        .refused { _ = sent(c, response_bytes(refusal(), false)) }
      }
      return false
    }
    .ok((head, after_head)) {
      match read_body(c, head, after_head) {
        .err(fault) {
          match fault {
            .ended { }
            .refused { _ = sent(c, response_bytes(refusal(), false)) }
          }
          return false
        }
        .ok((payload, after_body)) {
          match utf8(payload) {
            .err(e) {
              _ = sent(c, response_bytes(refusal(), false))
              return false
            }
            .ok(text) {
              match method_of(head.method) {
                .none {
                  _ = sent(c, response_bytes(not_implemented(), false))
                  return false
                }
                .some(method) {
                  keep = keeps(head) and after_body.size == 0
                  response = answer_with(request_of(method, head, text), body)
                  written = sent(c, response_bytes(response, keep))
                  return keep and written
                }
              }
            }
          }
        }
      }
    }
  }
}

// Serves the requests of a connection, one after another, until it is ended.
fn serve_connection[T](c: Connection, body: fn() -> T <http>) <net, alloc, diverge>
  requires Discard[T]
{
  loop {
    if not serve_round(c, body) { break }
  }
}

// One request of a connection, with the memory it builds freed whole when it is
// answered, whether or not it waited for the connection to say more.
fn serve_round[T](c: Connection, body: fn() -> T <http>) -> bool <net, alloc>
  requires Discard[T]
{
  with arena()
  serve_one(c, body)
}

// Ends the program with a failing status, after saying why on standard error.
fn cannot(why: str) {
  __eprint(why)
  __end(1)
}

fn why(e: NetError) -> str <alloc> {
  "listen: {e}"
}

// A listener on the port, on every address of this machine.
fn open(port: 1..65536) -> Result[Listener, NetError] <net> {
  match listen_on("::", .at(port)) {
    .ok(l) { Result.ok(l) }
    .err(e) { listen_on("0.0.0.0", .at(port)) }
  }
}

// Whether the error says that the listener is closed, which ends the serving.
fn is_closed(e: NetError) -> bool {
  match e {
    .closed(address) { true }
    .unknown_host(address) { false }
    .refused(address) { false }
    .in_use(address) { false }
    .failed(said) { false }
  }
}

// Serves each connection in a task of its own, so that a connection that says
// nothing holds up no other: the tasks wait in the scheduler, which holds no
// thread for a task that waits, in `epoll` on Linux and in `kqueue` on macOS.
// On Windows every call waits where it is, as the number 12 of `__system` says
// by being 2, and a task that waits there would hold up the one that accepts, so
// the connections are served one at a time.
fn serve_listener[T](l: Listener, body: fn() -> T <http>) <net, alloc, diverge>
  requires Discard[T]
{
  if __system(12) == 2 { serve_one_at_a_time(l, body) } else { serve_in_tasks(l, body) }
}

fn serve_in_tasks[T](l: Listener, body: fn() -> T <http>) <net, alloc, diverge>
  requires Discard[T]
{
  with tasks()
  loop {
    match accept(l) {
      .ok(c) {
        _ = spawn {
          serve_connection(c, body)
          close(c)
        }
      }
      .err(e) {
        if is_closed(e) {
          // The listener is closed: the connections taken are served, and then
          // `listen` returns.
          quiet()
          break
        }
      }
    }
  }
}

fn serve_one_at_a_time[T](l: Listener, body: fn() -> T <http>) <net, alloc, diverge>
  requires Discard[T]
{
  loop {
    match accept(l) {
      .ok(c) {
        serve_connection(c, body)
        close(c)
      }
      .err(e) {
        if is_closed(e) { break }
      }
    }
  }
}

// What the routes answer when nothing asks them, which `listen` never needs:
// it ends only with the program.
fn unasked[T](body: fn() -> T <http>) -> T {
  http(
    request: { Request(method: .get, path: "/", query: "", headers: [], body: "") },
    send: fn(r) { },
    body: body,
  )
}

// The handler of a native executable: it answers `http` for the block by
// listening on the port, each connection in a task of its own where tasks wait
// for the system, and one request after another on each. It ends only with the program: a port that cannot be
// listened on ends the program with a failing status, and the error on
// standard error.
pub fn listen[T](body: fn() -> T <http>; port: 1..65536) -> T <net, alloc, diverge>
  requires Discard[T]
{
  match open(port) {
    .ok(l) {
      serve_listener(l, body)
      stop(l)
    }
    .err(e) { cannot(why(e)) }
  }
  unasked(body)
}

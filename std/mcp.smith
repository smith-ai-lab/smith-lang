use std.base64
use std.console (console, input, print)
use std.describe (Describe)
use std.deserialize (Deserialize, ReadError, Reader, fail)
use std.json (Json, RawJson, describe, from_json, json_string, raw_text, to_json)
use std.jsonschema (json_schema, schema_text)
use std.jsonrpc
use std.list (freeze, push)
use std.serialize (Serialize, Writer)
use std.text as texts
use std.utf8 (utf8)

// A message of a client, and what carried it knows of it: the headers of the
// request it came in, each name in small letters, and none for a message that
// came by the standard input.
pub struct Incoming {
  pub text: str
  pub headers: List[(str, str)]
}

// What `mcp` says of a message: the text of one message, or none for a message
// that needs no answer, and the status that whoever carries messages over HTTP
// sends.
pub struct Reply {
  pub text: Option[str]
  pub status: 100..600
}

pub effect messages {
  fn message() -> Incoming
  fn answer(reply: Reply)
}

// What a server says of itself, and what it holds a message to.
pub struct Server {
  pub name: str
  pub version: str
  pub instructions: Option[str] = .none
  pub ttl: Nat = 0
  pub origins: List[str] = []
}

// The one version of the protocol that the server speaks.
fn spoken() -> str { "2026-07-28" }

// The members of an object, each with the text of its value, in the order they
// came. A member given twice is an error of the reader.
struct Members {
  named: List[(str, RawJson)]
}

fn has(named: List[(str, RawJson)], name: str) -> bool {
  loop pair in named {
    match pair {
      (n, v) { if n == name { return true } }
    }
  }
  false
}

impl Deserialize[Members] {
  fn read[R: Reader](from: take R) -> (R, Result[Members, ReadError]) <alloc> {
    (opened, began) = Reader.structure(take from, "Members")
    match began {
      .err(e) { return (opened, Result.err(e)) }
      .ok(u) { }
    }
    mut r = opened
    mut named: List[(str, RawJson)] = []
    loop round in 0..4294967296 {
      (after, got) = Reader.field(take r)
      r = after
      match got {
        .err(e) { return (r, Result.err(e)) }
        .ok(next) {
          match next {
            .none { break }
            .some(name) {
              if has(named, name) {
                (w, e) = fail(take r, .twice(name))
                return (w, Result.err(e))
              }
              (w, value): (R, Result[RawJson, ReadError]) = Deserialize.read(take r)
              r = w
              match value {
                .err(e) { return (r, Result.err(e)) }
                .ok(v) { named = push(take named, (name, v)) }
              }
            }
          }
        }
      }
    }
    (r, Result.ok(Members(named: named)))
  }
}

fn find(named: List[(str, RawJson)], name: str) -> Option[RawJson] {
  loop pair in named {
    match pair {
      (n, v) { if n == name { return .some(v) } }
    }
  }
  .none
}

// The first byte of the text of a value, which says what kind of value it is.
fn kind(raw: RawJson) -> Byte {
  s = raw_text(raw)
  if s.size == 0 { 0 } else { s[0] }
}

// The text a member is, when it is one.
fn member_text(named: List[(str, RawJson)], name: str) -> Option[str] <alloc> {
  match find(named, name) {
    .none { .none }
    .some(raw) {
      got: Result[str, ReadError] = from_json(raw_text(raw))
      match got {
        .ok(t) { .some(t) }
        .err(e) { .none }
      }
    }
  }
}

fn header(headers: List[(str, str)], name: str) -> Option[str] {
  loop pair in headers {
    match pair {
      (n, v) { if n == name { return .some(v) } }
    }
  }
  .none
}

fn begins(s: str, prefix: str) -> bool {
  if s.size < prefix.size { return false }
  loop i in 0..prefix.size {
    if s.bytes[i] != prefix.bytes[i] { return false }
  }
  true
}

fn ends(s: str, suffix: str) -> bool {
  if s.size < suffix.size { return false }
  start = s.size - suffix.size
  loop i in 0..suffix.size {
    if s.bytes[start + i] != suffix.bytes[i] { return false }
  }
  true
}

// The text a header holds, which a client writes as `=?base64?` and the base64 of
// the UTF-8 of the text and `?=` when the text is not safe to write as it is.
// None for one that begins as that and is not base64 of a text.
fn header_text(value: str) -> Option[str] <alloc> {
  if begins(value, "=?base64?") and ends(value, "?=") {
    if value.size < 11 { return .none }
    match utf8(value.bytes[9..value.size - 2]) {
      .err(e) { .none }
      .ok(encoded) {
        match base64.decode(encoded) {
          .none { .none }
          .some(bytes) {
            match utf8(freeze(take bytes)) {
              .ok(t) { .some(t) }
              .err(e) { .none }
            }
          }
        }
      }
    }
  } else {
    .some(value)
  }
}

// The text of an error response. An id that could not be read is left out, as
// the protocol writes it, where JSON-RPC writes `null`.
fn failure_text(id: Option[str], code: Int, message: str, data: Option[str]) -> str <alloc> {
  a = texts.append(texts.text(), "\{\"jsonrpc\":\"2.0\"")
  b = match id {
    .some(i) { texts.append(texts.append(take a, ",\"id\":"), i) }
    .none { a }
  }
  c = texts.append(texts.append(take b, ",\"error\":\{\"code\":"), to_json(code))
  d = texts.append(texts.append(take c, ",\"message\":"), to_json(message))
  e = match data {
    .some(x) { texts.append(texts.append(take d, ",\"data\":"), x) }
    .none { d }
  }
  texts.finish(texts.append(take e, "\}\}"))
}

fn success_text(id: str, result: str) -> str <alloc> {
  a = texts.append(texts.text(), "\{\"jsonrpc\":\"2.0\",\"id\":")
  b = texts.append(texts.append(take a, id), ",\"result\":")
  texts.finish(texts.append(texts.append(take b, result), "\}"))
}

fn refusal(id: Option[str], code: Int, message: str, data: Option[str], status: 100..600) -> Reply <alloc> {
  Reply(text: .some(failure_text(id, code, message, data)), status: status)
}

struct Unsupported {
  supported: List[str]
  requested: str
}

// -32022, with the versions the server speaks, for a version it does not.
fn unsupported(id: str, requested: str) -> Reply <alloc> {
  data = to_json(Unsupported(supported: [spoken()], requested: requested))
  refusal(.some(id), -32022, "Unsupported protocol version", .some(data), 400)
}

struct ServerInfo {
  name: str
  version: str
}

// The `_meta` of a result: the name and version of the server, under the key
// that the protocol gives them, which is no name of a field.
struct ResultMeta {
  server_info: ServerInfo
}

impl Serialize[ResultMeta] {
  fn write[W: Writer](value: ResultMeta, to: take W) -> W <alloc> {
    mut w = Writer.structure(take to, "ResultMeta", 1)
    w = Writer.field(take w, "io.modelcontextprotocol/serverInfo")
    w = Serialize.write(value.server_info, take w)
    Writer.end_structure(take w)
  }
}

struct Capabilities {
  tools: bool
}

// What the lines of the server imply: an object with a member for each kind of
// offer, which is empty for a server that offers none.
impl Serialize[Capabilities] {
  fn write[W: Writer](value: Capabilities, to: take W) -> W <alloc> {
    mut count: Nat = 0
    if value.tools { count = 1 }
    mut w = Writer.structure(take to, "Capabilities", count)
    if value.tools {
      w = Writer.field(take w, "tools")
      w = Writer.structure(take w, "Tools", 0)
      w = Writer.end_structure(take w)
    }
    Writer.end_structure(take w)
  }
}

struct Discovered {
  supported_versions: List[str]
  capabilities: Capabilities
  instructions: Option[str]
  ttl: Nat
  meta: ResultMeta
}

// The result of `server/discover`, with the members written as the protocol
// names them, and `instructions` left out when there are none.
impl Serialize[Discovered] {
  fn write[W: Writer](value: Discovered, to: take W) -> W <alloc> {
    mut count: Nat = 5
    match value.instructions {
      .some(s) { count = 6 }
      .none { }
    }
    mut w = Writer.structure(take to, "DiscoverResult", count)
    w = Writer.field(take w, "resultType")
    w = Writer.text(take w, "complete")
    w = Writer.field(take w, "supportedVersions")
    w = Serialize.write(value.supported_versions, take w)
    w = Writer.field(take w, "capabilities")
    w = Serialize.write(value.capabilities, take w)
    match value.instructions {
      .some(s) {
        w = Writer.field(take w, "instructions")
        w = Writer.text(take w, s)
      }
      .none { }
    }
    w = Writer.field(take w, "ttlMs")
    w = Serialize.write(value.ttl, take w)
    w = Writer.field(take w, "cacheScope")
    w = Writer.text(take w, "private")
    w = Writer.field(take w, "_meta")
    w = Serialize.write(value.meta, take w)
    Writer.end_structure(take w)
  }
}

fn discovered(server: Server, tools: bool) -> str <alloc> {
  to_json(Discovered(
    supported_versions: [spoken()],
    capabilities: Capabilities(tools: tools),
    instructions: server.instructions,
    ttl: server.ttl,
    meta: ResultMeta(server_info: ServerInfo(name: server.name, version: server.version)),
  ))
}

// Whether the message came from a page of a browser that the server does not
// answer: it has an `Origin` and the server does not list it.
fn from_another_origin(origins: List[str], headers: List[(str, str)]) -> bool {
  match header(headers, "origin") {
    .none { false }
    .some(origin) {
      loop listed in origins {
        if listed == origin { return false }
      }
      true
    }
  }
}

// What a request says of the version and the capabilities of its client, which
// it says in every request, and the members of its params.
struct Seen {
  version: str
  members: List[(str, RawJson)]
}

fn seen_of(params: Option[RawJson]) -> Result[Seen, str] <alloc> {
  match params {
    .none { Result.err("params has no `_meta`") }
    .some(p) {
      got: Result[Members, ReadError] = from_json(raw_text(p))
      match got {
        .err(e) { Result.err(describe(e)) }
        .ok(members) {
          match find(members.named, "_meta") {
            .none { Result.err("params has no `_meta`") }
            .some(meta_raw) {
              inner: Result[Members, ReadError] = from_json(raw_text(meta_raw))
              match inner {
                .err(e) { Result.err("`_meta` is no object: {describe(e)}") }
                .ok(meta) {
                  match member_text(meta.named, "io.modelcontextprotocol/protocolVersion") {
                    .none { Result.err("`_meta` has no text `io.modelcontextprotocol/protocolVersion`") }
                    .some(v) {
                      match find(meta.named, "io.modelcontextprotocol/clientCapabilities") {
                        .none { Result.err("`_meta` has no `io.modelcontextprotocol/clientCapabilities`") }
                        .some(c) {
                          if kind(c) == 123 {
                            Result.ok(Seen(version: v, members: members.named))
                          } else {
                            Result.err("`io.modelcontextprotocol/clientCapabilities` is no object")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// What is wrong with the headers of a request that came over HTTP, as a code
// and a sentence, or none when they hold to the message. A message with no
// headers came by the standard input and has nothing to hold to.
fn header_fault(headers: List[(str, str)], method: str, seen: Seen) -> Option[(Int, str)] <alloc> {
  if headers.size == 0 { return .none }
  match header(headers, "mcp-protocol-version") {
    .none { return .some((-32020, "Header mismatch: the request has no `MCP-Protocol-Version` header")) }
    .some(v) {
      if v != seen.version {
        return .some((-32020, "Header mismatch: `MCP-Protocol-Version` is {v} and the version in `_meta` is {seen.version}"))
      }
    }
  }
  match header(headers, "mcp-method") {
    .none { return .some((-32020, "Header mismatch: the request has no `Mcp-Method` header")) }
    .some(v) {
      if v != method {
        return .some((-32020, "Header mismatch: `Mcp-Method` is {v} and the method is {method}"))
      }
    }
  }
  if method == "tools/call" or method == "prompts/get" {
    return name_fault(headers, seen, "name")
  }
  if method == "resources/read" {
    return name_fault(headers, seen, "uri")
  }
  .none
}

fn name_fault(headers: List[(str, str)], seen: Seen, key: str) -> Option[(Int, str)] <alloc> {
  match member_text(seen.members, key) {
    .none { .some((-32602, "params has no text `{key}`")) }
    .some(want) {
      match header(headers, "mcp-name") {
        .none { .some((-32020, "Header mismatch: the request has no `Mcp-Name` header")) }
        .some(raw) {
          match header_text(raw) {
            .none { .some((-32020, "Header mismatch: `Mcp-Name` is not a text")) }
            .some(got) {
              if got == want { .none } else { .some((-32020, "Header mismatch: `Mcp-Name` is {got} and `{key}` is {want}")) }
            }
          }
        }
      }
    }
  }
}

// The version a client of the earlier protocol says it speaks in `initialize`.
fn said_version(params: Option[RawJson]) -> str <alloc> {
  match params {
    .none { "" }
    .some(p) {
      got: Result[Members, ReadError] = from_json(raw_text(p))
      match got {
        .err(e) { "" }
        .ok(members) {
          match member_text(members.named, "protocolVersion") {
            .some(v) { v }
            .none { "" }
          }
        }
      }
    }
  }
}

fn request_route(server: Server, incoming: Incoming, id: str, method: str, params: Option[RawJson]) -> Routed <alloc> {
  if method == "initialize" {
    return Routed.done(unsupported(id, said_version(params)))
  }
  match params {
    .none { }
    .some(p) {
      if kind(p) != 123 {
        return Routed.done(refusal(.some(id), -32600, "Invalid Request", .none, 200))
      }
    }
  }
  match seen_of(params) {
    .err(why) { Routed.done(refusal(.some(id), -32602, why, .none, 400)) }
    .ok(seen) {
      match header_fault(incoming.headers, method, seen) {
        .some(fault) {
          (code, why) = fault
          return Routed.done(refusal(.some(id), code, why, .none, 400))
        }
        .none { }
      }
      if seen.version != spoken() {
        Routed.done(unsupported(id, seen.version))
      } else if method == "server/discover" or method == "tools/list" or method == "tools/call" {
        Routed.lines(call_of(id, method, params))
      } else {
        Routed.done(refusal(.some(id), -32601, "Method not found: {method}", .none, 404))
      }
    }
  }
}


// What a message asks of the lines of the server: the request, and for a call
// the name of the tool and the text of its arguments.
struct Call {
  id: str
  method: str
  name: Option[str]
  arguments: str
}

enum Routed {
  done: Reply
  lines: Call
}

fn call_of(id: str, method: str, params: Option[RawJson]) -> Call <alloc> {
  mut name: Option[str] = .none
  mut arguments = "\{\}"
  match params {
    .none { }
    .some(p) {
      got: Result[Members, ReadError] = from_json(raw_text(p))
      match got {
        .err(e) { }
        .ok(members) {
          name = member_text(members.named, "name")
          match find(members.named, "arguments") {
            .some(a) { arguments = raw_text(a) }
            .none { }
          }
        }
      }
    }
  }
  Call(id: id, method: method, name: name, arguments: arguments)
}

fn meta_text(server: Server) -> str <alloc> {
  to_json(ResultMeta(server_info: ServerInfo(name: server.name, version: server.version)))
}

fn list_text(server: Server, entries: List[str]) -> str <alloc> {
  mut b = texts.append(texts.text(), "\{\"resultType\":\"complete\",\"tools\":[")
  loop i in 0..entries.size {
    if i > 0 { b = texts.append(take b, ",") }
    b = texts.append(take b, entries[i])
  }
  b = texts.append(take b, "],\"ttlMs\":")
  b = texts.append(take b, to_json(server.ttl))
  b = texts.append(take b, ",\"cacheScope\":\"private\",\"_meta\":")
  b = texts.append(take b, meta_text(server))
  texts.finish(texts.append(take b, "\}"))
}

// The result of a call: what the tool gave, as text and as structured content,
// marked as an error when it failed.
fn call_text(server: Server, failed: bool, value: str) -> str <alloc> {
  mut b = texts.append(texts.text(), "\{\"resultType\":\"complete\",\"content\":[\{\"type\":\"text\",\"text\":")
  b = texts.append(take b, json_string(value))
  b = texts.append(take b, "\}],\"structuredContent\":")
  b = texts.append(take b, value)
  if failed { b = texts.append(take b, ",\"isError\":true") }
  b = texts.append(take b, ",\"_meta\":")
  b = texts.append(take b, meta_text(server))
  texts.finish(texts.append(take b, "\}"))
}

// What the server answers to a message of its lines, from what the lines gave:
// whether any line asked, the entries of the tools, the result of the one tool
// that was called, and the failure of reading its arguments.
fn conclude(server: Server, call: Call, asked: bool, entries: List[str], result: Option[str], failure: Option[(Int, str)]) -> Reply <alloc> {
  if call.method == "server/discover" {
    return Reply(text: .some(success_text(call.id, discovered(server, asked))), status: 200)
  }
  if asked == false {
    return refusal(.some(call.id), -32601, "Method not found: {call.method}", .none, 404)
  }
  if call.method == "tools/list" {
    return Reply(text: .some(success_text(call.id, list_text(server, entries))), status: 200)
  }
  match failure {
    .some(f) {
      (code, why) = f
      refusal(.some(call.id), code, why, .none, 200)
    }
    .none {
      match result {
        .some(r) { Reply(text: .some(success_text(call.id, r)), status: 200) }
        .none {
          label = match call.name {
            .some(n) { n }
            .none { "" }
          }
          refusal(.some(call.id), -32602, "Unknown tool: {label}", .none, 200)
        }
      }
    }
  }
}

// What the server answers to one message when no line answers it, so that it
// offers nothing.
pub fn reply_to(server: Server, incoming: Incoming) -> Reply <alloc> {
  match route(server, incoming) {
    .done(reply) { reply }
    .lines(call) { conclude(server, call, false, [], .none, .none) }
  }
}

// What the lines of a server ask of the message they are run for, and what they
// say of it.
effect lines {
  fn asked() -> Call
  fn listed(entry: str)
  fn answered(failed: bool, value: str)
  fn refused(code: Int, message: str)
}

// `mcp` answers the message `messages` gives with what the lines after it say,
// and the lines are run for that one message.
pub fn mcp(
  body: fn() <lines, alloc>;
  name: str,
  version: str,
  instructions: Option[str] = .none,
  ttl: Nat = 0,
  origins: take List[str] = [],
) <messages, alloc> {
  server = Server(name: name, version: version, instructions: instructions, ttl: ttl, origins: origins)
  match route(server, message()) {
    .done(reply) { answer(reply) }
    .lines(call) {
      mut any = false
      mut entries: List[str] = []
      mut result: Option[str] = .none
      mut failure: Option[(Int, str)] = .none
      lines(
        asked: {
          any = true
          call
        },
        listed: fn(entry) { entries = push(take entries, entry) },
        answered: fn(failed, value) { result = .some(call_text(server, failed, value)) },
        refused: fn(code, why) { failure = .some((code, why)) },
        body: body,
      )
      answer(conclude(server, call, any, entries, result, failure))
    }
  }
}

// What the server does with one message: it is answered, or it is one that the
// lines of the server answer. A message of a page that the server does not list
// is refused before it is read, and one that needs no answer, a notification, is
// answered by none.
fn route(server: Server, incoming: Incoming) -> Routed <alloc> {
  if from_another_origin(server.origins, incoming.headers) {
    return Routed.done(Reply(text: .none, status: 403))
  }
  match jsonrpc.read(incoming.text) {
    .err(f) { Routed.done(refusal(.none, f.code, f.message, .none, 200)) }
    .ok(received) {
      match received {
        .many(ms) { Routed.done(refusal(.none, -32600, "Invalid Request", .none, 200)) }
        .one(m) {
          match m {
            .response(r) { Routed.done(refusal(.none, -32600, "Invalid Request", .none, 200)) }
            .notification(n) { Routed.done(Reply(text: .none, status: 202)) }
            .request(r) {
              match r.id {
                .null { Routed.done(refusal(.none, -32600, "Invalid Request", .none, 200)) }
                .number(n) { request_route(server, incoming, to_json(n), r.method, r.params) }
                .text(t) { request_route(server, incoming, to_json(t), r.method, r.params) }
              }
            }
          }
        }
      }
    }
  }
}

// What a tool gave, as the text of its value and whether it is a failure: a
// tool gives a value, or a `Result` of one whose `.err` is a failure.
trait Gave[R] {
  fn gave(r: take R) -> (bool, str) <alloc>
}

impl[T] Gave[T]
  requires Serialize[T]
  requires Discard[T]
{
  fn gave(r: take T) -> (bool, str) <alloc> { (false, to_json(r)) }
}

impl[T, E] Gave[Result[T, E]]
  requires Serialize[T]
  requires Serialize[E]
  requires Discard[T]
  requires Discard[E]
{
  fn gave(r: take Result[T, E]) -> (bool, str) <alloc> {
    match r {
      .ok(v) { (false, to_json(v)) }
      .err(e) { (true, to_json(e)) }
    }
  }
}

// The entry of a tool in the list of the tools: its name, its comment, and the
// schema of what it takes, with a description for each parameter.
fn entry_of[F, A, R](f: F) -> str <alloc>
  requires Function[F, A, R]
  requires Describe[A]
{
  schema = schema_text(Describe[A].describe(json_schema(Json(cases: .key, names: .written))))
  mut b = texts.append(texts.text(), "\{\"name\":")
  b = texts.append(take b, json_string(Function.name(f)))
  b = texts.append(take b, ",\"description\":")
  b = texts.append(take b, json_string(Function.about(f)))
  b = texts.append(take b, ",\"inputSchema\":")
  b = texts.append(take b, schema)
  texts.finish(texts.append(take b, "\}"))
}

// The function `f` offered as a tool. It is listed when the message lists the
// tools, and it is called, with its arguments read from the message, when the
// message calls it by its name. For any other message it does nothing.
pub fn tool[F, A, R](f: F) <lines, alloc>
  requires Function[F, A, R]
  requires Deserialize[A]
  requires Discard[A]
  requires Describe[A]
  requires Gave[R]
{
  c = asked()
  if c.method == "tools/list" {
    listed(entry_of(f))
  } else if c.method == "tools/call" {
    wanted = match c.name {
      .some(n) { n == Function.name(f) }
      .none { false }
    }
    if wanted {
      got: Result[A, ReadError] = from_json(c.arguments)
      match got {
        .err(e) { refused(-32602, describe(e)) }
        .ok(args) {
          (failed, value) = Gave.gave(Function.call(f, take args))
          answered(failed, value)
        }
      }
    }
  }
}

// The messages of a client that is started on the same machine: each line of
// the standard input is one message, the lines under `stdio` are run for each,
// and each answer is written as one line of the standard output. What the lines
// print goes to the standard error. It ends when the input does.
pub fn stdio(body: fn() <messages, console, alloc>) <console, alloc> {
  loop round in 0..4294967296 {
    match input() {
      .none { break }
      .some(line) {
        messages(
          message: { Incoming(text: line, headers: []) },
          answer: fn(reply) {
            match reply.text {
              .some(t) { print(t) }
              .none { }
            }
          },
          body: {
            console(
              print: fn(text, end, to) { print(text, end: end, to: .stderr) },
              input: fn(prompt) { input(prompt) },
              body: body,
            )
          },
        )
      }
    }
  }
}

use std.list (push)

pub struct Text {
  bytes: List[Byte]
}

pub fn text() -> Text {
  Text(bytes: [])
}

pub fn append(t: mut Text, s: str) <alloc> {
  __append(mut t.bytes, s)
}

pub fn append_ascii(t: mut Text, b: 0..128) <alloc> {
  push(mut t.bytes, b)
}

pub fn finish(t: take Text) -> str {
  __finish(take t.bytes)
}

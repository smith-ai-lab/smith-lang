use std.text (Text, append, finish, text as new_text)
use std.utf8 (utf8)

// The bytes of `s` from `from` up to `end`, which are whole characters, as
// they are. The piece lies between two escaped bytes, which are ASCII, or at an
// end of `s`, so `utf8` never refuses it. It is written with `utf8` until
// `s[from..end]` is built (#778), which makes the piece with nothing read again.
fn run(to: take Text, s: str, from: Nat, end: Nat) -> Text <alloc> {
  var t = to
  if from == 0 and end == s.size {
    t = append(t, s)
  } else if from < end and end <= s.size {
    match utf8(s.bytes[from..end]) {
      .ok(piece) { t = append(t, piece) }
      .err(e) { }
    }
  }
  t
}

// How HTML writes a byte that is not text where it stands, or nothing for a
// byte that is.
fn entity(b: Byte) -> str {
  if b == '<' {
    "&lt;"
  } else if b == '>' {
    "&gt;"
  } else if b == '&' {
    "&amp;"
  } else if b == '"' {
    "&quot;"
  } else if b == '\'' {
    "&#39;"
  } else {
    ""
  }
}

// The text as HTML holds it as text and nothing else: `<`, `>`, `&`, `"`, and
// `'` are written as entities, and every other byte as it is. The bytes between
// two that are escaped are written together.
// A page, which only `render` makes.
pub struct Html {
  page: str
}

// A link that a page may hold in `href` or `src`: it has no scheme, or the
// scheme is `http`, `https`, or `mailto`, so it never runs code. Only `link`
// and `check_link` make one.
pub struct Link {
  target: str
}

// Why a text is not a link.
pub enum LinkError {
  not_plain: str
  scheme: str
}

impl Fmt[LinkError] {
  fn fmt(value: LinkError) -> str <alloc> {
    match value {
      .not_plain(t) { "{t}: not a link, which holds no space and no control character" }
      .scheme(t) { "{t}: not a link, whose scheme is http, https, or mailto, or none" }
    }
  }
}

fn lowered(b: Byte) -> Byte {
  if b >= 'A' and b <= 'Z' { b + 32 } else { b }
}

// Whether a text holds no space and no control character, which a browser
// would skip over inside a scheme.
pub fn plain(t: str) -> bool {
  var yes = true
  loop b in t {
    if b <= 32 or b == 127 {
      yes = false
      break
    }
  }
  yes
}

// Whether a text begins with a scheme, which is what stands before a `:` that
// comes before any `/`, `?`, or `#`.
fn has_scheme(t: str) -> bool {
  var yes = false
  loop b in t {
    if b == ':' {
      yes = true
      break
    }
    if b == '/' or b == '?' or b == '#' {
      break
    }
  }
  yes
}

// Whether a text begins with the scheme `name`, whatever the case of its letters.
fn is_scheme(t: str, name: str) -> bool {
  have = t.bytes
  want = name.bytes
  var yes = have.size > want.size
  loop i in 0..have.size {
    if i >= want.size {
      if have[i] != ':' {
        yes = false
        break
      }
      break
    }
    if lowered(have[i]) != want[i] {
      yes = false
      break
    }
  }
  yes
}

// Whether a text has no scheme, or one that runs no code.
pub fn runs_no_code(t: str) -> bool {
  not has_scheme(t) or is_scheme(t, "http") or is_scheme(t, "https") or is_scheme(t, "mailto")
}

// A link, written out. A text with a space or a control character, or with a
// scheme other than `http`, `https`, and `mailto`, is refused where the call is
// written.
pub fn link(t: str) -> Link
  requires plain(t)
  requires runs_no_code(t)
{
  Link(target: t)
}

// A link that is known only when the program runs, or the reason it is not one.
pub fn check_link(t: str) -> Result[Link, LinkError] {
  if not plain(t) {
    .err(.not_plain(t))
  } else if not runs_no_code(t) {
    .err(.scheme(t))
  } else {
    .ok(Link(target: t))
  }
}

// What a page is written through, as it runs. A tag is left open until
// something that is not an attribute is written, so that `attribute` may
// follow `start`. A handler writes what it is given as it is: the texts are
// escaped by `text` and by the elements, before they reach it.
pub effect markup {
  fn start(tag: str)
  fn attribute(name: str, value: str)
  fn emit(escaped: str)
  fn include(page: Html)
  fn void()
  fn end(tag: str)
}

// The text as HTML holds it as text and nothing else: `<`, `>`, `&`, `"`, and
// `'` are written as entities, and every other byte as it is. The bytes between
// two that are escaped are written together.
pub fn escape(s: str) -> str <alloc> {
  var t = new_text()
  var from: Nat = 0
  loop i in 0..s.size {
    written = entity(s[i])
    if written.size > 0 {
      t = append(run(t, s, from, i), written)
      from = i + 1
    }
  }
  finish(run(t, s, from, s.size))
}

// A text among other elements, written so that it is text and nothing else.
pub fn text(s: str) <markup, alloc> {
  emit(escape(s))
}

// A page put inside the one that is being written.
pub fn insert(page: Html) <markup> {
  include(page)
}

// The page so far, with the `>` of the tag that is open written.
fn closed(t: take Text, open: bool) -> Text <alloc> {
  if open {
    append(t, ">")
  } else {
    t
  }
}

// The handler of `markup`: it runs `writes`, gathers what it writes into one
// text, and gives it as an `Html`. The parameter is not called `body`, which is
// the name of an element: a name is found among the module's functions before
// the function's own bindings, so `body: body` below is the element in a file
// that does not import it (#642).
pub fn render(writes: fn() <markup>) -> Html <alloc> {
  var acc = new_text()
  var open = false
  markup(
    start: fn(tag) {
      acc = append(append(closed(acc, open), "<"), tag)
      open = true
    },
    attribute: fn(name, value) {
      acc = append(append(append(append(acc, " "), name), "=\""), value)
      acc = append(acc, "\"")
    },
    emit: fn(escaped) {
      acc = append(closed(acc, open), escaped)
      open = false
    },
    include: fn(page) {
      acc = append(closed(acc, open), page.page)
      open = false
    },
    void: {
      acc = closed(acc, open)
      open = false
    },
    end: fn(tag) {
      acc = append(append(append(closed(acc, open), "</"), tag), ">")
      open = false
    },
    body: writes,
  )
  Html(page: finish(acc))
}

// An attribute written only when it is given, with its value escaped.
fn given(name: str, value: str) <markup, alloc> {
  if value.size > 0 {
    attribute(name, escape(value))
  }
}

// A link that is written as the attribute `name`, which is never empty.
fn linked(name: str, to: Link) <markup, alloc> {
  attribute(name, escape(to.target))
}

// The attributes every element may have, written after its own.
fn common(class: str, id: str) <markup, alloc> {
  given("class", class)
  given("id", id)
}

// An element that holds a text, which is escaped.
fn holds_text(tag: str, inside: str) <markup, alloc> {
  text(inside)
  end(tag)
}

// An element that holds what its block writes.
fn holds_block(tag: str, block: fn() <markup>) <markup> {
  block()
  end(tag)
}

pub fn html(inside: str, class: str = "", id: str = "") <markup, alloc> {
  start("html")
  common(class, id)
  holds_text("html", inside)
}

pub fn in_html(class: str = "", id: str = "", block: fn() <markup>) <markup, alloc> {
  start("html")
  common(class, id)
  holds_block("html", block)
}

pub fn head(inside: str, class: str = "", id: str = "") <markup, alloc> {
  start("head")
  common(class, id)
  holds_text("head", inside)
}

pub fn in_head(class: str = "", id: str = "", block: fn() <markup>) <markup, alloc> {
  start("head")
  common(class, id)
  holds_block("head", block)
}


pub fn a(inside: str, href: Link, class: str = "", id: str = "") <markup, alloc> {
  start("a")
  linked("href", href)
  common(class, id)
  holds_text("a", inside)
}

pub fn in_a(href: Link, class: str = "", id: str = "", block: fn() <markup>) <markup, alloc> {
  start("a")
  linked("href", href)
  common(class, id)
  holds_block("a", block)
}

pub fn br(class: str = "", id: str = "") <markup, alloc> {
  start("br")
  common(class, id)
  void()
}

pub fn input(name: str = "", placeholder: str = "", type: str = "", value: str = "", class: str = "", id: str = "") <markup, alloc> {
  start("input")
  given("name", name)
  given("placeholder", placeholder)
  given("type", type)
  given("value", value)
  common(class, id)
  void()
}

// A page is written as its text, so that a program can print it and hand it on.
impl Fmt[Html] {
  fn fmt(value: Html) -> str <alloc> { value.page }
}

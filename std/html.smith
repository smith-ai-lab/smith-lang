use std.text (Text, append, finish, text as new_text)

// The bytes of `s` from `from` up to `end`, which are whole characters, as
// they are, with nothing read again.
fn run(to: mut Text, s: str, from: Nat, end: Nat) <alloc>
  requires from <= end and end <= s.size
  requires boundary(s, from) and boundary(s, end)
{
  append(mut to, s[from..end])
}

// How HTML writes a byte that is not text where it stands, or nothing for a
// byte that is.
fn entity(b: Byte) -> str {
  if b == '<' {
    "&lt;"
  } else if b == '>' {
    "&gt;"
  } else if b == '&' {
    "&amp;"
  } else if b == '"' {
    "&quot;"
  } else if b == '\'' {
    "&#39;"
  } else {
    ""
  }
}

// The text as HTML holds it as text and nothing else: `<`, `>`, `&`, `"`, and
// `'` are written as entities, and every other byte as it is. The bytes between
// two that are escaped are written together.
// A page, which only `render` makes.
pub struct Html {
  page: str
}

// A link that a page may hold in `href` or `src`: it has no scheme, or the
// scheme is `http`, `https`, or `mailto`, so it never runs code. Only `link`
// and `check_link` make one.
pub struct Link {
  target: str
}

// Why a text is not a link.
pub enum LinkError {
  not_plain: str
  scheme: str
}

impl Fmt[LinkError] {
  fn fmt(value: LinkError) -> str <alloc> {
    match value {
      .not_plain(t) { "{t}: not a link, which holds no space and no control character" }
      .scheme(t) { "{t}: not a link, whose scheme is http, https, or mailto, or none" }
    }
  }
}

fn lowered(b: Byte) -> Byte {
  if b >= 'A' and b <= 'Z' { b + 32 } else { b }
}

// Whether a text holds no space and no control character, which a browser
// would skip over inside a scheme.
pub fn plain(t: str) -> bool {
  mut yes = true
  loop b in t {
    if b <= 32 or b == 127 {
      yes = false
      break
    }
  }
  yes
}

// Whether a text begins with a scheme, which is what stands before a `:` that
// comes before any `/`, `?`, or `#`.
fn has_scheme(t: str) -> bool {
  mut yes = false
  loop b in t {
    if b == ':' {
      yes = true
      break
    }
    if b == '/' or b == '?' or b == '#' {
      break
    }
  }
  yes
}

// Whether a text begins with the scheme `name`, whatever the case of its letters.
fn is_scheme(t: str, name: str) -> bool {
  have = t.bytes
  want = name.bytes
  mut yes = have.size > want.size
  loop i in 0..have.size {
    if i >= want.size {
      if have[i] != ':' {
        yes = false
        break
      }
      break
    }
    if lowered(have[i]) != want[i] {
      yes = false
      break
    }
  }
  yes
}

// Whether a text has no scheme, or one that runs no code.
pub fn runs_no_code(t: str) -> bool {
  not has_scheme(t) or is_scheme(t, "http") or is_scheme(t, "https") or is_scheme(t, "mailto")
}

// A link, written out. A text with a space or a control character, or with a
// scheme other than `http`, `https`, and `mailto`, is refused where the call is
// written.
pub fn link(t: str) -> Link
  requires plain(t)
  requires runs_no_code(t)
{
  Link(target: t)
}

// A link that is known only when the program runs, or the reason it is not one.
pub fn check_link(t: str) -> Result[Link, LinkError] {
  if not plain(t) {
    .err(.not_plain(t))
  } else if not runs_no_code(t) {
    .err(.scheme(t))
  } else {
    .ok(Link(target: t))
  }
}

// What a page is written through, as it runs. A tag is left open until
// something that is not an attribute is written, so that `attribute` may
// follow `start`. A handler writes what it is given as it is: the texts are
// escaped by `text` and by the elements, before they reach it.
pub effect markup {
  fn start(tag: str)
  fn attribute(name: str, value: str)
  fn emit(escaped: str)
  fn include(page: Html)
  fn void()
  fn end(tag: str)
}

// The text as HTML holds it as text and nothing else: `<`, `>`, `&`, `"`, and
// `'` are written as entities, and every other byte as it is. The bytes between
// two that are escaped are written together.
pub fn escape(s: str) -> str <alloc> {
  mut t = new_text()
  mut from: Nat = 0
  loop i in 0..s.size
    invariant from <= i
    invariant boundary(s, from)
  {
    b = s[i]
    written = entity(b)
    // Only a byte below 128 is escaped, and such a byte is a character of
    // its own, so a run ends before it and the next begins after it.
    if b < 128 and written.size > 0 {
      run(mut t, s, from, i)
      append(mut t, written)
      from = i + 1
    }
  }
  run(mut t, s, from, s.size)
  finish(take t)
}

// A text among other elements, written so that it is text and nothing else.
pub fn text(s: str) <markup, alloc> {
  emit(escape(s))
}

// A page put inside the one that is being written.
pub fn insert(page: Html) <markup> {
  include(page)
}

// The page so far, with the `>` of the tag that is open written.
fn closed(t: mut Text, open: bool) <alloc> {
  if open { append(mut t, ">") }
}

// The handler of `markup`: it runs `writes`, gathers what it writes into one
// text, and gives it as an `Html`. The parameter is not called `body`, which is
// the name of an element: a name is found among the module's functions before
// the function's own bindings, so `body: body` below is the element in a file
// that does not import it (#642).
pub fn render(writes: fn() <markup>) -> Html <alloc> {
  mut acc = new_text()
  mut open = false
  markup(
    start: fn(tag) {
      closed(mut acc, open)
      append(mut acc, "<")
      append(mut acc, tag)
      open = true
    },
    attribute: fn(name, value) {
      append(mut acc, " ")
      append(mut acc, name)
      append(mut acc, "=\"")
      append(mut acc, value)
      append(mut acc, "\"")
    },
    emit: fn(escaped) {
      closed(mut acc, open)
      append(mut acc, escaped)
      open = false
    },
    include: fn(page) {
      closed(mut acc, open)
      append(mut acc, page.page)
      open = false
    },
    void: {
      closed(mut acc, open)
      open = false
    },
    end: fn(tag) {
      closed(mut acc, open)
      append(mut acc, "</")
      append(mut acc, tag)
      append(mut acc, ">")
      open = false
    },
    body: writes,
  )
  Html(page: finish(take acc))
}

// An attribute written only when it is given, with its value escaped.
fn given(name: str, value: str) <markup, alloc> {
  if value.size > 0 {
    attribute(name, escape(value))
  }
}

// A link that is written as the attribute `name`, which is never empty.
fn linked(name: str, to: Link) <markup, alloc> {
  attribute(name, escape(to.target))
}

// The attributes every element may have, written after its own.
fn common(class: str, id: str) <markup, alloc> {
  given("class", class)
  given("id", id)
}

// An element that holds what its block writes.
fn holds_block(tag: str, block: fn() <markup>) <markup> {
  block()
  end(tag)
}

pub fn html(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("html")
  common(class, id)
  holds_block("html", block)
}

pub fn head(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("head")
  common(class, id)
  holds_block("head", block)
}

pub fn title(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("title")
  common(class, id)
  holds_block("title", block)
}

pub fn body(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("body")
  common(class, id)
  holds_block("body", block)
}

pub fn h1(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("h1")
  common(class, id)
  holds_block("h1", block)
}

pub fn h2(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("h2")
  common(class, id)
  holds_block("h2", block)
}

pub fn p(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("p")
  common(class, id)
  holds_block("p", block)
}

pub fn b(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("b")
  common(class, id)
  holds_block("b", block)
}

pub fn span(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("span")
  common(class, id)
  holds_block("span", block)
}

pub fn ul(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("ul")
  common(class, id)
  holds_block("ul", block)
}

pub fn li(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("li")
  common(class, id)
  holds_block("li", block)
}

pub fn article(block: fn() <markup>; class: str = "", id: str = "") <markup, alloc> {
  start("article")
  common(class, id)
  holds_block("article", block)
}

pub fn a(block: fn() <markup>; href: Link, class: str = "", id: str = "") <markup, alloc> {
  start("a")
  linked("href", href)
  common(class, id)
  holds_block("a", block)
}

pub fn br(; class: str = "", id: str = "") <markup, alloc> {
  start("br")
  common(class, id)
  void()
}

pub fn input(; name: str = "", placeholder: str = "", type: str = "", value: str = "", class: str = "", id: str = "") <markup, alloc> {
  start("input")
  given("name", name)
  given("placeholder", placeholder)
  given("type", type)
  given("value", value)
  common(class, id)
  void()
}

// A page is written as its text, so that a program can print it and hand it on.
impl Fmt[Html] {
  fn fmt(value: Html) -> str <alloc> { value.page }
}

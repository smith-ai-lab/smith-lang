pub fn wrapping_add[T](a: T, b: T) -> T {
  __wrapping_add(a, b)
}

pub fn wrapping_sub[T](a: T, b: T) -> T {
  __wrapping_sub(a, b)
}

pub fn wrapping_mul[T](a: T, b: T) -> T {
  __wrapping_mul(a, b)
}

pub fn wrapping_div[T](a: T, b: T) -> T {
  __wrapping_div(a, b)
}

pub fn wrapping_rem[T](a: T, b: T) -> T {
  __wrapping_rem(a, b)
}

pub fn saturating_add[T](a: T, b: T) -> T
  requires Wrapping[T]
{
  __saturating_add(a, b)
}

pub fn saturating_sub[T](a: T, b: T) -> T
  requires Wrapping[T]
{
  __saturating_sub(a, b)
}

pub fn saturating_mul[T](a: T, b: T) -> T
  requires Wrapping[T]
{
  __saturating_mul(a, b)
}

pub fn narrow[A, B](x: A) -> Option[B] {
  __narrow(x)
}

pub fn clamp[A, B](x: A) -> B {
  __clamp(x)
}

pub fn wrapping_shift_left[T](a: T, by: Byte) -> T {
  __shift_left(a, by)
}

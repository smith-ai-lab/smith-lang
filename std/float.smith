pub fn sqrt[T](a: T) -> T {
  __sqrt(a)
}

pub fn exp[T](a: T) -> T {
  __exp(a)
}

pub fn ln[T](a: T) -> T {
  __ln(a)
}

pub fn sin[T](a: T) -> T {
  __sin(a)
}

pub fn cos[T](a: T) -> T {
  __cos(a)
}

pub fn floor[T](a: T) -> T {
  __floor(a)
}

pub fn ceil[T](a: T) -> T {
  __ceil(a)
}

pub fn trunc[T](a: T) -> T {
  __trunc(a)
}

pub fn round[T](a: T) -> T {
  __round(a)
}

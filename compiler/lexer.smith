// The lexer of Smith, written in Smith, following bootstrap/src/lexer.rs. The
// tests of bootstrap hold it to the Rust lexer: the same tokens, each at the
// same line and column, and the same message for each mistake.

use std.ascii (is_digit, is_hex_digit, is_letter)
use std.bits (bit_and, u64)
use std.console (console, print)
use std.fmt (hex)
use std.int (saturating_add, saturating_mul, saturating_sub, wrapping_add, wrapping_mul)
use std.list (freeze, push)
use std.utf8 (utf8)

struct Pos {
  line: Nat
  col: Nat
}

// A keyword is written as its case with `kw_` before it, as a keyword cannot be
// the name of a case.
enum Keyword {
  kw_and
  kw_as
  kw_break
  kw_derive
  kw_effect
  kw_effects
  kw_else
  kw_ensures
  kw_enum
  kw_fn
  kw_for
  kw_foreign
  kw_if
  kw_impl
  kw_in
  kw_loop
  kw_match
  kw_mut
  kw_not
  kw_or
  kw_out
  kw_pub
  kw_requires
  kw_return
  kw_struct
  kw_take
  kw_trait
  kw_try
  kw_use
  kw_var
  kw_with
  kw_without
}

enum Punct {
  dot_dot
  arrow
  plus_equal
  minus_equal
  star_equal
  slash_equal
  equal_equal
  bang_equal
  less_equal
  greater_equal
  open_paren
  close_paren
  open_bracket
  close_bracket
  open_brace
  close_brace
  comma
  colon
  dot
  equal
  less
  greater
  plus
  minus
  star
  slash
  at_sign
  caret
  bang
  pipe_arrow
  percent
  semicolon
}

// A number is kept in its source spelling, and a string has its escapes
// applied. A string that holds expressions is its pieces in order.
enum Tok {
  ident: str
  keyword: Keyword
  number: str
  string: str
  interp: List[Piece]
  punct: Punct
  newline
  eof
}

// Text with its escapes applied, or the tokens of an expression in braces,
// followed by the `}` that closes it.
enum Piece {
  text: str
  expr: List[Token]
}

struct Token {
  tok: Tok
  pos: Pos
}

struct LexError {
  pos: Pos
  message: str
}

struct Lexer {
  src: Slice[Byte]
  at: Nat
  pos: Pos
  tokens: List[Token]
  // The line breaks after the last token, which a `|>` that follows takes away.
  pending: List[Pos]
  errors: List[LexError]
  line_has_token: bool
}

fn unclosed() -> str {
  "this string has no closing quote on the line it starts"
}

// ---- bytes ----

fn byte_at(src: List[Byte], i: Nat) -> Option[Byte] {
  if i < src.size { .some(src[i]) } else { .none }
}

// The byte after the one at `i`, if there is one.
fn byte_after(src: List[Byte], i: Nat) -> Option[Byte] {
  if i < src.size {
    if i + 1 < src.size { .some(src[i + 1]) } else { .none }
  } else {
    .none
  }
}

// A byte that starts a name: std.ascii's letters are a-z and A-Z only.
fn is_name_start(b: Byte) -> bool { b == '_' or is_letter(b) }

fn is_word_byte(b: Byte) -> bool { is_name_start(b) or is_digit(b) }

// A byte that continues a character and does not start one.
fn is_continuation(b: Byte) -> bool { b >= 0x80 and b <= 0xBF }

// The bytes from `from` up to `to`, or none when they are not inside.
fn part(bytes: Slice[Byte], from: Nat, to: Nat) -> Slice[Byte] {
  if from <= to and to <= bytes.size { bytes[from..to] } else { bytes[0..0] }
}

// The text of the bytes from `from` up to `to`, which share the memory of
// `src`. Bytes that are not text give no text, which the lexer never asks for,
// as it has read the whole file as text already.
fn text_of(src: Slice[Byte], from: Nat, to: Nat) -> str {
  match utf8(part(src, from, to)) {
    .ok(s) { s }
    .err(e) { "" }
  }
}

fn text_from(bytes: take List[Byte]) -> str {
  match utf8(freeze(bytes)) {
    .ok(s) { s }
    .err(e) { "" }
  }
}

fn starts_with(src: List[Byte], at: Nat, p: List[Byte]) -> bool {
  if at <= src.size and p.size <= src.size - at {
    var same = true
    loop i in 0..p.size {
      if src[at + i] != p[i] { same = false }
    }
    same
  } else {
    false
  }
}

fn index_of(text: List[Byte], target: Byte) -> Option[Nat] {
  var found: Option[Nat] = .none
  loop i in 0..text.size {
    if found == .none and text[i] == target { found = .some(i) }
  }
  found
}

// ---- characters ----

fn number_at(b: List[Byte], i: Nat) -> u64 {
  match byte_at(b, i) {
    .some(x) { x }
    .none { 0 }
  }
}

fn low(b: u64, mask: u64) -> u64 { bit_and(b, mask) }

// The number of the character whose bytes are `b`.
fn code_point(b: List[Byte]) -> u64 {
  b0 = number_at(b, 0)
  b1 = low(number_at(b, 1), 0x3F)
  b2 = low(number_at(b, 2), 0x3F)
  b3 = low(number_at(b, 3), 0x3F)
  if b.size == 2 {
    wrapping_add(wrapping_mul(low(b0, 0x1F), 64), b1)
  } else if b.size == 3 {
    wrapping_add(wrapping_add(wrapping_mul(low(b0, 0x0F), 4096), wrapping_mul(b1, 64)), b2)
  } else if b.size == 4 {
    wrapping_add(
      wrapping_add(wrapping_mul(low(b0, 0x07), 262144), wrapping_mul(b1, 4096)),
      wrapping_add(wrapping_mul(b2, 64), b3))
  } else {
    b0
  }
}

// Whether the character of the number is one that is a control or white space,
// which an error shows by its number and not as it is.
fn is_unseen(code: u64) -> bool {
  if code <= 0x20 or (code >= 0x7F and code <= 0xA0) {
    true
  } else if code == 0x1680 or (code >= 0x2000 and code <= 0x200A) {
    true
  } else {
    code == 0x2028 or code == 0x2029 or code == 0x202F or code == 0x205F or code == 0x3000
  }
}

// A character as an error shows it.
fn show_char(c: str) -> str <alloc> {
  code = code_point(c)
  if is_unseen(code) { "U+{hex(code, width: 4)}" } else { "`{c}`" }
}

// What follows a backslash, as an error shows it.
fn after_backslash(lx: Lexer) -> str <alloc> {
  match byte_at(lx.src, lx.at) {
    .none { "nothing" }
    .some(c) {
      if c == '\n' { "nothing" } else { show_char(text_of(lx.src, lx.at, char_end(lx.src, lx.at))) }
    }
  }
}

// ---- UTF-8 ----

// Whether a byte may be the second of a character that starts with `lead`.
fn second_ok(lead: Byte, b: Byte) -> bool {
  if lead == 0xE0 {
    b >= 0xA0 and b <= 0xBF
  } else if lead == 0xED {
    b >= 0x80 and b <= 0x9F
  } else if lead == 0xF0 {
    b >= 0x90 and b <= 0xBF
  } else if lead == 0xF4 {
    b >= 0x80 and b <= 0x8F
  } else {
    is_continuation(b)
  }
}

// How many bytes the character that starts at `i` has, as the lead byte says.
fn wanted(lead: Byte) -> Nat {
  if lead < 0x80 {
    1
  } else if lead >= 0xC2 and lead <= 0xDF {
    2
  } else if lead >= 0xE0 and lead <= 0xEF {
    3
  } else if lead >= 0xF0 and lead <= 0xF4 {
    4
  } else {
    0
  }
}

// How many bytes at `i` are valid, up to the length of the character. This is
// what `utf8_chunks` calls the longest piece of a character that is valid so
// far, and the character is whole when it is as long as `wanted` says.
fn valid_prefix(src: List[Byte], i: Nat) -> n: Nat
  requires i < src.size
  ensures n <= 4 and n <= src.size - i
{
  lead = src[i]
  need = wanted(lead)
  if need >= 2 and 1 < src.size - i and second_ok(lead, src[i + 1]) {
    if need >= 3 and 2 < src.size - i and is_continuation(src[i + 2]) {
      if need >= 4 and 3 < src.size - i and is_continuation(src[i + 3]) { 4 } else { 3 }
    } else {
      2
    }
  } else {
    1
  }
}

fn advance(pos: Pos, b: Byte) -> Pos {
  if b == '\n' {
    Pos(line: saturating_add(pos.line, 1), col: 1)
  } else if is_continuation(b) {
    pos
  } else {
    Pos(line: pos.line, col: saturating_add(pos.col, 1))
  }
}

// The mistakes of the text itself: a carriage return, and bytes that are not
// UTF-8. A file that has one is not read further.
fn text_errors(src: List[Byte]) -> List[LexError] <alloc> {
  var errors: List[LexError] = []
  var pos = Pos(line: 1, col: 1)
  var i: Nat = 0
  loop round in 0..src.size {
    if i < src.size {
      b = src[i]
      have = valid_prefix(src, i)
      if have == wanted(b) {
        if b == 13 {
          errors = push(errors, LexError(pos: pos, message: "a carriage return is not allowed in a Smith file"))
        }
        pos = advance(pos, b)
        i = i + have
      } else {
        errors = push(errors, LexError(pos: pos, message: "the file is not valid UTF-8 here"))
        pos = Pos(line: pos.line, col: saturating_add(pos.col, 1))
        i = i + have
      }
    }
  }
  errors
}

// ---- tokens so far ----

fn error_at(lx: take Lexer, pos: Pos, message: take str) -> Lexer <alloc> {
  var next = lx
  next.errors = push(next.errors, LexError(pos: pos, message: message))
  next
}

fn is_newline(tok: Tok) -> bool {
  match tok {
    .newline { true }
    other { false }
  }
}

fn is_pipe(tok: Tok) -> bool {
  match tok {
    .punct(p) {
      match p {
        .pipe_arrow { true }
        other { false }
      }
    }
    other { false }
  }
}

// The line breaks that wait are tokens now.
fn flush(lx: take Lexer) -> Lexer <alloc> {
  var next = lx
  waiting = next.pending
  next.pending = []
  loop i in 0..waiting.size {
    next.tokens = push(next.tokens, Token(tok: .newline, pos: waiting[i]))
  }
  next
}

// A line that starts with `|>` goes on from the line before, so the line breaks
// that wait are not tokens when one is read.
fn push_token(lx: take Lexer, tok: take Tok, pos: Pos) -> Lexer <alloc> {
  var next = lx
  next.line_has_token = not is_newline(tok)
  if is_newline(tok) {
    next.pending = push(next.pending, pos)
    next
  } else {
    if is_pipe(tok) { next.pending = [] } else { next = flush(next) }
    next.tokens = push(next.tokens, Token(tok: tok, pos: pos))
    next
  }
}

fn bump(lx: take Lexer) -> Lexer {
  if lx.at < lx.src.size {
    b = lx.src[lx.at]
    after = lx.at + 1
    var next = lx
    next.at = after
    next.pos = advance(next.pos, b)
    next
  } else {
    lx
  }
}

// Reads the whole character that starts here, however many bytes it has.
fn bump_char(lx: take Lexer) -> Lexer {
  var next = bump(lx)
  loop round in 0..4 {
    match byte_at(next.src, next.at) {
      .some(b) { if is_continuation(b) { next = bump(next) } }
      .none { }
    }
  }
  next
}

// Where the character that starts at `at` ends, which is where `bump_char`
// would leave a lexer that was there.
fn char_end(src: List[Byte], at: Nat) -> Nat {
  var i = at
  if i < src.size { i = i + 1 }
  loop round in 0..4 {
    match byte_at(src, i) {
      .some(b) { if is_continuation(b) { i = saturating_add(i, 1) } }
      .none { }
    }
  }
  i
}

fn take_while_word(lx: take Lexer) -> Lexer {
  rounds = lx.src.size
  var next = lx
  loop round in 0..rounds {
    match byte_at(next.src, next.at) {
      .some(b) { if is_word_byte(b) { next = bump(next) } else { break } }
      .none { break }
    }
  }
  next
}

fn keyword_of(word: str) -> Option[Keyword] {
  if word == "and" {
    .some(.kw_and)
  } else if word == "as" {
    .some(.kw_as)
  } else if word == "break" {
    .some(.kw_break)
  } else if word == "derive" {
    .some(.kw_derive)
  } else if word == "effect" {
    .some(.kw_effect)
  } else if word == "effects" {
    .some(.kw_effects)
  } else if word == "else" {
    .some(.kw_else)
  } else if word == "ensures" {
    .some(.kw_ensures)
  } else if word == "enum" {
    .some(.kw_enum)
  } else if word == "fn" {
    .some(.kw_fn)
  } else if word == "for" {
    .some(.kw_for)
  } else if word == "foreign" {
    .some(.kw_foreign)
  } else if word == "if" {
    .some(.kw_if)
  } else if word == "impl" {
    .some(.kw_impl)
  } else if word == "in" {
    .some(.kw_in)
  } else if word == "loop" {
    .some(.kw_loop)
  } else if word == "match" {
    .some(.kw_match)
  } else if word == "mut" {
    .some(.kw_mut)
  } else if word == "not" {
    .some(.kw_not)
  } else if word == "or" {
    .some(.kw_or)
  } else if word == "out" {
    .some(.kw_out)
  } else if word == "pub" {
    .some(.kw_pub)
  } else if word == "requires" {
    .some(.kw_requires)
  } else if word == "return" {
    .some(.kw_return)
  } else if word == "struct" {
    .some(.kw_struct)
  } else if word == "take" {
    .some(.kw_take)
  } else if word == "trait" {
    .some(.kw_trait)
  } else if word == "try" {
    .some(.kw_try)
  } else if word == "use" {
    .some(.kw_use)
  } else if word == "var" {
    .some(.kw_var)
  } else if word == "with" {
    .some(.kw_with)
  } else if word == "without" {
    .some(.kw_without)
  } else {
    .none
  }
}

fn word(lx: take Lexer, start: Pos) -> Lexer <alloc> {
  from = lx.at
  next = take_while_word(lx)
  name = text_of(next.src, from, next.at)
  tok: Tok = match keyword_of(name) {
    .some(k) { .keyword(k) }
    .none { .ident(name) }
  }
  push_token(next, tok, start)
}

fn comment(lx: take Lexer, start: Pos) -> Lexer <alloc> {
  var next = if lx.line_has_token { error_at(lx, start, "a comment must stand on its own line") } else { lx }
  rounds = next.src.size
  loop round in 0..rounds {
    match byte_at(next.src, next.at) {
      .some(b) { if b == '\n' { break } else { next = bump(next) } }
      .none { break }
    }
  }
  next
}

// ---- numbers ----

// Why a run of digits of a base is not written as the lexical rules say, or
// none when it is: at least one digit, and an `_` only between two digits.
fn digits(text: Slice[Byte], base: Byte, name: str) -> Option[str] <alloc> {
  var why: Option[str] = .none
  var failed = false
  var previous: Byte = 0
  if text.size == 0 {
    failed = true
    why = .some("{name} digits are needed here")
  }
  loop i in 0..text.size {
    c = text[i]
    if not failed {
      if c == '_' {
        if i == 0 or previous == '_' {
          failed = true
          why = .some("an `_` stands only between two digits")
        }
      } else {
        valid = if base == 16 {
          is_hex_digit(c)
        } else if base == 2 {
          c == '0' or c == '1'
        } else {
          is_digit(c)
        }
        if not valid {
          failed = true
          why = .some("{show_char(text_of(text, i, i + 1))} is not a {name} digit")
        }
      }
      previous = c
    }
  }
  if not failed and previous == '_' {
    why = .some("an `_` stands only between two digits")
  }
  why
}

fn first_why(a: Option[str], b: Option[str]) -> Option[str] {
  match a {
    .some(m) { .some(m) }
    .none { b }
  }
}

// Why the text of a number, as the lexer reads it, is not written as the
// lexical rules say, or none when it is.
fn check_number(text: str) -> Option[str] <alloc> {
  bytes = text.bytes
  if text.size >= 2 and text[0] == '0' and text[1] == 'x' {
    digits(part(bytes, 2, text.size), 16, "hexadecimal")
  } else if text.size >= 2 and text[0] == '0' and text[1] == 'b' {
    digits(part(bytes, 2, text.size), 2, "binary")
  } else {
    mantissa_end = match index_of(text, 'e') {
      .some(at) {
        match index_of(text, 'E') {
          .some(other) { if other < at { other } else { at } }
          .none { at }
        }
      }
      .none {
        match index_of(text, 'E') {
          .some(other) { other }
          .none { text.size }
        }
      }
    }
    mantissa = part(bytes, 0, mantissa_end)
    whole_end = match index_of(mantissa, '.') {
      .some(at) { at }
      .none { mantissa.size }
    }
    first = digits(part(mantissa, 0, whole_end), 10, "decimal")
    second = if whole_end < mantissa.size {
      digits(part(mantissa, whole_end + 1, mantissa.size), 10, "decimal")
    } else {
      .none
    }
    third = if mantissa_end < text.size {
      var from = mantissa_end + 1
      loop i in from..text.size {
        if text[i] == '+' or text[i] == '-' { from = i + 1 } else { break }
      }
      digits(part(bytes, from, text.size), 10, "decimal")
    } else {
      .none
    }
    first_why(first, first_why(second, third))
  }
}

fn number(lx: take Lexer, start: Pos) -> Lexer <alloc> {
  from = lx.at
  var next = take_while_word(lx)
  if byte_at(next.src, next.at) == .some('.') {
    match byte_after(next.src, next.at) {
      .some(d) { if is_digit(d) { next = take_while_word(bump(next)) } }
      .none { }
    }
  }
  // The sign of an exponent belongs to the number.
  so_far = text_of(next.src, from, next.at)
  last = if so_far.size > 0 { so_far[so_far.size - 1] } else { 0 }
  is_hex = so_far.size >= 2 and so_far[0] == '0' and so_far[1] == 'x'
  if (last == 'e' or last == 'E') and not is_hex {
    match byte_at(next.src, next.at) {
      .some(sign) {
        if sign == '+' or sign == '-' {
          match byte_after(next.src, next.at) {
            .some(d) { if is_digit(d) { next = take_while_word(bump(next)) } }
            .none { }
          }
        }
      }
      .none { }
    }
  }
  text = text_of(next.src, from, next.at)
  checked = match check_number(text) {
    .some(why) { error_at(next, start, "`{text}` is not a number: {why}") }
    .none { next }
  }
  push_token(checked, .number(text), start)
}

// ---- characters ----

fn close_character(lx: take Lexer, start: Pos, from: Nat, ok: bool) -> Lexer <alloc> {
  if byte_at(lx.src, lx.at) == .some('\'') {
    closed = bump(lx)
    text = text_of(closed.src, from, closed.at)
    if ok { push_token(closed, .number(text), start) } else { closed }
  } else {
    error_at(lx, start, "a character has no closing `'`, and holds one character only")
  }
}

fn character(lx: take Lexer, start: Pos) -> Lexer <alloc> {
  from = lx.at
  opened = bump(lx)
  at = opened.pos
  match byte_at(opened.src, opened.at) {
    .none { error_at(opened, start, "a character has no closing `'`") }
    .some(c) {
      if c == '\n' {
        error_at(opened, start, "a character has no closing `'`")
      } else if c == '\'' {
        error_at(bump(opened), start, "a character is written between single quotes, and this has none")
      } else if c == '\\' {
        escaped = bump(opened)
        match byte_at(escaped.src, escaped.at) {
          .some(e) {
            if e == '\'' or e == '\\' or e == 'n' or e == 't' {
              close_character(bump(escaped), start, from, true)
            } else {
              shown = after_backslash(escaped)
              wrong = error_at(escaped, at, "unknown escape: a backslash is followed by {shown}, not one of ' \\ n t")
              if e == '\n' {
                close_character(wrong, start, from, false)
              } else {
                close_character(bump_char(wrong), start, from, false)
              }
            }
          }
          .none {
            wrong = error_at(escaped, at, "unknown escape: a backslash is followed by nothing, not one of ' \\ n t")
            close_character(wrong, start, from, false)
          }
        }
      } else {
        close_character(bump_char(opened), start, from, true)
      }
    }
  }
}

// ---- punctuation ----

// The punctuation that starts at `at`, longest first, and how long it is.
fn punct_at(src: List[Byte], at: Nat) -> Option[(Punct, Nat)] {
  if starts_with(src, at, "..") {
    .some((.dot_dot, 2))
  } else if starts_with(src, at, "->") {
    .some((.arrow, 2))
  } else if starts_with(src, at, "+=") {
    .some((.plus_equal, 2))
  } else if starts_with(src, at, "-=") {
    .some((.minus_equal, 2))
  } else if starts_with(src, at, "*=") {
    .some((.star_equal, 2))
  } else if starts_with(src, at, "/=") {
    .some((.slash_equal, 2))
  } else if starts_with(src, at, "==") {
    .some((.equal_equal, 2))
  } else if starts_with(src, at, "!=") {
    .some((.bang_equal, 2))
  } else if starts_with(src, at, "<=") {
    .some((.less_equal, 2))
  } else if starts_with(src, at, ">=") {
    .some((.greater_equal, 2))
  } else if starts_with(src, at, "(") {
    .some((.open_paren, 1))
  } else if starts_with(src, at, ")") {
    .some((.close_paren, 1))
  } else if starts_with(src, at, "[") {
    .some((.open_bracket, 1))
  } else if starts_with(src, at, "]") {
    .some((.close_bracket, 1))
  } else if starts_with(src, at, "\{") {
    .some((.open_brace, 1))
  } else if starts_with(src, at, "\}") {
    .some((.close_brace, 1))
  } else if starts_with(src, at, ",") {
    .some((.comma, 1))
  } else if starts_with(src, at, ":") {
    .some((.colon, 1))
  } else if starts_with(src, at, ".") {
    .some((.dot, 1))
  } else if starts_with(src, at, "=") {
    .some((.equal, 1))
  } else if starts_with(src, at, "<") {
    .some((.less, 1))
  } else if starts_with(src, at, ">") {
    .some((.greater, 1))
  } else if starts_with(src, at, "+") {
    .some((.plus, 1))
  } else if starts_with(src, at, "-") {
    .some((.minus, 1))
  } else if starts_with(src, at, "*") {
    .some((.star, 1))
  } else if starts_with(src, at, "/") {
    .some((.slash, 1))
  } else if starts_with(src, at, "@") {
    .some((.at_sign, 1))
  } else if starts_with(src, at, "^") {
    .some((.caret, 1))
  } else if starts_with(src, at, "!") {
    .some((.bang, 1))
  } else if starts_with(src, at, "|>") {
    .some((.pipe_arrow, 2))
  } else if starts_with(src, at, "%") {
    .some((.percent, 1))
  } else if starts_with(src, at, ";") {
    .some((.semicolon, 1))
  } else {
    .none
  }
}

fn punct(lx: take Lexer, start: Pos) -> Lexer <alloc> {
  match punct_at(lx.src, lx.at) {
    .none {
      from = lx.at
      after = bump_char(lx)
      shown = show_char(text_of(after.src, from, after.at))
      error_at(after, start, "unexpected character {shown}")
    }
    .some((p, width)) {
      var next = lx
      loop i in 0..width { next = bump(next) }
      push_token(next, .punct(p), start)
    }
  }
}

// ---- strings ----

// `token`, `string`, and `expression` call one another, as a string holds
// expressions whose tokens may be strings. Each call takes less fuel than the
// call that made it, which is what `decreases` states. A string nested n deep
// takes 3n calls and 2n bytes, so the fuel `lex` starts with, three times the
// size of the source and three more, is never spent by a file.

// Reads a string literal. Each mistake inside it is reported, and the string
// still becomes a token, so that the rest of the line is read.
fn string(lx: take Lexer, start: Pos, fuel: u64) -> Lexer <alloc>
  decreases fuel
{
  rounds = lx.src.size
  var next = bump(lx)
  var pieces: List[Piece] = []
  var value: List[Byte] = []
  var interpolated = false
  loop round in 0..rounds {
    at = next.pos
    match byte_at(next.src, next.at) {
      .none {
        next = error_at(next, start, unclosed())
        break
      }
      .some(c) {
        if c == '\n' {
          next = error_at(next, start, unclosed())
          break
        } else if c == '"' {
          next = bump(next)
          break
        } else if c == '{' {
          next = bump(next)
          interpolated = true
          if value.size > 0 { pieces = push(pieces, .text(text_from(value))) }
          value = []
          if fuel > 0 {
            (after, tokens) = expression(next, start, fuel - 1)
            next = after
            match tokens {
              .some(inside) { pieces = push(pieces, .expr(inside)) }
              .none { break }
            }
          } else {
            break
          }
        } else if c == '}' {
          next = error_at(bump(next), at, "a `\}` in a string closes no expression")
        } else if c == '\\' {
          next = bump(next)
          match byte_at(next.src, next.at) {
            .some(e) {
              if e == '"' or e == '\\' or e == '{' or e == '}' or e == 'n' or e == 't' {
                next = bump(next)
                decoded: Byte = if e == 'n' { '\n' } else if e == 't' { '\t' } else { e }
                value = push(value, decoded)
              } else {
                shown = after_backslash(next)
                next = error_at(next, at, "unknown escape: a backslash is followed by {shown}, not one of \" \\ \{ \} n t")
                if e == '\n' { break } else { next = bump_char(next) }
              }
            }
            .none {
              next = error_at(next, at, "unknown escape: a backslash is followed by nothing, not one of \" \\ \{ \} n t")
              break
            }
          }
        } else {
          next = bump(next)
          value = push(value, c)
        }
      }
    }
  }
  if not interpolated {
    push_token(next, .string(text_from(value)), start)
  } else {
    if value.size > 0 { pieces = push(pieces, .text(text_from(value))) }
    push_token(next, .interp(pieces), start)
  }
}

// Whether a token of the list is a string.
fn has_string(tokens: List[Token]) -> bool {
  var found = false
  loop i in 0..tokens.size {
    match tokens[i].tok {
      .string(b) { found = true }
      .interp(ps) { found = true }
      other { }
    }
  }
  found
}

// Whether the last mistake is the string with no closing quote.
fn last_is_unclosed(errors: List[LexError]) -> bool {
  if errors.size == 0 { false } else { errors[errors.size - 1].message == unclosed() }
}

// Reads the tokens of an expression in a string, from after its `{` through the
// `}` that closes it, which are the tokens when the line has not ended first.
fn expression(lx: take Lexer, start: Pos, fuel: u64) -> (Lexer, Option[List[Token]]) <alloc>
  decreases fuel
{
  rounds = lx.src.size
  var next = lx
  outside = next.tokens
  waiting = next.pending
  next.tokens = []
  next.pending = []
  var depth: Nat = 0
  var closed = false
  loop round in 0..rounds {
    at = next.pos
    match byte_at(next.src, next.at) {
      .none { break }
      .some(c) {
        if c == '\n' {
          break
        } else if c == '}' and depth == 0 {
          next = push_token(bump(next), .punct(.close_brace), at)
          closed = true
          break
        } else {
          if c == '{' { depth = saturating_add(depth, 1) }
          if c == '}' { depth = saturating_sub(depth, 1) }
          next = if fuel > 0 { token(next, at, c, fuel - 1) } else { next }
        }
      }
    }
  }
  inside = next.tokens
  next.tokens = outside
  next.pending = waiting
  // A string in the braces that the line ends inside is the one without its
  // quote, and it has reported that already.
  inner = has_string(inside) and last_is_unclosed(next.errors)
  if closed {
    (next, .some(inside))
  } else if inner {
    (next, .none)
  } else {
    (error_at(next, start, unclosed()), .none)
  }
}

// Reads what starts with `c`, which is not a line break: a space, a
// comment, or a token.
fn token(lx: take Lexer, start: Pos, c: Byte, fuel: u64) -> Lexer <alloc>
  decreases fuel
{
  if c == ' ' or c == '\t' {
    bump(lx)
  } else if c == '/' and byte_after(lx.src, lx.at) == .some('/') {
    comment(lx, start)
  } else if c == '"' {
    if fuel > 0 { string(lx, start, fuel - 1) } else { lx }
  } else if c == '\'' {
    character(lx, start)
  } else if is_name_start(c) {
    word(lx, start)
  } else if is_digit(c) {
    number(lx, start)
  } else {
    punct(lx, start)
  }
}

fn run(lx: take Lexer) -> Lexer <alloc> {
  rounds = lx.src.size
  fuel = saturating_add(saturating_mul(rounds, 3), 3)
  var next = lx
  loop round in 0..rounds {
    match byte_at(next.src, next.at) {
      .none { break }
      .some(c) {
        start = next.pos
        if c == '\n' {
          next = push_token(bump(next), .newline, start)
        } else {
          next = token(next, start, c, fuel)
        }
      }
    }
  }
  eof = next.pos
  push_token(next, .eof, eof)
}

// Splits a file into tokens. The last token is always `eof`.
fn lex(src: take List[Byte]) -> Result[List[Token], List[LexError]] <alloc> {
  bad = text_errors(src)
  if bad.size > 0 {
    .err(bad)
  } else {
    lx = Lexer(src: freeze(src), at: 0, pos: Pos(line: 1, col: 1), tokens: [], pending: [],
               errors: [], line_has_token: false)
    done = run(lx)
    if done.errors.size > 0 { .err(done.errors) } else { .ok(done.tokens) }
  }
}

fn main() <console, alloc> {
  match lex(['f', 'n', ' ', 'm', '\n']) {
    .ok(tokens) { print("{tokens.size}") }
    .err(errors) { print("errors") }
  }
}

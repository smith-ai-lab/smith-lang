// The parser of Smith, written in Smith, following bootstrap/src/parser.rs for
// what it does and knowledge/grammar.md for what it accepts: the tokens of
// compiler/lexer.smith in, the tree of a file out, and the errors the parser
// gives, each with its place. This file is not a program of its own: it uses
// the types `Pos`, `Tok` and `Token` of the lexer, which sit above it when the
// two are put together, as the tests do.
//
// The file compiles with the compiler on main, and the tests hold it to the
// Rust parser. It reads the `use` lines of a file and steps over the other
// items.

use std.int (saturating_add, saturating_sub)
use std.list (push)

// ---- the tokens, as the parser reads them ----

// The keywords and punctuation that the parser asks for.
fn kw_as() -> Keyword { .kw_as }
fn kw_use() -> Keyword { .kw_use }
fn p_lparen() -> Punct { .open_paren }
fn p_rparen() -> Punct { .close_paren }
fn p_comma() -> Punct { .comma }
fn p_dot() -> Punct { .dot }

fn is_keyword(t: Tok, k: Keyword) -> bool {
  match t {
    .keyword(n) { n == k }
    other { false }
  }
}

fn is_punct(t: Tok, k: Punct) -> bool {
  match t {
    .punct(n) { n == k }
    other { false }
  }
}

fn is_newline_tok(t: Tok) -> bool {
  match t {
    .newline { true }
    other { false }
  }
}

fn is_eof(t: Tok) -> bool {
  match t {
    .eof { true }
    other { false }
  }
}


// ---- what the parser says ----

// What was wanted where a mistake is, by number, and what was found there.
// 1 the name of a module        2 a name after `.`
// 3 a name for the module       4 a name to import or `)`
// 5 the name to give it         6 `,` or `)`
// 7 a line break                8 a list of names after a module's `as`,
//   which is not supported yet  9 `use` after another item
struct ParseError {
  pos: Pos
  wanted: u64
  found: Tok
}

struct Name {
  text: str
  pos: Pos
}

struct Listed {
  name: Name
  alias: Option[Name]
}

struct Use {
  pos: Pos
  module: List[Name]
  alias: Option[Name]
  listed: bool
  names: List[Listed]
}

// ---- a place among the tokens ----

struct Cursor {
  tokens: List[Token]
  at: Nat
}

fn eof_token() -> Token { Token(tok: .eof, pos: Pos(line: 1, col: 1)) }

fn token_here(c: Cursor) -> Token {
  if c.at < c.tokens.size { c.tokens[c.at] } else { eof_token() }
}

fn tok(c: Cursor) -> Tok { token_here(c).tok }

fn pos(c: Cursor) -> Pos { token_here(c).pos }

// One token on, but never past the last, which is `eof`.
fn step(c: take Cursor) -> Cursor {
  after = saturating_add(c.at, 1)
  if after < c.tokens.size {
    mut next = c
    next.at = after
    next
  } else {
    c
  }
}

fn skip_breaks(c: take Cursor) -> Cursor {
  rounds = c.tokens.size
  mut next = c
  loop round in 0..rounds {
    if is_newline_tok(tok(next)) { next = step(take next) } else { break }
  }
  next
}

fn expected(c: Cursor, wanted: u64) -> ParseError {
  ParseError(pos: pos(c), wanted: wanted, found: tok(c))
}

// A mistake, and the cursor it was found at, which the parser reads on from.
struct Failed {
  at: Cursor
  error: ParseError
}

fn fail(c: take Cursor, wanted: u64) -> Failed {
  Failed(error: expected(c, wanted), at: c)
}

// A name, and the cursor after it.
struct Got {
  at: Cursor
  name: Name
}

// A name, or what was wanted in its place.
fn ident(c: take Cursor, wanted: u64) -> Result[Got, Failed] {
  here = token_here(c)
  match here.tok {
    .ident(b) { .ok(Got(at: step(take c), name: Name(text: b, pos: here.pos))) }
    other { .err(fail(take c, wanted)) }
  }
}

// ---- skipping an item that holds a mistake ----

// From `from`: to the next token, outside any bracket, that starts a line at its
// first column. A brace, `requires` or `ensures` there belongs to the item
// before it.
fn skip_item(c: take Cursor, from: Nat) -> Cursor {
  rounds = saturating_add(c.tokens.size, 1)
  mut next = Cursor(tokens: c.tokens, at: from)
  mut depth: Nat = 0
  loop round in 0..rounds {
    t = tok(next)
    if is_eof(t) {
      break
    } else if is_newline_tok(t) and depth == 0 {
      next = skip_breaks(take next)
      if pos(next).col == 1 and not continues_item(tok(next)) { break }
    } else {
      if is_punct(t, .open_paren) or is_punct(t, .open_bracket) or is_punct(t, .open_brace) {
        depth = saturating_add(depth, 1)
      } else if is_punct(t, .close_paren) or is_punct(t, .close_bracket) or is_punct(t, .close_brace) {
        depth = saturating_sub(depth, 1)
      }
      next = step(take next)
    }
  }
  next
}

fn continues_item(t: Tok) -> bool {
  is_punct(t, .open_brace) or is_punct(t, .close_brace) or is_keyword(t, .kw_requires) or is_keyword(t, .kw_ensures)
}

// ---- use ----

fn has_name(alias: Option[Name]) -> bool {
  match alias {
    .some(n) { true }
    .none { false }
  }
}

// What follows a name in a list: `as` and the name it gives.
struct Aliased {
  at: Cursor
  alias: Option[Name]
}

fn alias_after(c: take Cursor, wanted: u64) -> Result[Aliased, Failed] <alloc> {
  if is_keyword(tok(c), kw_as()) {
    got = try ident(step(take c), wanted)
    .ok(Aliased(at: got.at, alias: .some(got.name)))
  } else {
    .ok(Aliased(at: c, alias: .none))
  }
}

struct Names {
  at: Cursor
  names: List[Listed]
}

// The names between the parentheses of a `use`, and the `)`.
fn listed_names(c: take Cursor) -> Result[Names, Failed] <alloc> {
  rounds = c.tokens.size
  mut at = step(take c)
  mut names: List[Listed] = []
  mut done = false
  loop round in 0..rounds {
    if not done {
      at = skip_breaks(take at)
      if is_punct(tok(at), p_rparen()) {
        done = true
      } else {
        got = try ident(take at, 4)
        renamed = try alias_after(take got.at, 5)
        names = push(take names, Listed(name: got.name, alias: renamed.alias))
        at = skip_breaks(take renamed.at)
        if is_punct(tok(at), p_comma()) {
          at = step(take at)
        } else if not is_punct(tok(at), p_rparen()) {
          return .err(fail(take at, 6))
        }
      }
    }
  }
  .ok(Names(at: step(take at), names: names))
}

struct UseLine {
  at: Cursor
  line: Use
}

// A `use` line and the line break after it: the module's name, then the names
// taken from it in parentheses.
fn use_line(c: take Cursor) -> Result[UseLine, Failed] <alloc> {
  start = pos(c)
  rounds = c.tokens.size
  first = try ident(step(take c), 1)
  mut at = first.at
  mut module: List[Name] = [first.name]
  loop round in 0..rounds {
    if is_punct(tok(at), p_dot()) {
      more = try ident(step(take at), 2)
      module = push(take module, more.name)
      at = more.at
    } else {
      break
    }
  }
  renamed = try alias_after(take at, 3)
  at = renamed.at
  listed = is_punct(tok(at), p_lparen())
  if listed and has_name(renamed.alias) {
    return .err(fail(take at, 8))
  }
  mut names: List[Listed] = []
  if listed {
    inside = try listed_names(take at)
    names = inside.names
    at = inside.at
  }
  t = tok(at)
  if is_newline_tok(t) or is_eof(t) {
    .ok(UseLine(at: at, line: Use(pos: start, module: module, alias: renamed.alias,
                                  listed: listed, names: names)))
  } else {
    .err(fail(take at, 7))
  }
}

// ---- the `use` lines of a file ----

struct Uses {
  uses: List[Use]
  errors: List[ParseError]
}

// The `use` lines of a file, and the mistakes of the file in them. An item that
// is not a `use` is stepped over, as the lines after it are not this part's:
// it is read to the next item and no further.
fn parse_uses(tokens: take List[Token]) -> Uses <alloc> {
  rounds = tokens.size
  mut at = Cursor(tokens: tokens, at: 0)
  mut uses: List[Use] = []
  mut errors: List[ParseError] = []
  mut items = false
  loop round in 0..rounds {
    at = skip_breaks(take at)
    start = at.at
    t = tok(at)
    if is_eof(t) {
      break
    } else if is_keyword(t, kw_use()) {
      late = items
      here = pos(at)
      match use_line(take at) {
        .ok(got) {
          if late { errors = push(take errors, ParseError(pos: here, wanted: 9, found: t)) }
          uses = push(take uses, take got.line)
          at = got.at
        }
        .err(f) {
          errors = push(take errors, take f.error)
          at = skip_item(take f.at, start)
        }
      }
    } else {
      items = true
      at = skip_item(step(take at), start)
    }
  }
  Uses(uses: uses, errors: errors)
}

use std.console (console, print)
use std.deserialize (ReadError)
use std.fromtext (from_text)
use std.list (append, freeze, push)
use std.net (Address, Connection, NetError, accept, bind, close, connect, listen, net, read, receive, write)
use std.utf8 (utf8)

fn name(e: NetError) -> str {
  match e {
    .unknown_host(address) { "unknown_host" }
    .refused(address) { "refused" }
    .in_use(address) { "in_use" }
    .closed(address) { "closed" }
    .failed(pair) { "failed" }
  }
}

// What the error says, with the call and the number a `failed` holds.
fn said(e: NetError) -> str {
  match e {
    .unknown_host(address) { address }
    .refused(address) { "refused" }
    .in_use(address) { "in_use" }
    .closed(address) { "closed" }
    .failed((address, why)) { why }
  }
}

fn text(bytes: take List[Byte]) -> str {
  match utf8(freeze(bytes)) {
    .ok(s) { s }
    .err(e) { "not text" }
  }
}

// What `echo_once` of the library's page does, with a line to say that the
// listener is open, so that a test connects after it and not before.
fn once(port: 1..65536) -> Result[(), NetError] <console, net, alloc> {
  with l = listen("127.0.0.1", .at(port))
  print("ready")
  c = try accept(l)
  result = turn(c)
  close(c)
  result
}

fn turn(c: Connection) -> Result[(), NetError] <net, alloc> {
  match try read(c, 4096) {
    .bytes(chunk) { write(c, freeze(chunk.bytes)) }
    .ended { .ok(()) }
  }
}

fn drain(c: Connection) -> Result[List[Byte], NetError] <net, alloc> {
  mut all: List[Byte] = []
  loop round in 0..2000000 {
    match try read(c, 4096) {
      .bytes(chunk) { all = append(all, chunk.bytes) }
      .ended { return .ok(all) }
    }
  }
  .ok(all)
}

fn send_back(c: Connection) -> Result[Nat, NetError] <net, alloc> {
  all = try drain(c)
  size = all.size
  try write(c, freeze(all))
  .ok(size)
}

// Reads until the other side finishes sending, and then sends all of it back.
fn everything(port: 1..65536) -> Result[Nat, NetError] <console, net, alloc> {
  with l = listen("127.0.0.1", .at(port))
  print("ready")
  c = try accept(l)
  result = send_back(c)
  close(c)
  result
}

// What `ask` of the library's page does, at the port a test gives.
fn ask(port: 1..65536, question: str) -> Result[List[Byte], NetError] <net, alloc> {
  with c = connect("127.0.0.1", port)
  try write(c, question.bytes)
  match try read(c, 4096) {
    .bytes(chunk) { .ok(chunk.bytes) }
    .ended { .ok([]) }
  }
}

fn datagram(port: 1..65536) -> Result[(Address, List[Byte]), NetError] <console, net, alloc> {
  with s = bind("127.0.0.1", .at(port))
  print("ready")
  receive(s, 1024)
}

// Writes until the other side's close is told, which a write after it gives.
fn writing(port: 1..65536) -> Result[(), NetError] <net, alloc> {
  with c = connect("127.0.0.1", port)
  mut block: List[Byte] = []
  loop k in 0..65536 { block = push(block, 7) }
  sent = freeze(block)
  loop round in 0..4000 {
    try write(c, sent)
  }
  .ok(())
}

fn listening(port: 1..65536) -> Result[(), NetError] <net> {
  with l = listen("127.0.0.1", .at(port))
  .ok(())
}

// An address that no interface of the machine holds, which the system refuses.
fn elsewhere(port: 1..65536) -> Result[(), NetError] <net> {
  with l = listen("192.0.2.7", .at(port))
  .ok(())
}

// A listener and a socket at the port that the system chooses.
fn anywhere() -> Result[(), NetError] <net> {
  with l = listen("127.0.0.1", .any)
  with s = bind("127.0.0.1", .any)
  .ok(())
}

fn answer(what: Result[(), NetError]) <console> {
  match what {
    .ok(()) { print("ok") }
    .err(e) { print(name(e)) }
  }
}

fn at(port: str, then: fn(1..65536)) <console> {
  number: Result[1..65536, ReadError] = from_text("port", port)
  match number {
    .ok(p) { then(p) }
    .err(e) { print("bad port") }
  }
}

fn main(args: List[str]) <console, net, alloc> {
  if args.size == 0 {
    print("usage")
    return
  }
  mode = args[0]
  if args.size < 2 {
    print("usage")
    return
  }
  with p = at(args[1])
  if mode == "once" {
    answer(once(p))
  } else if mode == "everything" {
    match everything(p) {
      .ok(n) { print("{n}") }
      .err(e) { print(name(e)) }
    }
  } else if mode == "ask" {
    if args.size < 3 { return }
    match ask(p, args[2]) {
      .ok(bytes) { print(text(bytes)) }
      .err(e) { print(name(e)) }
    }
  } else if mode == "datagram" {
    match datagram(p) {
      .ok((from, bytes)) { print("{from.host} {from.port} {text(bytes)}") }
      .err(e) { print(name(e)) }
    }
  } else if mode == "refused" {
    match ask(p, "x") {
      .ok(bytes) { print("ok") }
      .err(e) { print(name(e)) }
    }
  } else if mode == "in_use" {
    answer(listening(p))
  } else if mode == "elsewhere" {
    match elsewhere(p) {
      .ok(()) { print("ok") }
      .err(e) { print(said(e)) }
    }
  } else if mode == "any" {
    answer(anywhere())
  } else if mode == "closed" {
    answer(writing(p))
  } else if mode == "refused_says" {
    match ask(p, "x") {
      .ok(bytes) { print("ok") }
      .err(e) { print("{e}") }
    }
  } else if mode == "closed_says" {
    match writing(p) {
      .ok(()) { print("ok") }
      .err(e) { print("{e}") }
    }
  }
}

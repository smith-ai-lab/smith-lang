use std.bits (u64)
use std.console (console, print)

fn lower(t: str) -> bool {
  mut ok = true
  loop c in t {
    if c < 97 {
      ok = false
      break
    }
  }
  ok
}

fn greet(name: str) -> u64
  requires lower(name)
{
  name.size
}

fn main() <console, alloc> { print("{greet("ada")} {greet("grace")}") }

use std.console (console, print)
use std.entropy (entropy, fill)
use std.fmt (hex)
use std.list (push)

fn fixed[T](body: fn() -> T <entropy>) -> T <alloc> {
  entropy(
    fill: fn(bytes: mut List[Byte]) {
      mut made: List[Byte] = []
      loop i in 0..bytes.size { push(mut made, 171) }
      bytes = made
    },
    body: body,
  )
}

fn draw() -> str <entropy, alloc> {
  mut bytes: List[Byte] = [0, 0, 0, 0]
  mut line = ""
  fill(mut bytes)
  loop b in bytes { line = "{line}{hex(b, width: 2, letters: .lower)}" }
  line
}

fn main() <console, alloc> {
  with fixed()
  print(draw())
}

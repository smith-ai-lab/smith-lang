use std.console (console, print)

fn half(x: f32) -> f32 { x * 0.5 }
fn double(x: f32) -> f32 { x * 2.0 }

fn twice(x: f32, f: fn(f32) -> f32) -> f32 { f(f(x)) }

struct Pricing {
  discount: fn(f32) -> f32
}

struct Shop {
  name: str
  pricing: Pricing
}

fn chosen() -> fn(f32) -> f32 { half }

fn ident(f: fn(f32) -> f32) -> fn(f32) -> f32 { f }

fn apply(f: fn(f32) -> f32, x: f32) -> f32 { f(x) }

fn via(p: Pricing, x: f32) -> f32 { apply(p.discount, x) }

fn same(p: Pricing) -> Pricing { p }

fn local() -> Pricing {
  p = Pricing(discount: half)
  p
}

fn made() -> Pricing { Pricing(discount: double) }

fn priced(p: Pricing, x: f32) -> f32 { p.discount(x) }

fn sold(s: Shop, x: f32) -> f32 { s.pricing.discount(x) }

fn eight() -> f32 {
  f = half
  f(8.0)
}

fn sale_price(x: f32) -> f32 {
  sale = Pricing(discount: half)
  sale.discount(x)
}

fn chosen_half(x: f32) -> f32 { chosen()(x) }

fn chosen_bound(x: f32) -> f32 {
  f = chosen()
  f(x)
}

fn quarter(x: f32) -> f32 {
  f = half
  twice(x, f)
}

fn both() -> (f32, f32) {
  (priced(Pricing(discount: half), 8.0), priced(Pricing(discount: double), 8.0))
}

fn main() <console, alloc> {
  print("{eight()} {sale_price(8.0)} {chosen_half(8.0)} {chosen_bound(8.0)} {quarter(8.0)}")
  print("{both()} {priced(made(), 8.0)}")
  shop = Shop(name: "a", pricing: Pricing(discount: double))
  print("{shop.name} {sold(shop, 8.0)} {shop.pricing.discount(8.0)}")
  p = Pricing(discount: half)
  print("{apply(p.discount, 3.0)} {same(Pricing(discount: double)).discount(3.0)} {ident(double)(3.0)} {local().discount(3.0)} {via(p, 3.0)}")
}

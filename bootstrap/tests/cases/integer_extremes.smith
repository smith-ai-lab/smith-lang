use std.bits (u64)
use std.console (console, print)
use std.int (saturating_add, saturating_mul, wrapping_sub)

fn main() <console, alloc> {
  least: Int = -9_223_372_036_854_775_808
  greatest: u64 = 0xffff_ffff_ffff_ffff
  print("{least} {greatest} {repr(least)}")
  print("{wrapping_sub(least, 1)} {saturating_mul(greatest, 2)}")
  print("{saturating_add(least, -1)} {(least, greatest)}")
  print("{least < 0} {greatest > 0} {greatest == 18446744073709551615}")
}

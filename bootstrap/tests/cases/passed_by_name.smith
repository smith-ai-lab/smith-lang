use std.console (console, print)

fn apply(text: str, f: fn(str) -> str) -> str { f(text) }

fn pick(second: fn() -> str; first: fn() -> str) -> str { second() }

fn main() <console> {
  mut seen = "none"
  given = apply("a") fn(t) {
    seen = t
    "b"
  }
  print(given)
  print(seen)
  print(pick(first: { "x" }) { "c" })
}

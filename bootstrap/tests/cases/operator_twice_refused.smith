use std.bits (i64, u8)
use std.console (console, print)
use std.int (wrapping_add)

struct Rect {
  w: i64
  h: i64
}

impl Add[Rect] {
  fn valid(a: Rect, b: Rect) -> bool { true }
  fn add(a: Rect, b: Rect) -> Rect { Rect(w: wrapping_add(a.w, b.w), h: wrapping_add(a.h, b.h)) }
}

fn twice[T: Add](x: T) -> T
  requires Add.valid(x, x)
{
  x + x
}

fn main() <console, alloc> {
  unit = Rect(w: 1, h: 2)
  big = twice(unit)
  print("{big.w} {big.h}")
  n: u8 = 200
  print("{twice(n)}")
  m: i64 = 21
  print("{twice(m)}")
}
